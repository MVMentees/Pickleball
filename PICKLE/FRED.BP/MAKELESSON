*
*  Program to assist in creating a new lesson account
*
      PROMPT ''
*
*** Determine MV type of UV, UD or JB
*
      OPEN 'MD' TO md_voc_file ELSE
         OPEN 'VOC' TO md_voc_file ELSE
            CRT
            CRT 'Cannot open a VOC or MD file'
            CRT
            STOP
         END
      END
      mv_type = 'UNKNOWN'
      READ is_this_unidata FROM md_voc_file,'SAVEDLISTS' THEN
         IF is_this_unidata<1>[1,3] = 'DIR' THEN
            mv_type = 'UD'
         END
      END ELSE
         READ is_this_universe FROM md_voc_file,'&SAVEDLISTS&' THEN
            IF INDEX(is_this_universe<3>,'D_',1) THEN
               mv_type = 'UV'
            END
         END
      END
      EXECUTE 'jdiag' CAPTURING is_this_jbase
      IF INDEX(is_this_jbase,'jBASE',1) THEN
         mv_type = 'JBASE'
      END
      IF mv_type = 'UNKNOWN' THEN
         CRT
         CRT 'Cannot determine database type'
         CRT 'startup program aborted!'
         CRT
         STOP
      END
      BEGIN CASE
         CASE mv_type = 'UV'
            EXECUTE 'sh -c "ls -1 /myuv"' CAPTURING account_list
      END CASE
      last_account = DCOUNT(account_list,@AM)
      new_accounts = '' ; last_new_account = 0
      FOR account_count = 1 TO last_account
         account_name = account_list<account_count>
         IF account_name = '' THEN CONTINUE
         check_for_files = 'sh -c "ls -1 /myuv/':account_name:' 2> /dev/null"'
         EXECUTE check_for_files CAPTURING has_files
         IF has_files = '' THEN
            last_new_account += 1
            new_accounts<last_new_account> = account_name
         END
      NEXT account_count
      IF NOT(last_new_account) THEN
         CRT
         CRT 'No new accounts exist.   The account is already created or not created in /savedUVE'
         CRT
         STOP
      END
      CRT
      FOR new_account_count = 1 To last_new_account
         CRT new_accounts<new_account_count>
      NEXT new_account_count
      CRT
      CRT 'Enter account to create : ':
      INPUT account_to_create
      LOCATE account_to_create IN new_accounts SETTING found_it ELSE
         CRT
         CRT 'No account created.  Must enter account name to create'
         CRT
         STOP
      END
*
CREATESHELL:
*
      CRT
      CRT 'Creating shell account for ':account_to_create
      CRT
      EXECUTE 'sh -c "cp -r /usr/uv/UVBASE/* /myuv/':account_to_create:'/."'
      CRT 'You can now logto ':account_to_create:' and change it for the lesson.'
      CRT
      CRT 'YOU WILL PROBABLY WANT TO ALTER THE VOC RELLEVEL IN ':account_to_create
      CRT ' BY REMOVING 010 set'
      CRT 'This will make it so the person using the docker image will be able to pick'
      CRT 'the flavor of UniVerse they want for the lesson.'
      CRT
      CRT 'When you are done, the next step would be to exit this docker and create a'
      CRT 'docker image from it as follows:'
      CRT
      CRT 'cd /saved/':account_to_create:' ;tar -czvf /dangit/learn_infrastructure/mv_dockers/UVbuild/lesson.tar.gz .'
      CRT
      CRT 'echo ':account_to_create:' > /dangit/learn_infrastructure/mv_dockers/UVbuild/LESSON_ACCOUNT'
      CRT
      CRT 'cd /dangit/learn_infrastructure/mv_dockers/UVbuild; docker build -t IMAGENAME .'
*
   END                                   ; * Needed on some flavors
