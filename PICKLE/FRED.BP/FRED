    tcl_stmt = @SENTENCE
    IF tcl_stmt = '' THEN
        tcl_stmt = OCONV('','u0003')    ;* For D3
    END
    CONVERT @AM TO ' ' IN tcl_stmt      ;* some MV flavors return as attributes
*
    COMMON D.INTBLK(1000)
    MAT D.INTBLK = ''
*
    CALL FRED.EDITOR(tcl_stmt)
END ;* Needed for some versions of UniVerse
