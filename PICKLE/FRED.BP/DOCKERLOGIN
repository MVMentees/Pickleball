*
*  Program for login for all UniVerse, Unidata and jBASE dockers to assure they all work uniformally
*
    PROMPT ''
    CRT
    CRT 'Running DOCKERLOGIN version 2.1'
    CRT
*
*** Determine MV type of UV, UD or JB
*
    OPEN 'MD' TO md_voc_file ELSE
        OPEN 'VOC' TO md_voc_file ELSE
            CRT
            CRT 'Cannot open a VOC or MD file'
            CRT
            STOP
        END
    END
    mv_type = 'UNKNOWN'
    READ is_this_unidata FROM md_voc_file,'SAVEDLISTS' THEN
        IF is_this_unidata<1>[1,3] = 'DIR' THEN
            mv_type = 'UD'
        END
    END ELSE
        READ is_this_universe FROM md_voc_file,'&SAVEDLISTS&' THEN
            IF INDEX(is_this_universe<3>,'D_',1) THEN
                mv_type = 'UV'
            END
        END
    END
    EXECUTE 'jdiag' CAPTURING is_this_jbase
    IF INDEX(is_this_jbase,'jBASE',1) THEN
        mv_type = 'JBASE'
    END
    IF mv_type = 'UNKNOWN' THEN
        CRT
        CRT 'Cannot determine database type'
        CRT 'startup program aborted!'
        CRT
        STOP
    END
    BEGIN CASE
        CASE mv_type = 'UV'
* assure all accounts are in UV.ACCOUNT
            uv_account_f = 'F':@AM:'/usr/uv/UV.ACCOUNT':@AM:'D_VOC'
            WRITE uv_account_f ON md_voc_file,'TMP.UV.ACCOUNT'
            OPEN 'TMP.UV.ACCOUNT' TO uv_account_file THEN
                EXECUTE 'sh -c "cat /usr/uv/LESSON_ACCOUNT 2> /dev/null"' CAPTURING account_list
                CONVERT @AM:CHAR(10):CHAR(13) TO '' IN account_list
                account_list = TRIM(account_list)
                CONVERT ' ' TO @AM IN account_list
                last_account = DCOUNT(account_list,@AM)
                FOR account_count = 1 TO last_account
                    account_name = account_list<account_count>
                    READ uv_account_record FROM uv_account_file,account_name ELSE
                        WRITEV '/mystuff/':account_name ON uv_account_file,account_name,11
                    END
                NEXT account_count
                DELETE md_voc_file,'TMP.UV.ACCOUNT'
            END ELSE
                CRT
                CRT 'Cannot open UV.ACCOUNT to add accounts to that file'
                CRT
            END
* set flavor
            GOSUB UVFLAVOR
* set term
            EXECUTE 'sh -c "stty -a"' CAPTURING rows_columns
            GOSUB SETTERM
* set pterm
            pterm_stmt = 'PTERM CASE NOINVERT ERASE ^H'
            CRT
            CRT 'Setting ':pterm_stmt
            CRT
            EXECUTE pterm_stmt
        CASE mv_type = 'UD'
* assure all accounts are in UD.ACCOUNT
            ud_account_f = 'F':@AM:'@UDTHOME/sys/UD.ACCOUNT':@AM:'@UDTHOME/sys/D_UD.ACCOUNT'
            WRITE ud_account_f ON md_voc_file,'TMP.UD.ACCOUNT'
            OPEN 'TMP.UD.ACCOUNT' TO ud_account_file THEN
                EXECUTE '!cat /usr/ud83/LESSON_ACCOUNT 2> /dev/null' CAPTURING account_list
                CONVERT @AM:CHAR(10):CHAR(13) TO '' IN account_list
                account_list = TRIM(account_list)
                CONVERT ' ' TO @AM IN account_list
                last_account = DCOUNT(account_list,@AM)
                FOR account_count = 1 TO last_account
                    account_name = account_list<account_count>
                    READ ud_account_record FROM ud_account_file,account_name ELSE
                        WRITE '/mystuff/':account_name:@AM:'udadm':@AM:'ud' ON ud_account_file,account_name
                    END
                NEXT account_count
                DELETE md_voc_file,'TMP.UD.ACCOUNT'
            END ELSE
                CRT
                CRT 'Cannot open UD.ACCOUNT to add accounts to that file'
                CRT
            END
* set BASICTYPE
            GOSUB BASICTYPE
* set term
            EXECUTE '! stty -a' CAPTURING rows_columns
            GOSUB SETTERM
* set pterm
            pterm_stmt = 'PTERM -ERASE "':CHAR(8):'"'
            CRT
            CRT 'Setting PTERM -ERASE "^H"'
            CRT
            EXECUTE pterm_stmt
        CASE mv_type = 'JB'
    END CASE
*
*** Exit program
*
    STOP
*
UVFLAVOR:
*
    uv_flavors = 'NEWACC':@AM:'IN2':@AM:'INFORMATION':@AM:'PICK':@AM:'PIOPEN':@AM:'REALITY'
    READ rellevel_record FROM md_voc_file,'RELLEVEL' ELSE
        CRT
        CRT 'Warning!!! -- Cannot read VOC type from VOC RELLEVEL'
        CRT
        STOP
    END
    rel_level = rellevel_record<3>
    READ cur_newacc_voc FROM md_voc_file,'NEWACC' ELSE newacc_voc = ''
    IF cur_newacc_voc<2> # '/usr/uv/NEWACC/':rel_level THEN
        CRT
        CRT 'NEWACC item in voc is incorrect for ':rel_level
        CRT ' VOC NEWACC points to "':cur_newacc_voc<2>:'" should be "/usr/uv/NEWACC/':rel_level:'"'
        CRT
        STOP
    END
    LOCATE rel_level IN uv_flavors SETTING menu_number THEN
        menu_number = menu_number - 1   ;* Starts at 0
    END ELSE
        CRT
        CRT 'VOC RELLEVEL "':rel_level:'" is not a valid UniVerse flavor'
        CRT
        STOP
    END
    CRT
    CRT 'This is currently a ':menu_number:' ':rel_level:' flavor account'
    IF rellevel_record<10> = 'set' THEN
        RELEASE md_voc_file,'RELLEVEL'
        CRT 'Remove "set" from the VOC RELLEVEL item and run DOCKERLOGIN if you want to change it'
    END ELSE
        LOOP
            CRT
            FOR flavor_count = 0 TO 5
                CRT flavor_count:' ':uv_flavors<flavor_count+1>
            NEXT flavor_count
            CRT
            CRT 'Enter flavor you want (default = ':menu_number:' ':rel_level:') : ':
            INPUT set_flavor
            IF set_flavor = '' THEN set_flavor = menu_number
            IF NOT(NUM(set_flavor)) THEN CONTINUE
            IF set_flavor # INT(set_flavor) THEN CONTINUE
            IF set_flavor < 0 OR set_flavor > 5 THEN CONTINUE
            EXIT
        REPEAT
        IF set_flavor # menu_number THEN
            GOSUB REFLAVOR
        END ELSE
            CRT 'Flavor set.   Remove "set" from VOC RELLEVEL if you want to change'
            CRT
            WRITEV 'set' ON md_voc_file,'RELLEVEL',10
        END
    END
    RETURN
*
REFLAVOR:
*
    new_rel_level = uv_flavors<set_flavor+1>
    CRT 'Changing flavor from ':menu_number:' ':rel_level:' to ':set_flavor:' ':new_rel_level
    new_newacc_voc = cur_newacc_voc
    new_newacc_voc<2> = '/usr/uv/NEWACC/':new_rel_level
    WRITE new_newacc_voc ON md_voc_file,'TMP_NEWACC'
    OPEN 'TMP_NEWACC' TO new_newacc_file ELSE
        CRT
        CRT 'VOC TMP_NEWACC pointing to /usr/uv/NEWACC/':new_rel_level:' is not valid'
        CRT 'Deleting VOC TMP_NEWACC'
        CRT
        DELETE md_voc_file,'TMP_NEWACC'
        STOP
    END
    READV good_rellevel FROM new_newacc_file,'RELLEVEL',3 ELSE
        CRT
        CRT 'RELLEVEL in TMP_NEWACC is not present'
        CRT 'Deleting VOC TMP_NEWACC'
        CRT
        DELETE md_voc_file,'TMP_NEWACC'
        STOP
    END
    IF good_rellevel # new_rel_level THEN
        CRT
        CRT 'RELLEVEL in TMP_NEWACC is invalid'
        CRT 'It is "':good_rellevel:' and should be ':new_rel_level
        CRT 'Deleting VOC TMP_NEWACC'
        CRT
        DELETE md_voc_file,'TMP_NEWACC'
        STOP
    END
    OPEN 'NEWACC' TO cur_newacc_file ELSE
        CRT
        CRT 'Cannot open NEWACC file'
        CRT
        STOP
    END
*
*** Remove current NEWACC items
*
    SELECT cur_newacc_file
    LOOP
        READNEXT newacc_id ELSE EXIT
        DELETE md_voc_file,newacc_id
    REPEAT
*
*** Add new NEWACC items
*
    SELECT new_newacc_file
    LOOP
        READNEXT newacc_id ELSE EXIT
        READ new_newacc_item FROM new_newacc_file,newacc_id THEN
            WRITE new_newacc_item ON md_voc_file,newacc_id
        END
    REPEAT
*
*** Write TMP_NEWACC pointer as NEWACC and remove TMP_NEWACC pointer
*
    WRITE new_newacc_voc ON md_voc_file,'NEWACC'
    DELETE md_voc_file,'TMP_NEWACC'
*
*** Set as flavor set
*
    CRT 'Flavor set.   Remove "set" from VOC RELLEVEL if you want to change'
    WRITEV 'set' ON md_voc_file,'RELLEVEL',10
*
*** LOGOFF system
*
    CRT
    CRT 'Account is now a ':new_rel_level:' flavor account.'
    CRT 'Press anykey to continue'
    INPUT any_key,1
    RETURN
*
SETTERM:
*
    rows_index = INDEX(rows_columns,'rows ',1)
    columns_index = INDEX(rows_columns,'columns ',1)
    IF rows_index AND columns_index THEN
        stty_width = FIELD(rows_columns[columns_index,999],' ',2)
        stty_width = FIELD(stty_width,';',1)
        stty_depth = FIELD(rows_columns[rows_index,999],' ',2)
        stty_depth = FIELD(stty_depth,';',1)
        term_stmt = 'TERM ':stty_width:',':stty_depth
        IF stty_width < 0 OR stty_width > 500 THEN
            CRT
            CRT 'Cannot set term based on stty'
            CRT
        END ELSE
            CRT
            CRT 'Setting ':term_stmt
            CRT
            EXECUTE term_stmt
        END
    END
    RETURN
*
BASICTYPE:
*
    READ basic_type FROM md_voc_file,'DOCKER_BASICTYPE' ELSE basic_type = ''
    IF LEN(basic_type) THEN
        EXECUTE 'BASICTYPE "':basic_type:'"'
    END
    EXECUTE 'BASICTYPE' CAPTURING current_type
    current_type = FIELD(current_type<1>,' ',2)
    current_type = OCONV(current_type,'MCU')
    CRT 'BASICTYPE is currently "':current_type:'"'
    IF basic_type = current_type THEN
        set_basic = basic_type
    END ELSE
        LOOP
            CRT
            CRT 'U UniBASIC (native UniData BASIC)'
            CRT 'P Pick BASIC'
            CRT 'R Advanced Revelation BASIC'
            CRT 'M Mcdonnel Douglas BASIC / Reality BASIC'
            CRT
            CRT 'Enter BASICTYPE you want (default = ':current_type:') : ':
            INPUT set_basic
            IF set_basic = '' THEN set_basic = current_type
            IF set_basic # 'U' AND set_basic # 'P' AND set_basic # 'R' AND set_basic # 'M' THEN CONTINUE
            EXIT
        REPEAT
        EXECUTE 'BASICTYPE "':set_basic:'"'
    END
    WRITE set_basic ON md_voc_file,'DOCKER_BASICTYPE'
    RETURN
*
*** Some flavors require "optional" END
*
END
