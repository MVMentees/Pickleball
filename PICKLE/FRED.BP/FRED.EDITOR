*
HELP.OTHER:
*
    R.HELP = 'OTHER COMMANDS:'
    R.HELP<-1> = '     .PTR  - Toggle on/off printer'
    R.HELP<-1> = '     .PC   - Close and send print lines to printer'
    R.HELP<-1> = '     .TCL  - Shell out to TCL'
    R.HELP<-1> = '     .PEEK - Look at another item.  BLK commands can be used'
    R.HELP<-1> = '            Will prompt for File and ID'
    R.HELP<-1> = '     .TIME - Show Time and date'
    R.HELP<-1> = '     .WHO  - Show WHO'
    R.HELP<-1> = '     .? or .S?  - Show file, item, line and size'
    R.HELP<-1> = '     .OOPS - Undo last edit command.  .PD will display OOPS command'
    R.HELP<-1> = '     .C    - Shows columns (starting at begin of line or wherever C is typed)'
    R.HELP<-1> = '     .N    - Moves to next line with BASIC error,highlighting problem'
    R.HELP<-1> = '     .NA   - Displays list of BASIC errors, line, offset and message'
    R.HELP<-1> = '     .NR   - Displays raw output from the BASIC command'
    IF mv_type = 'JBASE' THEN
        R.HELP<-1> = '     .FMT{Left,Ind} - Run BFORMAT on item (Cannot undo with OOPS)'
    END ELSE
        R.HELP<-1> = '     .FMT - Run BFORMAT on item (Cannot undo with OOPS)'
    END
    R.HELP<-1> = '     .S Toggle supress of line number display'
    R.HELP<-1> = '     .CM comment    Add comment to FRED_EDITOR_FILE_HIST'
    R.HELP<-1> = '     .!{command} - run "command" or just execute shell'
    IF mv_type = 'JBASE' THEN
        R.HELP<-1> = '     .C2C - Compare to extracted code from current CATALOG object'
        R.HELP<-1> = '             Program had to be compiled using JELF=1,source=yes'
        R.HELP<-1> = '     .SYS nn - Shows the current value in quotes of SYSTEM(nn)'
        R.HELP<-1> = '     .SET - Set FRED editor parameters for MASTER or User'
    END
    R.HELP<-1> = '     .OCT mmm - Convert octal character mmm to decimal and if printable, show character'
    R.HELP<-1> = '     .HEX mmm - Convert HEX character mmm to decimal and if printable, show character'
    PRINT STR('=', 79)
    FOR HCNT = 1 TO DCOUNT(R.HELP, @AM)
        PRINT R.HELP<HCNT>
