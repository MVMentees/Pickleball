*
HELP.PRESTORE:
*
    R.HELP = 'PRESTORE COMMANDS:'
    R.HELP<-1> = '     .P{n}  - Execute prestore command'
    R.HELP<-1> = '              {n} - Prestore command number.  Default is 0'
    R.HELP<-1> = '     .P{n} commands - Store "commands" as a prestore command'
