    R.HELP<-1> = ''
    R.HELP<-1> = '  To set a prestore command to stacked command(s):'
    R.HELP<-1> = '  at the dot, put .Pn x,x,x where n is prestore # and x is command number(s)'
    R.HELP<-1> = '  Example:'
    R.HELP<-1> = '    ..L'
    R.HELP<-1> = '    0003 T'
    R.HELP<-1> = '    0002 L/B'
    R.HELP<-1> = '    0001 R/B/X'
    R.HELP<-1> = '    ..P7 2,1'
    R.HELP<-1> = '    .PD'
    R.HELP<-1> = '    P0   LD'
    R.HELP<-1> = '    P1   JS]RU99998/U50BB/U50AA'
    R.HELP<-1> = '    P2   RU99999999/U50BB/U50AA]FI]P2'
    R.HELP<-1> = '    P3   RU9999/u50bb/U50AA]FI]P1'
    R.HELP<-1> = '    P4'
    R.HELP<-1> = '    P5'
    R.HELP<-1> = '    P6'
    R.HELP<-1> = '    P7   L/B]R/B/X'
    R.HELP<-1> = '    P8'
    R.HELP<-1> = '    P9'
    R.HELP<-1> = '    A    L/B'
    R.HELP<-1> = '    BKB'
    R.HELP<-1> = '    OOPS [1,1] GA1]MVOOPSBLK]DE'
    R.HELP<-1> = '    EC   1 display raw data except for @VM as ] and @SM as \'
    R.HELP<-1> = '    Use H for help.   History off'
    R.HELP<-1> = '    .'
    PRINT STR('=', 79)
    FOR HCNT = 1 TO DCOUNT(R.HELP, @AM)
        PRINT R.HELP<HCNT>
    NEXT HCNT
    RETURN
*
HELP.FILE:
*
    R.HELP = 'FILE COMMANDS:'
    R.HELP<-1> = '     .EX{K}  - Exit item'
    R.HELP<-1> = '         Command will prompt if item changed'
    R.HELP<-1> = '         {K} - Kill active list'
    R.HELP<-1> = '     .FI{BCFKOQRU} {newname} - File current item and exit'
    R.HELP<-1> = '         {B} - BASIC item after filing.  (See N and NA in HO)'
    R.HELP<-1> = '         {C} - CATALOG item after filing'
    R.HELP<-1> = '         {F} - CATALOG with (O option'
    R.HELP<-1> = '         {K} - Kill active list'
    R.HELP<-1> = '         {O} - Overlay "newname" item.  Otherwise, will ask if "newname" exists'
    R.HELP<-1> = '         {Q} - Quit even if BASIC errors'
    R.HELP<-1> = '         {R} - RUN item after filing'
    R.HELP<-1> = '         {U} - save in UPPERCASE'
    R.HELP<-1> = '         {newname} - File item as "newname" rather than original ID'
    R.HELP<-1> = '     .FS{BCFORU} {newname} - Save current item'
    R.HELP<-1> = '         {B} - BASIC item after filing.  (See N and NA in HO)'
    R.HELP<-1> = '         {C} - CATALOG item after filing'
    R.HELP<-1> = '         {F} - CATALOG with (O option'
    R.HELP<-1> = '         {O} - Overlay "newname" item.  Otherwise, will ask if "newname" exists'
    R.HELP<-1> = '         {R} - RUN item after filing'
    R.HELP<-1> = '         {U} - save in UPPERCASE'
    R.HELP<-1> = '         {newname} - Save item as "newname" rather than original ID'
    R.HELP<-1> = '     .FD{K}  - Delete current item and exit'
    R.HELP<-1> = '         {K} - Kill active list'
    PRINT STR('=', 79)
    FOR HCNT = 1 TO DCOUNT(R.HELP, @AM)
        PRINT R.HELP<HCNT>
    NEXT HCNT
