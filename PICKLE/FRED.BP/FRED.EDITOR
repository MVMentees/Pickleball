*
BASIC.PROGRAMS:
*
    IF os_slash = '\' AND COUNT(file_name, '\') THEN
        DS.file_name = file_name
        DS.file_name = CHANGE(DS.file_name, '\', '\\')
        EXECUTE 'BASIC ' : dict_or_data : ' ' : DS.file_name : ' ' : V.SID CAPTURING basic_output RETURNING BSC.RETURN
    END ELSE
        basic_file_name = file_name
        IF d3_file_pathing THEN
            R.VOC = 'Q'
            R.VOC<2> = d3_account
            R.VOC<3> = d3_dict_file : ',' : d3_data_file
            basic_file_name = 'FRED_EDITOR_' : d3_dict_file : DATE() : '_' : TIME() : '_' : my_port_number
            READU lockvoc FROM F.MDVOC, file_name ELSE NULL
            WRITEU R.VOC ON F.MDVOC, basic_file_name
        END
        EXECUTE 'BASIC ' : dict_or_data : ' ' : basic_file_name : ' ' : V.SID CAPTURING basic_output RETURNING BSC.RETURN
        last_basic_output = DCOUNT(basic_output, @AM)
        IF d3_file_pathing THEN
            DELETE F.MDVOC, file_name
        END
    END
    last_basic_error = 0; basic_errors = ''
    BEGIN CASE
        CASE mv_type = 'JBASE'
            IF INDEX(basic_output, 'compiled successfully', 1) THEN
                CRT
                CRT 'BASIC was successful'
                CRT
                IF INDEX(basic_output, 'Warning:', 1) THEN
                    CRT 'Warnings.  Use NR to see raw output from BASIC command'
                    CRT
                END
            END ELSE
                basic_error_prefix = '"' : file_item_id : '",  line'
                last_compile_error = COUNT(basic_output, basic_error_prefix)
                FOR compile_error_count = 1 TO last_compile_error
                    compile_error_index = INDEX(basic_output, basic_error_prefix, compile_error_count)
                    compile_error_atb = DCOUNT(basic_output[1, compile_error_index], @AM)
                    compile_error_line = basic_output<compile_error_atb>
                    last_basic_error += 1
                    basic_errors<1, last_basic_error> = FIELD(compile_error_line, ' ', 4)
                    basic_errors<3, last_basic_error> = OCONV(compile_error_line, 'G1)999')
                NEXT compile_error_count
*
*** jpp2 errors
*
                last_jpp2_error = COUNT(basic_output, @AM : 'jpp2: ')
                FOR jpp2_error_count = 1 TO last_jpp2_error
                    jpp2_error_index = INDEX(basic_output, 'jpp2:', jpp2_error_count)
                    jpp2_error_atb = DCOUNT(basic_output[1, jpp2_error_index], @AM)
                    jpp2_error_line = basic_output<jpp2_error_atb>
                    last_basic_error += 1
                    IF jpp2_error_line MATCHES "'jpp2: '0X': Line '1N0N0X" THEN
                        basic_errors<1, last_basic_error> = FIELD(FIELD(jpp2_error_line, ':', 3), ' ', 3)
                    END ELSE
                        basic_errors<1, last_basic_error> = 0
                    END
                    basic_errors<3, last_basic_error> = FIELD(jpp2_error_line, ':', 2)
                NEXT jpp2_error_count
                CRT
                CRT last_basic_error : ' errors from BASIC.  Use N, NA or NR to review'
                CRT
            END
        CASE mv_type = 'UV'
            LAST.basic_output = DCOUNT(basic_output, @AM)
            FOR CountErr = 1 TO LAST.basic_output
                ErrLine = basic_output<CountErr>
                IF ErrLine MATCHES "6N' '0X" THEN
                    last_basic_error += 1
                    BSC.Line = ErrLine[1, 6] + 0
                    BSC.Message = basic_output<CountErr + 2>
                    basic_errors<1, last_basic_error> = BSC.Line
                    HighlightIndex = INDEX(basic_output<CountErr + 1>, '^', 1) - 10
                    IF HighlightIndex < 1 THEN HighlightIndex = 1
                    basic_errors<2, last_basic_error> = HighlightIndex
                    basic_errors<3, last_basic_error> = BSC.Message
                END
            NEXT CountErr
            IF NOT(last_basic_error) AND (INDEX(basic_output, 'Errors detected', 1) OR NOT(INDEX(basic_output, 'Compilation Complete', 1))) THEN
                last_basic_error = 1
                basic_errors = 1
                basic_errors<2> = 1
                CONVERT @AM TO ';' IN basic_output
                basic_errors<3> = basic_output
            END
        CASE mv_type = 'UD'
            IF INDEX(basic_output, 'compilation finished', 1) THEN
                CRT
                CRT 'BASIC was successful'
                CRT
                IF INDEX(basic_output, 'Warning:', 1) THEN
                    CRT 'Warnings.  Use NR to see raw output from BASIC command'
                    CRT
                END
            END ELSE
                LAST.basic_output = DCOUNT(basic_output, @AM)
                FOR CountErr = 1 TO LAST.basic_output
                    ErrLine = basic_output<CountErr>
                    IF ErrLine MATCHES "'<line '1N0N'>'0X" THEN
                        last_basic_error += 1
                        BSC.Line = FIELD(ErrLine, ' ', 2)
                        BSC.Line = FIELD(BSC.Line, '>', 1)
                        BSC.Message = basic_output<CountErr + 2>
                        basic_errors<1, last_basic_error> = BSC.Line
                        basic_errors<3, last_basic_error> = BSC.Message
                    END
                NEXT CountErr
                IF last_basic_error = 0 THEN
                    last_basic_error = 1
                    basic_errors = 1
                    basic_errors<2> = 1
                    CONVERT @AM TO ';' IN basic_output
                    basic_errors<3> = basic_output
                END
                CRT
                CRT 'COMPILATION ERRORS!!  Use NR to see raw output from BASIC command'
                CRT
            END
        CASE mv_type = 'D3'
            IF BSC.RETURN # 241 THEN
                basic_errors = ''
                LAST.basic_output = DCOUNT(basic_output, @AM)
                FOR BSC.ECNT = 1 TO LAST.basic_output
                    BSC.ELINE = basic_output<BSC.ECNT>
                    line.IDX = INDEX(BSC.ELINE, 'Line ', 1)
                    IF line.IDX THEN
                        BSC.ELINE = BSC.ELINE[line.IDX, 99999]
                        BSC.mesg = OCONV(BSC.ELINE, 'G1:99')
                        IF NOT(INDEX(BSC.mesg, 'Compilation aborted', 1)) THEN
                            last_basic_error = last_basic_error + 1
                            BSC.line = FIELD(FIELD(BSC.ELINE, ':', 1), ' ', 2)
                            basic_errors<1, last_basic_error> = BSC.line
                            basic_errors<2, last_basic_error> = '0'
                            basic_errors<3, last_basic_error> = BSC.mesg
                        END
                    END
                NEXT BSC.ECNT
            END
    END CASE
    RETURN
*
COMMANDQ:
*
    IF command_entered[1, 1] = '?' THEN
        command_entered = command_entered[2, 9999]
    END ELSE
        command_entered = '~' : command_entered[3, 9999]
    END
    LQ = COUNT(command_entered, '?')
    FOR QCNT = 1 TO LQ
        QIN = INDEX(command_entered, '?', 1)
        IF command_entered[QIN + 1, 1] = '*' THEN
            command_entered = command_entered[1, QIN-1] : VAL : command_entered[QIN + 2, 999]
        END ELSE
            CRT command_entered[1, QIN] :
            INPUT VAL
            command_entered = command_entered[1, QIN-1] : VAL : command_entered[QIN + 1, 999]
        END
        CRT command_entered
    NEXT QCNT
    RETURN
*
WIDTHDEPTH:
*
    output_depth = SYSTEM(3)
    output_width = SYSTEM(2) - 1
*
*** Check stty if Linux
*
    IF os_type = 'L' AND NOT(q_option) THEN
        IF mv_type = 'UV' THEN
            EXECUTE os_shell : ' "stty -a"' CAPTURING rows_columns
        END ELSE
            EXECUTE os_shell : ' stty -a' CAPTURING rows_columns
        END
        rows_index = INDEX(rows_columns, 'rows ', 1)
        columns_index = INDEX(rows_columns, 'columns ', 1)
        IF rows_index AND columns_index THEN
            stty_width = FIELD(rows_columns[columns_index, 999], ' ', 2)
            stty_width = FIELD(stty_width, ';', 1)
            stty_depth = FIELD(rows_columns[rows_index, 999], ' ', 2)
            stty_depth = FIELD(stty_depth, ';', 1)
            IF (stty_width - 1) # output_width OR stty_depth # output_depth THEN
                IF adjust_to_stty # 'N' THEN
                    y_or_n = 'Y'
                END ELSE
                    y_or_n = ''
                END
                LOOP
                UNTIL y_or_n = 'N' OR y_or_n = 'Y' DO
                    CRT
                    CRT 'Do you want to change term to ' : stty_width : ',' : stty_depth : ' ? (Y/N) : ' :
                    INPUT y_or_n
                    y_or_n = OCONV(y_or_n, 'MCU')
                REPEAT
                IF y_or_n = 'Y' THEN
                    EXECUTE 'TERM ' : stty_width : ',' : stty_depth
                    output_depth = SYSTEM(3)
                    output_width = SYSTEM(2) - 1
                END
            END
        END
    END
    display_items_per_line = INT(output_width / 39)
    max_display_items = output_depth * display_items_per_line - (2 * display_items_per_line)
    RETURN
*
GITCOMMAND:
*
    RETURN
*
INQUOTES:
*
    pre_quote_line = quote_line[1, string_start_position-1]
    pre_quote_line_len = LEN(pre_quote_line)
    open_quote_chars = ''
    FOR quote_check = 1 TO pre_quote_line_len
        quote_char = pre_quote_line[quote_check, 1]
        IF quote_char = '"' OR quote_char = "'" OR quote_char = '\' THEN
            LOCATE quote_char IN open_quote_chars<1> SETTING quote_value_number THEN
                this_open_quote = open_quote_chars<2, quote_value_number>
                FOR quote_close = 3 TO 1 STEP -1
                    IF open_quote_chars<2, quote_close> >= this_open_quote THEN
                        DEL open_quote_chars<1, quote_close>
                        DEL open_quote_chars<2, quote_close>
                    END
                NEXT quote_close
            END ELSE
                open_quote_chars<1, -1> = quote_char
                open_quote_chars<2, -1> = quote_check
            END
        END
    NEXT quote_check
    IF LEN(open_quote_chars<1>) THEN
        string_start_position = 0       ;* It is in quotes, so disregard
    END ELSE
        GOSUB COMMENTLINE
    END
    RETURN
*
COMMENTLINE:
*
    comment_line = TRIM(quote_line[1, string_start_position-1])       ;* Remove lead,trail and redundant spaces
    line_label = FIELD(comment_line, ' ', 1)
    IF line_label MATCHES "1N0N" OR line_label MATCHES "1A0X':'" THEN
        comment_line = OCONV(comment_line, 'G1 9999')
    END
    IF comment_line[1, 1] = '*' OR comment_line[1, 1] = '!' OR comment_line[1, 4] = 'REM ' OR (LEN(comment_line) = 3 AND comment_line = 'REM') THEN
        string_start_position = 0       ;* This is a commented line, so disregard
    END ELSE
        LastSemi = COUNT(comment_line, ';')
        IF LastSemi THEN
            comment_line = OCONV(comment_line, 'G' : LastSemi : ';1')
            IF comment_line[1, 1] = '*' OR comment_line[1, 1] = '!' OR comment_line[1, 4] = 'REM ' OR (LEN(comment_line) = 3 AND comment_line = 'REM') THEN
                string_start_position = 0         ;* this portion of the line is commented out, so disregard
            END
        END
    END
    RETURN
*
*** MV type specific settings
*
MVTYPE:
    BEGIN CASE
        CASE mv_type = 'JBASE'
            os_shell = EOF_eq : 'k'
            HL.ON = @(-13); HL.OFF = @(-14)
            IF os_type = 'L' THEN
                EXECUTE 'config-strings -@' CAPTURING Findrev
                ONIndex = INDEX(Findrev, 'reverse_on', 1)
                IF ONIndex THEN
                    OnAtb = DCOUNT(Findrev[1, ONIndex], @AM)
                    ONminus = OCONV(FIELD(Findrev<OnAtb>, ')', 1), 'MCN')
                    HL.ON = @(-ONminus)
                END
                OFFIndex = INDEX(Findrev, 'reverse_off', 1)
                IF OFFIndex THEN
                    OffAtb = DCOUNT(Findrev[1, OFFIndex], @AM)
                    OFFminus = OCONV(FIELD(Findrev<OffAtb>, ')', 1), 'MCN')
                    HL.OFF = @(-OFFminus)
                END
            END
            user_name = SYSTEM(50)
            IF user_name = '' THEN
                user_name = SYSTEM(50)
                account_name = user_name
            END
            jbase_process_file = SYSTEM(1027)
            OPEN jbase_process_file TO F.JBASEPROCESSES ELSE
                CRT
                CRT 'Cannot access jBASE processes file'
                GO STOPSUB
            END
            EXECUTE os_shell : 'echo $JBCRELEASEDIR' CAPTURING jbcreleasedir_env
            EXECUTE os_shell : 'echo $JBC_INCLUDE_PATH' CAPTURING jbc_include_path_env
            jbc_include_path_env := ':' : jbcreleasedir_env : '/include'
            EXECUTE os_shell : 'jshow -f FRED_EDITOR_FILE' CAPTURING fred_editor_file_path
            fef_index = INDEX(fred_editor_file_path, 'File:', 1)
            fred_editor_file_path = FIELD(fred_editor_file_path[fef_index, 99], ':', 2)
            fred_editor_file_path = TRIM(fred_editor_file_path<1>)
            fred_editor_file_path = FIELD(fred_editor_file_path, ' ', 1)
            IF os_type = 'L' THEN
                EXECUTE os_shell : 'ls -ld ' : fred_editor_file_path CAPTURING d_type
                IF d_type[1, 1] # 'd' THEN
                    fred_editor_file_path = ''
                    CRT
                    CRT 'Certain functionality will not work since FRED_EDITOR_FILE is not'
                    CRT 'a directory type file'
                    CRT
                END
            END
        CASE mv_type = 'D3'
            os_shell = '!'
            r83_who = SYSTEM(29)
            user_name = FIELD(who_output, ' ', 2 + r83_who)
            HL.ON = @(-13); HL.OFF = @(-14)
        CASE mv_type = 'UV'
            DUMMY = @(0, 0)   ;* DISABLE "Press any key..."
            HL.ON = @(-13); HL.OFF = @(-14)
            user_name = @LOGNAME
            os_shell = 'sh -c'
        CASE mv_type = 'SD'
            DUMMY = @(0, 0)   ;* DISABLE "Press any key..."
            HL.ON = @(-13); HL.OFF = @(-14)
            user_name = @LOGNAME
            os_shell = '!'
        CASE mv_type = 'UD'
            DUMMY = @(0, 0)   ;* DISABLE "Press any key..."
            HL.ON = @(-13); HL.OFF = @(-14)
            user_name = @LOGNAME
            CONVERT CRLF_eq : @AM TO '' IN user_name
            os_shell = '!'
            READV fred_editor_file_path FROM F.MDVOC, 'FRED_EDITOR_FILE', 2 ELSE
                fred_editor_file_path = ''
            END
            IF LEN(fred_editor_file_path) AND NOT(INDEX(fred_editor_file_path, os_slash, 1)) THEN
                EXECUTE os_shell : 'pwd' CAPTURING current_directory
                CONVERT CRLF_eq TO '' IN current_directory
                current_directory = current_directory<1>
                fred_editor_file_path = current_directory : os_slash : fred_editor_file_path
            END
            IF os_type = 'L' THEN
                EXECUTE os_shell : 'ls -ld ' : fred_editor_file_path CAPTURING d_type
                IF d_type[1, 1] # 'd' THEN
                    fred_editor_file_path = ''
                    CRT
                    CRT 'Certain functionality will not work since FRED_EDITOR_FILE is not'
                    CRT 'a directory type file'
                    CRT
                END
            END
    END CASE
    RETURN
*
EDITORSTACK:
*
    GOSUB WIDTHDEPTH
    stack_term_width = output_width - 4
    stack__term_depth = output_depth - 1
    last_stack_command = DCOUNT(R.STACK, @AM)
    stack_exit_flag = 0
    LOOP
    UNTIL stack_exit_flag DO
        CRT input_prompt :
        INPUT command_entered :
        uc_command_entered = OCONV(command_entered, 'MCU')
        BEGIN CASE
            CASE uc_command_entered = '.?'
                CRT
                CRT 'Editor stack help'
                CRT
                CRT '.Lnn -- List last nn commands, default nn is 20.'
                CRT '.Xnn -- Execute nn command.  Default is 1.'
                CRT '.Rnn/exp/newexp -- Replace exp on line nn with newexp.  Default is 1.'
                CRT '.Dnn -- Delete nn command on stack.  Default is 1.'
                CRT '.Pmm nn -- Store nn command as prestore mm.'
                CRT '.PEnn -- Edit prestore command nn.'
            CASE uc_command_entered MATCHES '".PE"1N' OR uc_command_entered MATCHES '"PE"1N'
                prestore_edit_number = OCONV(uc_command_entered, 'MCN')
                ev_temp_id = '~EV~prestore' : RND(100) : '.' : DATE() : '.' : TIME() : '.' : RND(100)
                prestore_edit_line = session_prestore_commands<prestore_edit_number + 1>
                CONVERT @VM TO @AM IN prestore_edit_line
                WRITE prestore_edit_line ON F.FRED_EDITOR_FILE, ev_temp_id
                passed_command_line = uc_command_verb : ' FRED_EDITOR_FILE ' : ev_temp_id : ' (ZQ'
                CRT
                CRT 'Editing prestore command P' : prestore_edit_number
                CALL FRED.EDITOR(passed_command_line)
                READ prestore_edit_line FROM F.FRED_EDITOR_FILE, ev_temp_id ELSE prestore_edit_line = ''
                CONVERT @AM TO @VM IN prestore_edit_line
                session_prestore_commands<prestore_edit_number + 1> = prestore_edit_line
                DELETE F.FRED_EDITOR_FILE, ev_temp_id
                CRT
                CRT ' Back to ' : file_item_id
                command_entered = 'U'
                stack_exit_flag = 1
            CASE uc_command_entered MATCHES '".P"1N" "1X0X'
                command_entered_numbers = OCONV(command_entered, 'G1 99')
                CONVERT ',' TO @AM IN command_entered_numbers
                stack_prestore_command = FIELD(uc_command_entered[2, 99], ' ', 1) : ' '
                stack_LAST.CMD = DCOUNT(command_entered_numbers, @AM)
                stack_ESC.CHAR = ''
                FOR command_entered.COUNT = 1 TO stack_LAST.CMD
                    command_entered_number = command_entered_numbers<command_entered.COUNT>
                    IF NOT(command_entered_number MATCHES "1N0N") THEN
                        command_entered_number = last_stack_command + 1         ;* NULL COMMAND
                    END
                    stack_THIS.CMD = R.STACK<command_entered_number>
                    IF LEN(stack_THIS.CMD) THEN
                        stack_prestore_command := stack_ESC.CHAR : stack_THIS.CMD
                    END ELSE
                        CRT
                        CRT 'Not a valid command number string'
                        CONTINUE
                    END
                    stack_ESC.CHAR = ESC_eq
                NEXT command_entered.COUNT
                command_entered = stack_prestore_command
                RETURN
            CASE uc_command_entered = '.L' OR uc_command_entered MATCHES "'.L'0N"
                CRT
                stack_NOL = command_entered[3, 99]
                IF stack_NOL = '' THEN stack_NOL = 20
                IF stack_NOL > last_stack_command THEN stack_NOL = last_stack_command
                stack_LCNT = 0
                FOR stack_DCNT = stack_NOL TO 1 STEP -1
                    display_line = R.STACK<stack_DCNT>
                    stack_LPCMD = INT((LEN(display_line) + (stack_term_width-1)) / stack_term_width)
                    stack_LCNT = stack_LCNT + stack_LPCMD
                    IF stack_LCNT >= stack__term_depth THEN
                        stack_CONT = ''
                        LOOP
                        UNTIL stack_CONT = 'EX' OR stack_CONT = '' OR stack_CONT MATCHES "'.X'0N" DO
                            CRT @(0) : @(-4) : "<CR> OR 'EX' OR '.Xn' : " :
                            INPUT stack_CONT, 5
                            BEGIN CASE
                                CASE stack_CONT = 'EX'
                                    stack_DCNT = 1
                                CASE stack_CONT MATCHES "'.X'0N"
                                    STACK.NBR = stack_CONT[3, 99]
                                    IF R.STACK<STACK.NBR> # '' THEN
                                        command_entered = R.STACK<STACK.NBR>
                                        stack_DCNT = 1
                                        stack_exit_flag = 1
                                    END ELSE
                                        CRT
                                        CRT 'No command ' : STACK.NBR
                                    END
                                CASE stack_CONT = ''
                            END CASE
                        REPEAT
                    END
                    FOR TL = 1 TO stack_LPCMD
                        IF TL = 1 THEN
                            CRT stack_DCNT 'R%4' : ' ' : display_line[1, stack_term_width]
                        END ELSE
                            CRT SPACE(5) : display_line[((TL-1) * stack_term_width) + 1, stack_term_width]
                        END
                    NEXT TL
                NEXT stack_DCNT
            CASE uc_command_entered = '.X' OR uc_command_entered MATCHES "'.X'0N"
                command_atb = command_entered[3, 99]
                IF command_atb = '' THEN command_atb = 1
                IF R.STACK<command_atb> # '' THEN
                    command_entered = R.STACK<command_atb>
                    R.STACK = DELETE(R.STACK, command_atb, 0, 0)
                    R.STACK = INSERT(R.STACK, 1, 0, 0, command_entered)
                    stack_exit_flag = 1
                END ELSE
                    CRT 'No command ' : command_atb
                END
            CASE uc_command_entered = '.D' OR uc_command_entered MATCHES "'.D'0N"
                command_atb = command_entered[3, 99]
                IF command_atb = '' THEN command_atb = 1
                IF R.STACK<command_atb> # '' THEN
                    R.STACK = DELETE(R.STACK, command_atb, 0, 0)
                    CRT
                    CRT 'Command ' : command_atb : ' deleted.'
                END ELSE
                    CRT
                    CRT 'No command ' : command_atb
                END
            CASE uc_command_entered[1, 2] = '.R'
                CRT
                stack_param = command_entered[3, 99999]
                stack_number = ''; last_number = 1
                LOOP
                UNTIL NOT(NUM(stack_param[last_number, 1])) DO
                    stack_number = stack_number : stack_param[last_number, 1]
                    last_number = last_number + 1
                REPEAT
                IF stack_number = '' THEN
                    stack_number = 1
                END
                stack_param = stack_param[last_number, 99999]
                stack_delim = stack_param[1, 1]
                IF COUNT(stack_param, stack_delim) = 2 THEN
                    stack_param = stack_param : stack_delim
                END
                IF COUNT(stack_param, stack_delim) = 3 THEN
                    stack_expression = FIELD(stack_param, stack_delim, 2)
                    stack_replacement = FIELD(stack_param, stack_delim, 3)
                    stack_replacement = stack_replacement<1>          ;* Handle @AM embedded
                    stack_ALL = (FIELD(stack_param, stack_delim, 4) = '*')
                    stack_line = R.STACK<stack_number>
                    stack_expression_index = INDEX(stack_line, stack_expression, 1)
                    IF stack_expression = '' THEN stack_expression_index = 1
                    IF stack_expression_index THEN
                        IF stack_ALL THEN
                            IF stack_expression = '' THEN
                                CRT 'ALL occurences not valid when replacing NULL'
                                EXIT
                            END ELSE
                                stack_line = CHANGE(stack_line, stack_expression, stack_replacement)
                            END
                        END ELSE
                            stack_line = stack_line[1, stack_expression_index-1] : stack_replacement : stack_line[stack_expression_index + LEN(stack_expression), 9999999]
                        END
                        R.STACK<stack_number> = stack_line
                        CRT stack_number 'R%4' : ' ' : stack_line
                    END
                END ELSE
                    CRT 'Invalid replace command'
                END
            CASE 1
                IF command_entered # '' THEN
                    LOCATE(command_entered, R.STACK; command_atb) THEN
                        R.STACK = DELETE(R.STACK, command_atb, 0, 0)
                    END
                    R.STACK = INSERT(R.STACK, 1, 0, 0, command_entered)
                END
                stack_exit_flag = 1
        END CASE
    REPEAT
    RETURN
*
JUMPCOMMAND:
*
    TRIMLINE = TRIM(current_line)
    UTRIMLINE = OCONV(TRIMLINE, 'MCU')
    GoIndex = INDEX(' ' : UTRIMLINE, ' GOSUB ', 1)
    IF NOT(GoIndex) THEN GoIndex = INDEX(' ' : UTRIMLINE, ' GOTO ', 1)
    IF NOT(GoIndex) THEN GoIndex = INDEX(' ' : UTRIMLINE, ' GO ', 1)
    jCommand = FIELD(TRIMLINE, ' ', 1)
    Last5 = UTRIMLINE[LEN(UTRIMLINE) - 4, 5]
    Last9 = UTRIMLINE[LEN(UTRIMLINE) - 4, 9]
    jUCommand = OCONV(jCommand, 'MCU')
    STARTL = INDEX(current_line, jCommand, 1)
    BEGIN CASE
        CASE GoIndex
            jLabel = FIELD(TRIMLINE[GoIndex + 1, 9999], ' ', 2)
            jLabel = FIELD(jLabel, ',', 1)
            BEGIN CASE
                CASE INDEX(R.ITEM, @AM : jLabel : '*', 1)
                    jLabel := '*'
                CASE INDEX(R.ITEM, @AM : jLabel : ':', 1)
                    jLabel := ':'
                CASE INDEX(R.ITEM, @AM : jLabel : ' ', 1)
                    jLabel := ' '
            END CASE
            current_attribute = 0       ;* Start at top, could be above
            do_not_save_for_a_command = 1
            STARTL = 1
            ENDL = LEN(jLabel)
            stacked_commands = 'L/' : jLabel : '/' : STARTL : '-' : ENDL
        CASE jUCommand = 'UNTIL' OR jUCommand = 'WHILE'
            do_not_save_for_a_command = 1
            ENDL = STARTL + 5
            IF jCommand # jUCommand THEN
                stacked_commands = 'L/repeat/' : STARTL : '-' : ENDL
            END ELSE
                stacked_commands = 'L/REPEAT/' : STARTL : '-' : ENDL
            END
        CASE jUCommand = 'FOR' AND NOT(INDEX(UTRIMLINE, 'NEXT', 1))
            do_not_save_for_a_command = 1
            ENDL = STARTL + 3
            IF jCommand # jUCommand THEN
                stacked_commands = 'L/next/' : STARTL : '-' : ENDL
            END ELSE
                stacked_commands = 'L/NEXT/' : STARTL : '-' : ENDL
            END
        CASE jUCommand = 'BEGIN'
            do_not_save_for_a_command = 1
            ENDL = STARTL + 2
            IF jCommand # jUCommand THEN
                stacked_commands = 'L/end/' : STARTL : '-' : ENDL
            END ELSE
                stacked_commands = 'L/END/' : STARTL : '-' : ENDL
            END
        CASE jUCommand = 'LOOP' AND Last5 # 'EPEAT'
            do_not_save_for_a_command = 1
            ENDL = STARTL + 5
            IF jCommand # jUCommand THEN
                stacked_commands = 'L/repeat/' : STARTL : '-' : ENDL
            END ELSE
                stacked_commands = 'L/REPEAT/' : STARTL : '-' : ENDL
            END
        CASE jUCommand = 'CASE'
            do_not_save_for_a_command = 1
            ENDL = STARTL + 7
            IF jCommand # jUCommand THEN
                stacked_commands = 'L/end case/' : STARTL : '-' : ENDL
            END ELSE
                stacked_commands = 'L/END CASE/' : STARTL : '-' : ENDL
            END
        CASE Last5 = ' THEN' OR Last5 = ' ELSE' OR Last5 = 'OCKED' OR Last9 = ' ON ERROR'
            do_not_save_for_a_command = 1
            ENDL = STARTL + 2
            IF jCommand # jUCommand THEN
                stacked_commands = 'L/end/' : STARTL : '-' : ENDL
            END ELSE
                stacked_commands = 'L/END/' : STARTL : '-' : ENDL
            END
        CASE 1
            CRT 'No place to jump'
            stacked_commands = 'U'
    END CASE
    RETURN
*
GETSOURCEFILE:
*
    IF find_source_file_sub # '' THEN
        CALL @find_source_file_sub(source_id, source_file_name)
    END ELSE
        source_file_name = ''
    END
    RETURN
*
EDITAGAIN:
*
    ext_dict_or_data = ''
    ext_file_name = ''
    ext_file_item_id = ''
*
    trim_current_line = TRIM(current_line)
    first_word = FIELD(trim_current_line, ' ', 1)
* disregard label
    IF NUM(first_word) OR first_word[LEN(first_word), 1] = ':' THEN
        trim_current_line = OCONV(trim_current_line, 'G1 999')
        first_word = FIELD(trim_current_line, ' ', 1)
    END
    BEGIN CASE
        CASE first_word[1, 1] = '[' OR first_word[1, 1] = '('
            trim_current_line = trim_current_line[2, LEN(trim_current_line) - 1]
            ext_file_name = FIELD(trim_current_line, ' ', 1)
            IF ext_file_name = 'DICT' THEN
                ext_dict_or_data = 'DICT'
                ext_file_name = FIELD(trim_current_line, ' ', 2)
                ext_file_item_id = FIELD(trim_current_line, ' ', 3)
                ext_file_item_id = ext_file_item_id[1, LEN(ext_file_item_id) - 1]
            END ELSE
                ext_dict_or_data = ''
                ext_file_item_id = FIELD(trim_current_line, ' ', 2)
                ext_file_item_id = ext_file_item_id[1, LEN(ext_file_item_id) - 1]
            END
        CASE first_word = 'INCLUDE' OR first_word = '$INCLUDE'
            ext_file_name = FIELD(trim_current_line, ' ', 2)
            ext_file_item_id = FIELD(trim_current_line, ' ', 3)
            IF ext_file_name = 'DICT' THEN
                ext_dict_or_data = 'DICT'
                ext_file_name = ext_file_item_id
                ext_file_item_id = FIELD(trim_current_line, ' ', 4)
            END
            IF ext_file_item_id = '' THEN
                ext_file_item_id = ext_file_name
                ext_dict_or_data = dict_or_data
                ext_file_name = file_name
                READ GotIt FROM F.FILE, ext_file_item_id ELSE
                    ext_file_name = jbcreleasedir_env : os_slash : 'include'
                END
            END
        CASE trim_current_line[1, 5] = 'SUBR('
            ext_file_item_id = trim_current_line[6, 999]
            ext_file_item_id = FIELD(ext_file_item_id, ',', 1)
            ext_file_item_id = ext_file_item_id[1, LEN(ext_file_item_id) - 1]
        CASE trim_current_line[1, 1] = 'H' AND R.ITEM<1>[1, 2] = 'PQ'
            ext_dict_or_data = ''
            trim_current_line = TRIM(trim_current_line[2, 999])
            IF trim_current_line[1, 4] = 'RUN ' THEN
                ext_file_item_id = FIELD(trim_current_line, ' ', 3)
                ext_file_name = FIELD(trim_current_line, ' ', 2)
            END ELSE
                ext_file_item_id = FIELD(trim_current_line, ' ', 1)
            END
        CASE first_word = 'CALL'
            ext_file_name = FIELD(trim_current_line, ' ', 2)
            ext_file_item_id = FIELD(trim_current_line, ' ', 3)
            IF ext_file_item_id = '' THEN
                ext_file_item_id = ext_file_name
                ext_file_name = ''
            END ELSE
                IF ext_file_name = 'DICT' THEN
                    ext_dict_or_data = 'DICT'
                    ext_file_name = ext_file_item_id
                    ext_file_item_id = FIELD(trim_current_line, ' ', 4)
                END
            END
            ext_file_item_id = FIELD(ext_file_item_id, '(', 1)
    END CASE
    IF LEN(ext_file_item_id) THEN
        passed_command_line = uc_command_verb : ' -Q ' : ext_dict_or_data : ' ' : ext_file_name : ' ' : ext_file_item_id
        passed_command_line = TRIM(passed_command_line)
        CALL FRED.EDITOR(passed_command_line)
        IF passed_command_line = 'EXK' THEN
            STOP
        END
    END ELSE
        error_message = 'Nothing to edit'
    END
    display_flag = 1
    RETURN
*
PICKFROMLIST:
*
    LOOP
        FOR display_count = 1 TO last_display_id
            IF display_list_conv = '' THEN
                this_display_item = display_items_list<display_count>
            END ELSE
                this_display_item = OCONV(display_items_list<display_count>, display_list_conv)
            END
            IF display_count / display_items_per_line = INT(display_count / display_items_per_line) THEN
                CRT display_count 'R#3' : ' ' : this_display_item 'L#35'
            END ELSE
                CRT display_count 'R#3' : ' ' : this_display_item 'L#35' :
            END
        NEXT display_count
        CRT
        CRT 'Enter # to choose, X to exit : ' :
        INPUT list_number
    UNTIL list_number = 'x' OR list_number = 'X' OR (list_number >= 1 AND list_number <= last_display_id) DO
    REPEAT
    IF list_number = 'x' OR list_number = 'X' THEN
        item_picked = ''
    END ELSE
        item_picked = display_items_list<list_number>
    END
    RETURN
*
SORTARRAY:
*
    last_unsorted_atb = DCOUNT(unsorted_array, @AM)         ;* Number of elements in the input array
    IF last_unsorted_atb <= 1 THEN
        sorted_array = unsorted_array
    END ELSE
        sort_gap = INT(last_unsorted_atb / 2)
        LOOP
        WHILE sort_gap > 0
            FOR gap_increment = sort_gap + 1 TO last_unsorted_atb
                stored_value = unsorted_array<gap_increment>
                new_gap = gap_increment - sort_gap
                LOOP
                WHILE new_gap > 0 AND unsorted_array<new_gap> > stored_value
                    unsorted_array<new_gap + sort_gap> = unsorted_array<new_gap>
                    new_gap -= sort_gap
                    unsorted_array<new_gap + sort_gap> = stored_value
                REPEAT
            NEXT gap_increment
            sort_gap = INT(sort_gap / 2)
        REPEAT
        sorted_array = unsorted_array
    END
    RETURN
*
EXPLODEITEM:
*
    CRT 'Exploding ' : dict_or_data : ' ' : file_name : ' ' : file_item_id : ' ' :
    explode_id = file_item_id
    uniq_item_id = explode_id : '_' : DATE() : '_' : TIME() : '_' : my_port_number
    include_level = 0
    include_offset = 0
    LOOP
        include_level += 1
        IF include_level = 1 THEN
            R.EXPLODE = R.ITEM
        END ELSE
            READ R.EXPLODE FROM F.FRED_EDITOR_FILE, explode_id ELSE R.EXPLODE = ''
        END
        IF R.EXPLODE # '' THEN
            IF include_level > 1 THEN
                IF R.EXPLODE = IN.BP THEN
                    EXIT
                END
            END
            IN.BP = R.EXPLODE
            explode_id = uniq_item_id
        END ELSE
            RETURN
        END
        last_item_line = DCOUNT(R.EXPLODE, @AM)
        FOR item_line = 1 TO last_item_line
            include_line = R.EXPLODE<item_line>
            line_label = ''
            trim_line = TRIM(include_line)
            trim_line = FIELD(trim_line, ';', 1)
            maybe_label = FIELD(trim_line, ':', 1)
            IF COUNT(maybe_label, ' ') = 0 AND maybe_label MATCHES '1A0X' THEN
                line_label = maybe_label : ':'
                trim_line = OCONV(trim_line, 'G1:999')
            END ELSE
                IF trim_line MATCHES '1N0X' THEN
                    after_label = 2
                    LOOP
                    WHILE trim_line[after_label, 1] = ' ' OR trim_line[after_label, 1] MATCHES '1N' DO
                        after_label += 1
                    REPEAT
                    line_label = trim_line[1, after_label-1]
                    trim_line = trim_line[after_label, 99999]
                END
            END
            trim_line = TRIM(trim_line, ' ', 'R')
            IF trim_line[1, 8] = 'INCLUDE ' OR trim_line[1, 9] = '$INCLUDE ' OR trim_line[1, 7] = 'INSERT ' OR trim_line[1, 8] = '$INSERT ' THEN
                include_file_name = FIELD(trim_line, ' ', 2)
                include_item_id = FIELD(trim_line, ' ', 3)
                IF include_file_name = 'DICT' THEN
                    include_dict_or_data = 'DICT'
                    include_file_name = include_item_id
                    include_item_id = FIELD(trim_line, ' ', 4)
                END ELSE
                    include_dict_or_data = ''
                    IF include_item_id = '' THEN
                        include_item_id = include_file_name
                        include_file_name = ''
                        GOSUB INCLUDEFILE
                    END
                END
                OPEN include_dict_or_data, include_file_name TO F.INC ELSE
                    CRT
                    CRT 'Cannot open ' : TRIM(include_dict_or_data : ' ' : include_file_name)
                    EXIT
                END
                READ R.INC FROM F.INC, include_item_id ELSE
                    include_source_line = TRIM(include_dict_or_data : ' ' : include_file_name : ' ' : include_item_id)
                    CRT
                    CRT 'Cannot read ' : include_source_line : ' (Line ' : item_line : ')'
                    EXIT
                END
                CONVERT @AM TO BS_eq IN R.INC
                R.EXPLODE<item_line> = line_label : ' !! ' : trim_line : BS_eq : R.INC : BS_eq : '!!END (' : TRIM(R.EXPLODE<item_line>) : ')'
                CRT
                CRT SPACE(include_level * 3) : item_line 'R%4' : '/' : (item_line + include_offset) 'R%4' : ' ' : include_line :
                include_offset += DCOUNT(R.INC, BS_eq) + 1
            END
        NEXT item_line
        CRT
        CONVERT BS_eq TO @AM IN R.EXPLODE
        WRITE R.EXPLODE ON F.FRED_EDITOR_FILE, explode_id
    REPEAT
    WRITE R.EXPLODE ON F.FRED_EDITOR_FILE, file_item_id : '.X'
    DELETE F.FRED_EDITOR_FILE, explode_id
    RETURN
*
INCLUDEFILE:
*
    include_file_search_path = file_name : ':' : jbc_include_path_env
    last_search_path = DCOUNT(include_file_search_path, ':')
    FOR search_path_count = 1 TO last_search_path UNTIL LEN(include_file_name)
        include_path = FIELD(include_file_search_path, ':', search_path_count)
        OPEN include_path TO F.INCLUDEPATH THEN
            READ Exists FROM F.INCLUDEPATH, include_item_id THEN
                include_file_name = include_path
            END
        END
    NEXT search_path_count
    RETURN
*
SETPARAMETERS:
*
    fred_parameter_set = ''
    fred_parameter_set<1, -1> = 'TREAT_NULL_AS_ASTERISKS'
    fred_parameter_set<2, -1> = 'Y,N'
    fred_parameter_set<3, -1> = 'If FRED BP with no item, should it be treated as FRED BP *.'
    fred_parameter_set<4, -1> = treat_null_as_asterisks
    IF mv_type = 'UD' OR mv_type = 'UV' OR mv_type = 'SD' THEN
        fred_parameter_set<5, -1> = 'N' ;* Default to not treat no ID as if * was entered
    END ELSE
        fred_parameter_set<5, -1> = 'Y' ;* Default to treat no ID as if * was entered
    END
    fred_parameter_set<1, -1> = 'ADJUST_TO_STTY'
    fred_parameter_set<2, -1> = 'T,Y,N'
    fred_parameter_set<3, -1> = 'T sets columns,rows as stty during edit, Y sets permanently, N does nothing.'
    fred_parameter_set<4, -1> = adjust_to_stty
    fred_parameter_set<5, -1> = 'T'
    fred_parameter_set<1, -1> = 'CARRY_OVER_LOCATE_AGAIN'
    fred_parameter_set<2, -1> = 'Y,N'
    fred_parameter_set<3, -1> = 'Allow A for again command to save between sessions'
    fred_parameter_set<4, -1> = carry_over_locate_again
    fred_parameter_set<5, -1> = 'Y'
    fred_parameter_set<1, -1> = 'DOUBLE_AMPERSAND'
    fred_parameter_set<2, -1> = '*P(2X)' : @SM : 'Must be 2 characters'
    fred_parameter_set<3, -1> = 'Characters representing && for ANDing in locates.'
    fred_parameter_set<4, -1> = double_ampersand
    fred_parameter_set<5, -1> = '&&'
    fred_parameter_set<1, -1> = 'FIND_SOURCE_FILE_SUB'
    fred_parameter_set<2, -1> = '*P(0X)'
    fred_parameter_set<3, -1> = 'Name of subroutine used to determine file if "FRED item_name" used.'
    fred_parameter_set<4, -1> = find_source_file_sub
    fred_parameter_set<5, -1> = 'FRED.FIND.SOURCE.FILE.' : mv_type : '.SUB'
    fred_parameter_set<1, -1> = 'ACCOUNT_WHO_FIELD'
    fred_parameter_set<2, -1> = '2,3'
    fred_parameter_set<3, -1> = 'Which part of the output from WHO is the account name (2 or 3).'
    fred_parameter_set<4, -1> = account_who_field
    fred_parameter_set<5, -1> = '2'
    fred_parameter_set<1, -1> = 'TREAT_GRAVE_AS_NULL'
    fred_parameter_set<2, -1> = 'Y,N'
    fred_parameter_set<3, -1> = 'Treat a single grave accent (`) as a blank line'
    fred_parameter_set<4, -1> = treat_grave_as_null
    fred_parameter_set<5, -1> = 'Y'
    last_parameter = DCOUNT(fred_parameter_set<1>, @VM)
    CRT
    CRT 'Set (M)aster or (U)ser parameters? : ' :
    INPUT master_user
    BEGIN CASE
        CASE master_user = 'M'
            parameters_heading = 'MASTER parameters (All users)'
            fred_parameters = R.MASTER.EDIT.PARAMS<20>
        CASE master_user = 'U'
            fred_parameters = R.USER.EDIT.PARAMS<20>
            parameters_heading = 'USER parameters (' : user_name : ')'
        CASE 1
            error_message = 'Must enter M for Master for all users or U for user parameters.'
            RETURN
    END CASE
*
***
*
    param_values = ''
    LOOP
        CRT @(-1) : parameters_heading : '   [ + = default value, not set]'
        CRT
        FOR parameter_count = 1 TO last_parameter
            param_value = fred_parameter_set<4, parameter_count>
            param_index = INDEX(fred_parameters, fred_parameter_set<1, parameter_count>, 1)
            IF param_index THEN
                fred_parameter_set<6, parameter_count> = DCOUNT(fred_parameters[1, param_index], @VM)
                param_value = fred_parameters[param_index, 999]
                param_value = param_value<1, 1>
                param_value = FIELD(param_value, '=', 2)
            END
            IF param_value = fred_parameter_set<5, parameter_count> THEN
                is_default = '+'
            END ELSE
                is_default = ''
            END
            CRT parameter_count 'R#2' : ') ' : fred_parameter_set<1, parameter_count> 'L#30' : ' : ' :
            CRT is_default 'L#2' :
            CRT param_value
            param_values<parameter_count> = param_value
        NEXT parameter_count
*
        CRT
        CRT 'Enter (S)ave, (E)xit or # to change (1-' : last_parameter : ') : ' :
        INPUT change_parameter
        change_parameter = OCONV(change_parameter, 'MCU')
        IF NUM(change_parameter) THEN
            IF INT(change_parameter) = change_parameter AND change_parameter GE 1 AND change_parameter LE last_parameter THEN
                valid_answers = fred_parameter_set<2, change_parameter, 1>
                answer_error_message = fred_parameter_set<2, change_parameter, 2>
                CRT
                CRT fred_parameter_set<3, change_parameter, 1>
                CRT fred_parameter_set<3, change_parameter, 2>
                CRT fred_parameter_set<3, change_parameter, 3>
                CRT
                CRT
                CRT fred_parameter_set<1, change_parameter> : ' = ' :
                INPUT new_value
                IF new_value = '' THEN new_value = param_values<change_parameter>
                good_value = 0
                IF LEN(valid_answers) THEN
                    IF valid_answers[1, 1] = '*' THEN
                        IF OCONV(new_value, valid_answers[2, 99]) # '' THEN
                            good_value = 1
                        END
                    END ELSE
                        CONVERT ',' TO @SM IN valid_answers
                        LOCATE new_value IN valid_answers<1, 1> SETTING good_answer THEN
                            good_value = 1
                        END
                    END
                END ELSE
                    good_value = 1
                END
                IF good_value = 1 THEN
                    IF fred_parameter_set<6, change_parameter> + 0 = 0 THEN
                        fred_parameter_set<6, change_parameter> = DCOUNT(fred_parameters<1>, @VM) + 1
                    END
                    fred_parameters<1, fred_parameter_set<6, change_parameter>> = fred_parameter_set<1, change_parameter> : '=' : new_value
                END ELSE
                    CRT
                    CONVERT @SM TO ',' IN valid_answers
                    IF valid_answers[1, 1] = '*' THEN
                        CRT answer_error_message :
                    END ELSE
                        CRT 'Must be one of these values (' : valid_answers : ')' :
                    END
                    CRT '.    Press <Enter> ' :
                    INPUT any_key
                END
            END
        END
    UNTIL change_parameter = 'S' OR change_parameter = 'E' DO
    REPEAT
    IF change_parameter = 'S' THEN
        IF master_user = 'M' THEN
            R.MASTER.EDIT.PARAMS<20> = fred_parameters
            WRITEV fred_parameters ON F.FRED_EDITOR_FILE, 'FRED*MASTER', 20
        END ELSE
            R.USER.EDIT.PARAMS<20> = fred_parameters
            WRITEV fred_parameters ON F.FRED_EDITOR_FILE, 'FRED*USER*' : user_name, 20
        END
    END ELSE
        RETURN      ;* DO NOTHING
    END
*
EDITORFLAGS:
*
    IF INDEX(R.EDIT.PARAMS<20>, 'TREAT_NULL_AS_ASTERISKS=Y', 1) THEN
        treat_null_as_asterisks = 'Y'
    END
    IF INDEX(R.EDIT.PARAMS<20>, 'TREAT_NULL_AS_ASTERISKS=N', 1) THEN
        treat_null_as_asterisks = 'N'
    END
    IF INDEX(R.EDIT.PARAMS<20>, 'ADJUST_TO_STTY=T', 1) THEN
        adjust_to_stty = 'T'
    END
    IF INDEX(R.EDIT.PARAMS<20>, 'ADJUST_TO_STTY=Y', 1) THEN
        adjust_to_stty = 'Y'
    END
    IF INDEX(R.EDIT.PARAMS<20>, 'ADJUST_TO_STTY=N', 1) THEN
        adjust_to_stty = 'N'
    END
    IF INDEX(R.EDIT.PARAMS<20>, 'CARRY_OVER_LOCATE_AGAIN=Y', 1) THEN
        carry_over_locate_again = 'Y'
    END
    IF INDEX(R.EDIT.PARAMS<20>, 'CARRY_OVER_LOCATE_AGAIN=N', 1) THEN
        carry_over_locate_again = 'N'
    END
    double_ampersand_index = INDEX(R.EDIT.PARAMS<20>, 'DOUBLE_AMPERSAND=', 1)
    IF double_ampersand_index THEN
        double_ampersand = R.EDIT.PARAMS<20>[double_ampersand_index + 17, 99]
    END ELSE
        double_ampersand = '&&'
    END
    IF INDEX(R.EDIT.PARAMS<20>, 'TREAT_GRAVE_AS_NULL=Y', 1) THEN
        treat_grave_as_null = 'Y'
    END
    IF INDEX(R.EDIT.PARAMS<20>, 'TREAT_GRAVE_AS_NULL=N', 1) THEN
        treat_grave_as_null = 'N'
    END
    find_source_file_sub_index = INDEX(R.EDIT.PARAMS<20>, 'FIND_SOURCE_FILE_SUB=', 1)
    IF find_source_file_sub_index THEN
        find_source_file_sub = R.EDIT.PARAMS<20>[find_source_file_sub_index + 21, 99]
    END ELSE
        find_source_file_sub = 'FRED.FIND.SOURCE.FILE.' : mv_type : '.SUB'
    END
    IF INDEX(R.EDIT.PARAMS<20>, 'ACCOUNT_WHO_FIELD=2', 1) THEN
        account_who_field = 2
    END
    IF INDEX(R.EDIT.PARAMS<20>, 'ACCOUNT_WHO_FIELD=3', 1) THEN
        account_who_field = 3
    END
* Override as user
    IF INDEX(R.USER.EDIT.PARAMS<20>, 'TREAT_NULL_AS_ASTERISKS=Y', 1) THEN
        treat_null_as_asterisks = 'Y'
    END
    IF INDEX(R.USER.EDIT.PARAMS<20>, 'TREAT_NULL_AS_ASTERISKS=N', 1) THEN
        treat_null_as_asterisks = 'N'
    END
    IF INDEX(R.USER.EDIT.PARAMS<20>, 'ADJUST_TO_STTY=T', 1) THEN
        adjust_to_stty = 'T'
    END
    IF INDEX(R.USER.EDIT.PARAMS<20>, 'ADJUST_TO_STTY=Y', 1) THEN
        adjust_to_stty = 'Y'
    END
    IF INDEX(R.USER.EDIT.PARAMS<20>, 'ADJUST_TO_STTY=N', 1) THEN
        adjust_to_stty = 'N'
    END
    IF INDEX(R.USER.EDIT.PARAMS<20>, 'CARRY_OVER_LOCATE_AGAIN=Y', 1) THEN
        carry_over_locate_again = 'Y'
    END
    IF INDEX(R.USER.EDIT.PARAMS<20>, 'CARRY_OVER_LOCATE_AGAIN=N', 1) THEN
        carry_over_locate_again = 'N'
    END
    double_ampersand_index = INDEX(R.USER.EDIT.PARAMS<20>, 'DOUBLE_AMPERSAND=', 1)
    IF double_ampersand_index THEN
        double_ampersand = R.USER.EDIT.PARAMS<20>[double_ampersand_index + 17, 99]
    END
    double_ampersand = double_ampersand<1, 1>
    find_source_file_sub_index = INDEX(R.USER.EDIT.PARAMS<20>, 'FIND_SOURCE_FILE_SUB=', 1)
    IF find_source_file_sub_index THEN
        find_source_file_sub = R.USER.EDIT.PARAMS<20>[find_source_file_sub_index + 21, 99]
    END ELSE
        find_source_file_sub = 'FRED.FIND.SOURCE.FILE.' : mv_type : '.SUB'
    END
    IF INDEX(R.USER.EDIT.PARAMS<20>, 'ACCOUNT_WHO_FIELD=2', 1) THEN
        account_who_field = 2
    END
    IF INDEX(R.USER.EDIT.PARAMS<20>, 'ACCOUNT_WHO_FIELD=3', 1) THEN
        account_who_field = 3
    END
    IF INDEX(R.USER.EDIT.PARAMS<20>, 'TREAT_GRAVE_AS_NULL=Y', 1) THEN
        treat_grave_as_null = 'Y'
    END
    IF INDEX(R.USER.EDIT.PARAMS<20>, 'TREAT_GRAVE_AS_NULL=N', 1) THEN
        treat_grave_as_null = 'N'
    END
    RETURN
*
SHOWVERBOSE:
*
    CRT
    CRT 'os_type                 = "' : os_type : '"'
    CRT 'mv_type                 = "' : mv_type : '"'
    CRT 'command_verb            = "' : command_verb : '"'
    CRT 'file_name               = "' : file_name : '"'
    CRT 'view_file_items         = "' : view_file_items : '"'
    CRT 'passed_list             = "' : passed_list : '"'
    CRT 'active_list count       = "' : active_list : '"'
    CRT 'b_option                = "' : b_option : '"'
    CRT 'i_option                = "' : i_option : '"'
    CRT 'l_option                = "' : l_option : '"'
    CRT 'q_option                = "' : q_option : '"'
    CRT 's_option                = "' : s_option : '"'
    CRT 'v_option                = "' : v_option : '"'
    CRT 'w_option                = "' : w_option : '"'
    CRT 'z_option                = "' : z_option : '"'
    CRT 'treat_null_as_asterisks = "' : treat_null_as_asterisks : '"'
    CRT 'adjust_to_stty          = "' : adjust_to_stty : '"'
    CRT 'carry_over_locate_again = "' : carry_over_locate_again : '"'
    CRT 'double_ampersand        = "' : double_ampersand : '"'
    CRT 'find_source_file_sub    = "' : find_source_file_sub : '"'
    CRT 'account_who_field       = "' : account_who_field : '"'
    CRT 'treat_grave_as_null     = "' : treat_grave_as_null : '"'
    RETURN
*
ITEMHASCHANGED:
*
    item_has_changed = 1
!    IF INDEX(R.ITEM,'!!AUTOFORMAT!!',1) THEN
!        GOSUB FORMATITEM
!    END
    R.CHANGED.ITEM = file_name : @VM : file_item_id : @VM : R.ITEM
    WRITE R.CHANGED.ITEM ON F.FRED_EDITOR_FILE, 'changed__' : my_port_number
    RETURN
*
FORMATITEM:
*
    left_margin = FIELD(uc_command_entered[4, 99], ',', 1)
    format_indent = FIELD(uc_command_entered, ',', 2)
    IF left_margin = '' OR NOT(NUM(left_margin)) THEN left_margin = 4
    IF format_indent = '' OR NOT(NUM(format_indent)) THEN format_indent = 3
    LOOP
        READU lockit FROM F.FRED_EDITOR_FILE, 'format__' : my_port_number LOCKED
            CONTINUE
        END THEN
            CONTINUE
        END
        EXIT
    REPEAT
    WRITE R.ITEM ON F.FRED_EDITOR_FILE, 'format__' : my_port_number
    BEGIN CASE
        CASE mv_type = 'JBASE'
            DATA ESC_eq, "bion", ESC_eq, "bi", ESC_eq, "fi"
            jed_command = jbcreleasedir_env : '/bin/JED FRED_EDITOR_FILE ' : 'format__' : my_port_number : ' (A,F' : left_margin : ',' format_indent
            EXECUTE jed_command CAPTURING Noshow_lines
        CASE mv_type = 'D3'
            d3_bformat_cmd = 'BFORMAT FRED_EDITOR_FILE ' : 'format__' : my_port_number : ' (C,' : left_margin : '-' : format_indent
            EXECUTE d3_bformat_cmd CAPTURING nada
        CASE mv_type = 'UV' OR mv_type = 'SD'
            FormatEXC = 'FORMAT FRED_EDITOR_FILE ' : 'format__' : my_port_number
            EXECUTE FormatEXC CAPTURING Noshow_lines
        CASE mv_type = 'UD'
            EXECUTE 'BLIST FRED_EDITOR_FILE ' : 'format__' : my_port_number : ' (CN' CAPTURING blist_output
            IF INDEX(blist_output, 'FRED_EDITOR_FILE ' : 'is not a directory file.', 1) THEN
                error_message = 'FMT cannot work unless FRED_EDITOR_FILE is a directory file'
            END ELSE
                next_format_line = 1
                formatted_bp = ''
                last_output = DCOUNT(blist_output, @AM)
                FOR output_count = 1 TO last_output
                    this_format_line = blist_output<output_count>
                    format_line_number = FIELD(this_format_line, ' ', 1)
                    IF NUM(format_line_number) THEN
                        format_line_number += 0
                    END
                    rest_of_line = OCONV(this_format_line, 'G1 999')
                    IF TRIM(rest_of_line)[1, 1] = '*' THEN
                        rest_of_line = TRIM(rest_of_line, ' ', 'L')
                    END
                    BEGIN CASE
                        CASE TRIM(this_format_line) = ''
                            done_with_line = 1
                        CASE format_line_number = next_format_line
                            formatted_bp<next_format_line> = rest_of_line
                            next_format_line += 1
                            done_with_line = 0
                        CASE 1
                            IF next_format_line > 1 AND NOT(done_with_line) THEN
                                formatted_bp<next_format_line - 1> := this_format_line
                            END
                    END CASE
                NEXT output_count
                WRITE formatted_bp ON F.FRED_EDITOR_FILE, 'format__' : my_port_number
            END
    END CASE
    READ BF.ITEM FROM F.FRED_EDITOR_FILE, 'format__' : my_port_number THEN
        IF BF.ITEM # R.ITEM THEN
            R.ITEM = BF.ITEM
            GOSUB ITEMHASCHANGED
        END
    END
    DELETE F.FRED_EDITOR_FILE, 'format__' : my_port_number
    RELEASE F.FRED_EDITOR_FILE, 'format__' : my_port_number
    RETURN
*
LOCATETEXT:
*
    locate_line_numbers = ''; last_locate_line_number = 0   ;* initialize
    IF do_not_save_for_a_command THEN
        do_not_save_for_a_command = 0
    END ELSE
        lookup_command = command_entered
    END
    WRITEV lookup_command ON F.FRED_EDITOR_FILE, 'LCMD*' : user_name, 1
    IF uc_command_entered2 = 'LC' OR uc_command_entered2 = 'QC' THEN
        uc_command_entered = uc_command_entered[1, 1] : uc_command_entered[3, 9999]
        command_entered = command_entered[1, 1] : command_entered[3, 9999]
        Code = 1
    END ELSE
        Code = 0
    END
    IF uc_command_entered[2, 1] = 'V' THEN
        var_search = 1
        vpos = 3
    END ELSE
        var_search = 0
        vpos = 2
    END
    command_parameter = command_entered[vpos, 99999]
    IF command_parameter[1, 1] = '*' THEN
        command_parameter = bottom_line : command_parameter[2, 99999]
        command_entered = command_entered[1, vpos - 1] : command_parameter
        uc_command_entered = OCONV(command_entered, 'MCU')
    END
    number_param = ''; last_number = 1
    LOOP
    UNTIL NOT(NUM(command_parameter[last_number, 1])) DO
        number_param = number_param : command_parameter[last_number, 1]
        last_number = last_number + 1
    REPEAT
    IF number_param = '' THEN
        number_param = 999999
        V.ONCE = 1
    END ELSE
        V.ONCE = 0
    END
    command_parameter = command_parameter[last_number, 99999]
    command_delimiter = command_parameter[1, 1]
    V.DLCOUNT = COUNT(command_parameter, command_delimiter)
    BKWD = 0
    IF V.DLCOUNT = 1 THEN
        command_parameter = command_parameter : command_delimiter
        V.DLCOUNT += 1
    END
    IF V.DLCOUNT = 3 THEN
        zone_parameters = FIELD(command_parameter, command_delimiter, 4)
        command_parameter = OCONV(command_parameter, 'G0' : command_delimiter : V.DLCOUNT)
        V.DLCOUNT -= 1
        IF OCONV(zone_parameters, 'MCU') = 'B' THEN
            BKWD = 1
        END ELSE
            search_from_zone = 1
        END
    END
    IF V.DLCOUNT = 2 THEN
        locate_attribute = current_attribute
        this_expression = FIELD(command_parameter, command_delimiter, 2)
        BEGIN CASE
            CASE enhanced_char_display = 4
                last_hex = LEN(this_expression) / 2
                IF last_hex # INT(last_hex) THEN
                    error_message = 'Must specify complete HEX string for BL'
                END
                all_hex_expression = ''
                FOR hex_count = 1 TO last_hex
                    hex_sequence = OCONV(this_expression[(hex_count-1) * 2 + 1, 2], 'MCD')
                    all_hex_expression := all_hex_expression : CHAR(hex_sequence)
                NEXT hex_count
                this_expression = all_hex_expression
            CASE enhanced_char_display = 3
                IF this_expression[1, 1] = '~' AND this_expression[LEN(this_expression), 1] = '~' THEN
                    hex_expression = this_expression[2, LEN(this_expression) - 2]
                    expression_character = XTD(hex_expression)
                    IF expression_character >= 0 AND expression_character <= 254 THEN
                        IF expression_character = INT(expression_character) THEN
                            this_expression = CHAR(expression_character)
                        END
                    END
                END
        END CASE
        zone_parameters = FIELD(command_parameter, command_delimiter, 3)
        IF OCONV(zone_parameters, 'MCU') = 'B' THEN
            BKWD = 1
        END ELSE
            search_from_zone = 1
        END
        eof_flag = 1
        IF BKWD THEN
            to_line = locate_attribute - number_param
            IF to_line < 1 THEN to_line = 1
            to_line = locate_attribute - to_line
        END ELSE
            to_line = locate_attribute + number_param
            IF to_line > bottom_line THEN to_line = bottom_line
            to_line = to_line - locate_attribute
        END
        V.ONCE.FLG = 0
        locate_expression_index = 0     ;* IN CASE OF NO V.LTO
        these_expressions = this_expression
        IF NOT(disable_double_ampersand) THEN
            these_expressions = CHANGE(these_expressions, double_ampersand, @AM)
        END
        this_expression = these_expressions<1>
        FOR line_count = 1 TO to_line UNTIL V.ONCE.FLG
            IF BKWD THEN
                current_attribute = locate_attribute - line_count
            END ELSE
                current_attribute = locate_attribute + line_count
            END
            current_line = R.ITEM<current_attribute>
            IF Code THEN
                TLine = TRIM(current_line, ' ', 'L')
                IF R.ITEM[1, 2] = 'PQ' THEN
                    IF TLine[1, 1] = 'C' THEN
                        current_line = BS_eq
                    END
                END ELSE
                    IF TLine[1, 1] = '*' OR TLine[1, 1] = '!' OR TLine[1, 3] = 'REM' THEN
                        current_line = BS_eq
                    END
                END
            END
            IF zone_parameters MATCHES "1N0N'-'1N0N" THEN
                search_from_zone = FIELD(zone_parameters, '-', 1)
                search_to_zone = FIELD(zone_parameters, '-', 2) - search_from_zone
                search_line = current_line[search_from_zone, search_to_zone + 1]
            END ELSE
                search_line = current_line
            END
            locate_expression_index = INDEX(search_line, this_expression, 1)
            IF uc_command_entered1 = 'Q' AND NOT(locate_expression_index) THEN
                locate_expression_index = INDEX(OCONV(search_line, 'MCU'), OCONV(this_expression, 'MCU'), 1)
            END
            IF locate_expression_index AND var_search THEN
* Added to not include strings in quotes or commented lines
                quote_line = search_line; string_start_position = locate_expression_index; GOSUB INQUOTES
                IF string_start_position = 0 THEN
                    locate_expression_index = 0
                END
* End mod
                IF locate_expression_index > 1 THEN
                    before_string = search_line[locate_expression_index-1, 1]
                END ELSE
                    before_string = ''
                END
                after_string = search_line[locate_expression_index + LEN(this_expression), 1]
                valid_before = INDEX(before_var_chars, before_string, 1)
                valid_after = INDEX(after_var_chars, after_string, 1)
                locate_expression_index = (valid_before AND valid_after) * locate_expression_index
            END
            IF locate_expression_index THEN
                last_expression = DCOUNT(these_expressions, @AM)
                IF last_expression > 1 THEN
                    FOR anded_expressions = 2 TO last_expression
                        locate_expression_index = INDEX(search_line, these_expressions<anded_expressions>, 1)
                        IF uc_command_entered1 = 'Q' AND NOT(locate_expression_index) THEN
                            locate_expression_index = INDEX(OCONV(search_line, 'MCU'), OCONV(these_expressions<anded_expressions>, 'MCU'), 1)
                        END
                    NEXT anded_expressions
                END
            END
            IF locate_expression_index THEN
                highlight_info = this_expression
                highlight_info<3> = zone_parameters
                GOSUB DISPLAYLINE
                IF V.ONCE THEN
                    V.ONCE.FLG = 1
                END
            END
        NEXT line_count
        IF NOT(locate_expression_index) THEN
            GOSUB DISPLAYLINE
            DEL locate_line_numbers<last_locate_line_number>
            last_locate_line_number -= 1
        END
        IF to_line = bottom_line AND current_attribute = bottom_line AND eof_flag THEN
            CRT 'EOF'
        END
    END ELSE
        error_message = 'Invalid L command'
    END
    return_only_numbers = 0   ;* reset to default
    RETURN
END       ;* Needed for some versions of UniVerse
