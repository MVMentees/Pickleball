    SUBROUTINE FRED.EDITOR(command_line)
    PROMPT ''
    orig_command_line = command_line
    history_oops_version_status = ''; file_name = ''; delete_voc = ''; adjust_to_stty = ''; preserve_term = ''          ;* Needed for STOPSUB
    return_only_numbers = 0   ;* Makes LOCATETEXT just return the line numbers for internal use
    locate_line_numbers = ''; last_locate_line_number = 0   ;* initialize
    EXECUTE 'WHO' CAPTURING who_output
*
*** Parse command line
*
* options
*
    command_options = ',' : FIELD(command_line, '(', 2)
    command_line = FIELD(command_line, '(', 1)
    IF command_line[LEN(command_line), 1] = ' ' THEN
        command_line = command_line[1, LEN(command_line) - 1]
    END
    editor_name = FIELD(command_line, ' ', 1)
    last_space_dash = COUNT(command_line, ' -')
    FOR space_dash_count = 1 TO last_space_dash
        dash_options_index = INDEX(command_line, ' -', 1)
        this_command_option = command_line[dash_options_index + 2, 9999]
        this_command_option = FIELD(this_command_option, ' ', 1)
        command_options := ',' : this_command_option
        command_line_before = command_line[1, dash_options_index]
        command_line_after = command_line[dash_options_index + LEN(this_command_option) + 2, 9999]
        command_line = TRIM(command_line_before : command_line_after)
    NEXT space_dash_count
    command_options := ','
*
    uc_command_options = OCONV(command_options, 'MCU')
    help_option = INDEX(uc_command_options, ',-HELP', 1)    ;* User help
    l_option = INDEX(uc_command_options, ',L', 1) ;* Specify a list
    IF l_option THEN
        passed_list = FIELD(command_options[l_option + 2, 9999], ',', 1)
        IF NOT(LEN(passed_list)) THEN
            CRT
            CRT 'Must specify list name after L option.  Perhaps you put a space?'
            CRT
            GO STOPSUB
        END
        command_options = command_options[1, l_option-1] : command_options[l_option + LEN(passed_list) + 2, 9999]
        uc_command_options = OCONV(command_options, 'MCU')
    END ELSE
        passed_list = ''
    END
    b_option = INDEX(uc_command_options, 'B', 1)  ;* Allow blank line entry
    i_option = INDEX(uc_command_options, 'I', 1)  ;* Inquiry only
    IF i_option THEN
        input_prompt = 'I>'
    END ELSE
        input_prompt = '.'
    END
    q_option = INDEX(uc_command_options, 'Q', 1)  ;* Quiet mode (not kept as last item edited)
    s_option = INDEX(uc_command_options, 'S', 1)  ;* Suppress Line numbers
    v_option = INDEX(uc_command_options, 'V', 1)  ;* Verbose info on FRED itself
    w_option = INDEX(uc_command_options, 'W', 1)  ;* Wait on lock
    z_option = INDEX(uc_command_options, 'Z', 1)  ;* No "TOP", "BTM" or other messages
*
* command verb
*
    command_verb = FIELD(command_line, ' ', 1)
*
*** Save active list if present
*
    last_file_item_list = 0; file_item_list = ''
    outside_list = SYSTEM(11)
    IF outside_list AND passed_list THEN
        CRT
        CRT 'Cannot have an active list and have -L' : passed_list : ' specified.'
        CRT
        GO STOPSUB
    END
    IF passed_list THEN
        EXECUTE 'GET-LIST ' : passed_list CAPTURING nada
        outside_list = SYSTEM(11)
    END
    IF outside_list THEN
        LOOP
            READNEXT file_item_id ELSE EXIT
            last_file_item_list += 1
            file_item_list<last_file_item_list> = file_item_id
        REPEAT
    END
*
*** Preserve TERM statement as entered
*
    IF NOT(q_option) THEN
        output_depth = SYSTEM(3)
        output_width = SYSTEM(2) - 1
        preserve_term = 'TERM ' : output_width + 1 : ',' : output_depth
    END ELSE
        preserve_term = ''
    END
*
************************************************************************
* FRED - The free editor for Multi-Value platforms
************************************************************************
*
    CRLF_eq = CHAR(13) : CHAR(10)       ;* D3 bug    EQUATE CRLF_eq TO CHAR(13):CHAR(10)
    EQUATE BS_eq TO CHAR(8)
    EQUATE TM_eq TO CHAR(251)
    EQUATE CR_eq TO CHAR(13)
    EQUATE LF_eq TO CHAR(10)
    EQUATE TAB_eq TO CHAR(9)
    EQUATE ESC_eq TO CHAR(27)
    EQUATE STX_eq TO CHAR(2)
    EQUATE BELL_eq TO CHAR(7)
    EQUATE EOF_eq TO CHAR(255)
    enhanced_char_display_desc = 'display raw data including delimiters @VM and @SM'
    enhanced_char_display_desc<2> = 'display raw data except for @VM as ] and @SM as \'
    enhanced_char_display_desc<3> = 'display @VM as ], @SM as \ and display non-printables as "."'
    enhanced_char_display_desc<4> = 'display @VM as ], @SM as \ and display non-printables as "~HEX~"'
    enhanced_char_display_desc<5> = 'show all data as HEX string'
    valid_save_options = 'BCFKOQRU'
    highest_atb_allowed = 999999
    fibcc_override_catalog = 0
    stacked_commands = ''
    from_stack = 0
    window_length = 0
    R.STACK = ''
    help_url = 'https://docs.intersystems.com/latest/csp/docbook/DocBook.UI.Page.cls?KEY=RVBS_c'
    non_inquiry_commands = '.CX.UC.CAT.CATN.I.IEX.R.ME.FD.FDK.'
    non_inquiry_commands1 = '.R.OOPS.'
    non_inquiry_commands2 = '.AL.AP.GA.I .MV.FI.FS.DE.DM.'
    non_inquiry_commands3 = '.CVO.CVI.CVP.BKD.MVS.'
    input_sleep_secs = .01    ;* Allows for blank lines in cut/paste
*
    OPEN 'MD' TO F.MDVOC THEN
        md_voc = 'MD'
    END ELSE
        md_voc = 'VOC'
        OPEN 'VOC' TO F.MDVOC ELSE
            CRT
            CRT 'Cannot open the MD or VOC for this account'
            CRT
            GO STOPSUB
        END
    END
*
*** Set O/S type and MultiValue type
*
    os_type = 'W'   ;* Assume windows
    READ R.BANG FROM F.MDVOC, '!' ELSE R.BANG = ''
    IF OCONV(R.BANG<1>, 'MCU')[1, 1] = 'V' THEN
        EXECUTE '!pwd' CAPTURING my_pwd
    END ELSE
        my_pwd = ''
    END
    IF NOT(INDEX(my_pwd, '/', 1)) AND NOT(INDEX(my_pwd, '\', 1)) THEN
        EXECUTE 'sh -c "pwd"' CAPTURING my_pwd
    END
    CONVERT @AM : CRLF_eq TO '' IN my_pwd
    IF my_pwd[1, 1] = '/' THEN
        os_type = 'L'
    END ELSE
        EXECUTE '!pwd' CAPTURING my_pwd
        CONVERT @AM : CRLF_eq TO '' IN my_pwd
        IF my_pwd[1, 1] = '/' THEN
            os_type = 'L'
        END
    END
*
    mv_type = 'D3'
    READ is_this_unidata FROM F.MDVOC, 'SAVEDLISTS' THEN
        IF is_this_unidata<1>[1, 3] = 'DIR' THEN
            mv_type = 'UD'
        END
    END ELSE
        READ is_this_universe FROM F.MDVOC, '&SAVEDLISTS&' THEN
            IF INDEX(is_this_universe<3>, 'D_', 1) THEN
                mv_type = 'UV'
            END
        END ELSE
            READ is_this_SD FROM F.MDVOC, '$SAVEDLISTS' THEN
                IF is_this_SD<2> = '$SVLISTS' THEN
                    mv_type = 'SD'
                END
            END
        END
    END
    EXECUTE 'jdiag' CAPTURING is_this_jbase
    IF INDEX(is_this_jbase, 'jBASE', 1) THEN
        mv_type = 'JBASE'
    END
    OPEN 'FRED_EDITOR_FILE' TO F.FRED_EDITOR_FILE ELSE
        CRT
        CRT 'It appears this is the first time you are using FRED.  We cannot open the'
        CRT 'FRED_EDITOR_FILE.  This file is a work file for FRED.'
        CRT 'Can I create the needed file? (Y/N) : ' :
        INPUT create_fred
        create_fred = OCONV(create_fred, 'MCU')
        IF create_fred = 'Y' THEN
            BEGIN CASE
                CASE mv_type = 'JBASE'
                    EXECUTE 'CREATE-FILE FRED_EDITOR_FILE TYPE=UD'
                CASE mv_type = 'UV'
                    EXECUTE 'CREATE-FILE FRED_EDITOR_FILE 1'
                CASE mv_type = 'UD'
                    EXECUTE 'CREATE-FILE DIR FRED_EDITOR_FILE'
                CASE mv_type = 'SD'
                    EXECUTE 'CREATE-FILE FRED_EDITOR_FILE'
                CASE 1
                    EXECUTE 'CREATE-FILE FRED_EDITOR_FILE 7,1 101,1'
            END CASE
        END ELSE
            CRT
            CRT 'Create the FRED_EDITOR_FILE if you want to use FRED.'
            CRT
            GO STOPSUB
        END
        OPEN 'FRED_EDITOR_FILE' TO F.FRED_EDITOR_FILE ELSE
            CRT
            CRT 'Could not create the file.  There may be an MD/VOC item call FRED_EDITOR_FILE.'
            CRT
            GO STOPSUB
        END
    END
    fred_editor_file_path = ''          ;* derived later when you know mv_type and os_type
    history_oops_version_status = ''
    OPEN 'FRED_EDITOR_FILE_HIST' TO F.FRED_EDITOR_FILE_HIST THEN
        history_flag = 1
        history_oops_version_status = 'History ON '
    END ELSE
        history_flag = 0
        history_oops_version_status = 'History OFF '
    END
    OPEN 'FRED_EDITOR_FILE_OOPS' TO F.FRED_EDITOR_FILE_OOPS THEN
        oops_flag = 1
        history_oops_version_status := 'Oops ON '
    END ELSE
        oops_flag = 0
        history_oops_version_status := 'Oops OFF '
    END
    OPEN 'FRED_EDITOR_FILE_VERSIONS' TO F.FRED_EDITOR_FILE_VERSIONS THEN
        version_flag = 1
        history_oops_version_status := 'Versioning ON'
    END ELSE
        version_flag = 0
        history_oops_version_status := 'Versioning OFF'
    END
    prestore_commands = ''; prestore_count = ''
    original_prestore_commands = ''
    do_not_save_for_a_command = 0
    command_stack = ''
    enhanced_char_display = 1
    lookup_command = ''
    catalog_options = ''
*
*** Set defaults if not set in parameter files
*
    IF mv_type = 'UD' OR mv_type = 'UV' OR mv_type = 'SD' THEN
        treat_null_as_asterisks = 'N'   ;* Default to not treat no ID as if * was entered
    END ELSE
        treat_null_as_asterisks = 'Y'   ;* Default to treat no ID as if * was entered
    END
    adjust_to_stty = 'T'      ;* Default to change TERM to match stty settings while in editor
    carry_over_locate_again = 'Y'       ;* Carry the A for again over from one session to the other
    treat_grave_as_null = 'Y' ;* Treat a single grave accent on the line as a blank line
    account_who_field = 2
    IF os_type = 'L' THEN
        os_slash = '/'
    END ELSE
        os_slash = '\'
    END
    GOSUB MVTYPE
    IF help_option THEN
        GOSUB USERHELP
        STOP
    END
*
*** Read parameter MASTER file
*
    READ R.MASTER.EDIT.PARAMS FROM F.FRED_EDITOR_FILE, 'FRED*MASTER' ELSE
        R.MASTER.EDIT.PARAMS = ''
    END
*
*** Overlay with user if present
*
    R.EDIT.PARAMS = R.MASTER.EDIT.PARAMS
    READ R.USER.EDIT.PARAMS FROM F.FRED_EDITOR_FILE, 'FRED*USER*' : user_name THEN
        FOR user_fields = 1 TO 19
            R.EDIT.PARAMS<user_fields> = R.USER.EDIT.PARAMS<user_fields>
        NEXT user_fields
    END ELSE
        R.USER.EDIT.PARAMS = ''
    END
    GOSUB EDITORFLAGS
*
*** Initialize session
*
    my_port_number = FIELD(who_output, ' ', 1)
    account_name = FIELD(who_output, ' ', account_who_field)
    hist_comment = ''
    disable_double_ampersand = 0
    IF carry_over_locate_again = 'Y' THEN
        READV lookup_command FROM F.FRED_EDITOR_FILE, 'LCMD*' : user_name, 1 ELSE
            lookup_command = ''
        END
    END
*
*** Prestores
*
    session_prestore_commands = R.EDIT.PARAMS<1>
    FOR prestore_load = 2 TO 10
        session_prestore_commands<prestore_load> = R.EDIT.PARAMS<prestore_load>
    NEXT prestore_load
    original_prestore_commands = session_prestore_commands  ;* Set to original in case new ones are added
    IF session_prestore_commands<1> = '' THEN
        session_prestore_commands<1> = 'LD'
        original_prestore_commands<1> = 'LD'
        prestore_one_null = 1
    END ELSE
        prestore_one_null = 0
    END
    COMMON D.INTBLK(1000)
    DIM D.OOPSBLK(1000); MAT D.OOPSBLK = ''
    before_var_chars = ' ();:+-*/,&!^#=<>[]@{}' : @AM : @VM : @SVM : TAB_eq     ;* helps determine variables
    after_var_chars = before_var_chars : \'"\ : '\' ;* helps determine variables
*
*** Check for last item edited
*
    IF command_verb = command_line THEN
        READV command_line FROM F.FRED_EDITOR_FILE, 'last_item_edited_by_' : user_name, 1 ELSE
            CRT 'No last item to edit'
            GO STOPSUB
        END
        orig_command_line = command_line
    END
    uc_command_verb = OCONV(command_verb, 'MCU')
*
* file name
*
    delete_voc = 0
    file_name = FIELD(command_line, ' ', 2)
    IF file_name = 'SYSTEM1027' THEN
        file_name = SYSTEM(1027)
        i_option = 1
    END
    IF file_name = 'DICT' OR file_name = 'DATA' THEN
        dict_or_data = file_name
        file_name = FIELD(command_line, ' ', 3)
        item_field = 3
    END ELSE
        dict_or_data = ''
        item_field = 2
    END
*
*** Handle Account pathing like D3
*
    d3_file_pathing = 0
    IF COUNT(file_name, ',') = 2 THEN
        d3_account = FIELD(file_name, ',', 1)
        d3_dict_file = FIELD(file_name, ',', 2)
        d3_data_file = FIELD(file_name, ',', 3)
        BEGIN CASE
            CASE mv_type = 'UD'
                CRT
                CRT 'Account pathing is not supported on Unidata'
                CRT
                GO STOPSUB
            CASE mv_type = 'SD'
                CRT
                CRT 'Account pathing is not supported on SD'
                CRT
                GO STOPSUB
            CASE mv_type = 'D3'
                NULL          ;* Not neeed since D3 already handles this
            CASE 1
                d3_file_pathing = 1
                R.VOC = 'Q'
                R.VOC<2> = d3_account
                R.VOC<3> = d3_dict_file : ',' : d3_data_file
                file_name = 'FRED_EDITOR_' : d3_dict_file : DATE() : '_' : TIME() : '_' : my_port_number
                READU lockvoc FROM F.MDVOC, file_name ELSE NULL
                WRITEU R.VOC ON F.MDVOC, file_name
                delete_voc = 1
        END CASE
    END
*
* item name(s)
*
    quoted_asterisks = 0      ;* If asterisk in quotes, don't do all items
    command_line_items_index = INDEX(command_line, ' ', item_field)
    IF command_line_items_index THEN
        command_line_items = command_line[command_line_items_index + 1, 9999]
    END ELSE
        command_line_items = ''
    END
    file_items = ''
    last_file_item = 0
    LOOP
        file_item = FIELD(command_line_items, ' ', 1)
    UNTIL file_item = '' DO
        first_char = file_item[1, 1]
        IF first_char = '\' OR first_char = "'" OR first_char = '"' THEN
            end_quote = INDEX(command_line_items, first_char, 2)
            IF end_quote THEN
                file_item = command_line_items[2, end_quote-2]
                IF file_item = '*' THEN
                    quoted_asterisks = 1
                END
                last_file_item += 1
                IF file_item = '' THEN
                    file_item = BS_eq   ;* can't be entered from keyboard
                END
                file_items<last_file_item> = file_item
                command_line_items = command_line_items[end_quote + 2, 9999]
            END ELSE
                CRT
                CRT 'Cannot have open quote character ["\' : "'] without closing"
                CRT
                GO STOPSUB
            END
        END ELSE
            last_file_item += 1
            file_items<last_file_item> = file_item
            command_line_items = OCONV(command_line_items, 'G1 99')
        END
    REPEAT
*
* Handle special cases where only file_item specified in the file_name variable
*
    file_opened = 0
    OPEN dict_or_data, file_name TO F.FILE THEN
        file_opened = 1
    END ELSE
        IF file_items = '' THEN
*
*** Check if VERB is in the MD
*
            READ R.MDVOC FROM F.MDVOC, file_name THEN
                mdvoc_verb = R.MDVOC[1, 2] = 'PQ'
                mdvoc_verb += (R.MDVOC[1, 2] = 'PA' AND (mv_type = 'UV' OR mv_type = 'UD' OR mv_type = 'JBASE' OR mv_type = 'SD'))
                mdvoc_verb += (R.MDVOC<1> = 'M' AND (mv_type = 'D3' OR mv_type = 'JBASE'))
                mdvoc_verb += (R.MDVOC<1> = 'N' AND (mv_type = 'D3' OR mv_type = 'JBASE'))
                IF mdvoc_verb THEN
                    file_items = file_name
                    file_name = md_voc
                    GO OPENFILE
                END
            END
*
*** Check if a CATALOGed program
*
            source_id = file_name
            GOSUB GETSOURCEFILE
            IF LEN(source_file_name) THEN
                file_items = file_name
                file_name = source_file_name
                GO OPENFILE
            END
*
*** Check if o/s type format
*
            os_file_slashes = COUNT(file_name, os_slash)
            IF file_items = '' AND os_file_slashes THEN
                file_items = FIELD(file_name, os_slash, os_file_slashes + 1)
                file_name = OCONV(file_name, 'G0' : os_slash : os_file_slashes)
                BEGIN CASE
                    CASE mv_type = 'UD'
                        R.VOC = 'DIR'
                        R.VOC<2> = file_name
                        R.VOC<3> = 'D_VOC'
                        CONVERT os_slash TO '_' IN file_name
                        file_name = 'FRED_EDITOR_' : file_name : DATE() : '_' : TIME() : '_' : my_port_number
                        READU lockvoc FROM F.MDVOC, file_name ELSE NULL
                        WRITEU R.VOC ON F.MDVOC, file_name
                        delete_voc = 1
                    CASE mv_type = 'UV'
                        R.VOC = 'F'
                        R.VOC<2> = file_name
                        R.VOC<3> = 'D_VOC'
                        CONVERT os_slash TO '_' IN file_name
                        file_name = 'FRED_EDITOR_' : file_name : DATE() : '_' : TIME() : '_' : my_port_number
                        READU lockvoc FROM F.MDVOC, file_name ELSE NULL
                        WRITEU R.VOC ON F.MDVOC, file_name
                        delete_voc = 1
                END CASE
                GO OPENFILE
            END
        END
    END
*
OPENFILE:
*
    IF NOT(file_opened) THEN
        OPEN dict_or_data, file_name TO F.FILE ELSE
            CRT
            CRT 'Unable to open file ' : dict_or_data : ' ' : file_name
            CRT
            GO STOPSUB
        END
    END
    IF delete_voc AND file_name[1, 12] = 'FRED_EDITOR_' THEN
        DELETE F.MDVOC, file_name
    END
    view_file_items = file_items
    CONVERT @AM TO ' ' IN view_file_items
*
*** Handle Active select list or '*' for item name
*
    active_list = 0
    BEGIN CASE
        CASE LEN(passed_list) AND LEN(file_items)
            CRT
            CRT 'Cannot specify items "' : view_file_items : '" and have -L' : passed_list : ' specified'
            CRT
            GO STOPSUB
        CASE last_file_item_list
            IF LEN(file_items) THEN
                CRT
                CRT 'Cannot specify items "' : view_file_items : '" and have active save list'
                CRT
                GO STOPSUB
            END
        CASE (file_items = '*' AND NOT(quoted_asterisks)) OR (file_items = '' AND treat_null_as_asterisks = 'Y')
            SELECT F.FILE
            file_items = ''
            active_list = 1
    END CASE
*
*** Allow ... to get list of items with that prefix
*
    list_of_programs = (file_items[1, 3] = '...')
    list_of_programs += (file_items[1, 1] = '[')
    list_of_programs += (file_items[LEN(file_items) - 2, 3] = '...')
    list_of_programs += (file_items[LEN(file_items), 1] = ']')
    IF list_of_programs THEN
        READ dots_on_file FROM F.FILE, file_items ELSE
            GOSUB WIDTHDEPTH
            dots_select_command = 'SSELECT ' : dict_or_data : ' ' : file_name
            BEGIN CASE
                CASE mv_type = 'JBASE'
                    IF file_items[1, 1] = '[' THEN
                        file_items = '...' : file_items[2, 999]
                    END
                    IF file_items[LEN(file_items), 1] = ']' THEN
                        file_items = file_items[1, LEN(file_items) - 1] : '...'
                    END
                    dots_select_command := ' LIKE "' : file_items : '"'
                    dots_select_command := ' SAMPLE ' : max_display_items + 1
                CASE mv_type = 'UV' OR mv_type = 'UD' OR mv_type = 'SD'
                    IF file_items[1, 1] = '[' THEN
                        file_items = '...' : file_items[2, 999]
                    END
                    IF file_items[LEN(file_items), 1] = ']' THEN
                        file_items = file_items[1, LEN(file_items) - 1] : '...'
                    END
                    dots_select_command := ' WITH @ID LIKE "' : file_items : '"'
                    dots_select_command := ' SAMPLE ' : max_display_items + 1
                CASE mv_type = 'D3'
                    IF file_items[1, 3] = '...' THEN
                        file_items = '[' : file_items[4, 999]
                    END
                    IF file_items[LEN(file_items) - 2, 3] = '...' THEN
                        file_items = file_items[1, LEN(file_items) - 3] : ']'
                    END
                    dots_select_command := ' = "' : file_items : '"'
            END CASE
            EXECUTE dots_select_command CAPTURING nada
            last_display_id = 0; display_items_list = ''
            LOOP
                READNEXT display_id ELSE EXIT
                last_display_id += 1
                display_items_list<last_display_id> = display_id
            REPEAT
            BEGIN CASE
                CASE last_display_id = 0
                    CRT
                    CRT 'No item selected with ' : file_items
                    GO STOPSUB
                CASE last_display_id = 1
                    file_items = display_items_list<1>
                CASE last_display_id > max_display_items
                    CRT
                    CRT 'More than ' : max_display_items : ' items match this'
                    GO STOPSUB
                CASE 1
                    display_list_conv = ''
                    GOSUB PICKFROMLIST
                    IF item_picked = '' THEN
                        GO STOPSUB
                    END ELSE
                        file_items = item_picked
                        view_file_items = file_items
                    END
            END CASE
        END
    END
*
***
*
    IF v_option THEN
        GOSUB SHOWVERBOSE
    END
*
*** Get item ID from file_items or READNEXT from list
*
    item_count = 0
    last_file_item = DCOUNT(file_items, @AM)
    IF last_file_item THEN
        file_item_list = file_items
        last_file_item_list = last_file_item
    END
    exit_from_list = 0
    IF NOT(active_list) AND NOT(last_file_item_list) THEN
        CRT
        CRT 'Item ID? ' : ; INPUT file_items
        IF LEN(file_items) THEN
            last_file_item = 1
        END ELSE
            GO STOPSUB
        END
    END
    LOOP
        IF exit_from_list THEN GO STOPSUB
        item_count += 1
        IF last_file_item_list THEN
            IF item_count > last_file_item_list THEN GO STOPSUB
            file_item_id = file_item_list<item_count>
        END ELSE
            READNEXT file_item_id ELSE GO STOPSUB
        END
        IF file_item_id = BS_eq THEN file_item_id = ''
        basic_err_count = 0
        last_basic_error = 0
        last_basic_output = 0
        GOSUB READITEM
    REPEAT
*
READITEM:
*
    new_item = 0
    in_time = TIME()
    IF i_option THEN
        READ R.ITEM FROM F.FILE, file_item_id THEN
            item_has_changed = 0
            GOSUB EDITITEM
        END ELSE
            CRT 'Item ' : dict_or_data : ' ' : file_name : ' ' : file_item_id : ' - not on file'
        END
    END ELSE
DOREADU:
        READU R.ITEM FROM F.FILE, file_item_id LOCKED
            IF w_option THEN
                in_seconds = TIME() - in_time
                CRT @(0) : 'Waiting for item to be unlocked. (' : in_seconds : ' seconds)   Press "A" to abort : ' :
                ECHO OFF
                INPUT a_to_abort :      ;* FOR 10 ELSE a_to_abort = ''
                ECHO ON
                IF a_to_abort = 'a' OR a_to_abort = 'A' THEN
                    CRT '   Aborted!'
                    GO STOPSUB          ;* A or a SEQ()
                END
                GO DOREADU
            END
            BEGIN CASE
                CASE mv_type = 'JBASE'
                    locking_port_number = SYSTEM(43)
                    READV lock_user_id FROM F.JBASEPROCESSES, locking_port_number, 6 ELSE lock_user_id = ''
                    IF os_type = 'L' THEN
                        get_name_cmd = 'getent passwd ' : lock_user_id
                        EXECUTE os_shell : get_name_cmd CAPTURING location_line
                        lock_name = FIELD(location_line, ':', 5)
                    END ELSE
                        lock_name = ''
                    END
                    IF lock_name = '' THEN lock_name = lock_user_id
                CASE mv_type = 'UD'
                    locking_port_number = SYSTEM(53)
                    EXECUTE 'LISTUSER' CAPTURING listuser_output
                    CONVERT CRLF_eq TO '' IN listuser_output
                    listuser_count = 0
                    past_udt = 0
                    lock_name = ''
                    LOOP
                        listuser_count += 1
                        listuser_line = TRIM(listuser_output<listuser_count>)
                    UNTIL LEN(lock_name) OR (listuser_line = '' AND past_udt) DO
                        udt_number = FIELD(listuser_line, ' ', 1)
                        IF past_udt AND udt_number = locking_port_number THEN
                            lock_name = FIELD(listuser_line, ' ', 4)
                        END
                        IF udt_number = 'UDTNO' THEN
                            past_udt = 1
                        END
                    REPEAT
                CASE 1
                    locking_port_number = 'Unknown'
                    lock_name = ''
            END CASE
            CRT 'LOCK -- PortNo ' : locking_port_number : ' ' : lock_name
            passed_command_line = uc_command_verb : ' ' : TRIM(dict_or_data : ' ' : file_name) : ' ' : file_item_id : ' (I'
            CALL FRED.EDITOR(passed_command_line)
        END THEN
            item_has_changed = 0
            READ R.CHANGED FROM F.FRED_EDITOR_FILE, 'changed__' : my_port_number THEN
                changed_file = R.CHANGED<1, 1>; changed_item_id = R.CHANGED<1, 2>
                IF changed_file = file_name AND changed_item_id = file_item_id THEN
                    LOOP
                        CRT
                        CRT 'This item was being edited and did not get filed with changes.'
                        CRT 'Do you want to (R)ecover changes, (I)gnore changes or (D)elete changes? : ' :
                        INPUT r_i_d
                        r_i_d = OCONV(r_i_d, 'MCU')
                    UNTIL r_i_d = 'R' OR r_i_d = 'I' OR r_i_d = 'D' DO
                    REPEAT
                    BEGIN CASE
                        CASE r_i_d = 'R'
                            R.ITEM = R.CHANGED
                            item_has_changed = 1
                        CASE r_i_d = 'I'
                        CASE r_i_d = 'D'
                            DELETE F.FRED_EDITOR_FILE, 'changed__' : my_port_number
                    END CASE
                END
            END
            GOSUB EDITITEM
        END ELSE
            R.ITEM = ''
            new_item = 1
            item_has_changed = 0
            GOSUB EDITITEM
        END
    END
    RETURN
*
STOPSUB:
*
    IF delete_voc AND file_name[1, 12] = 'FRED_EDITOR_' THEN
        DELETE F.MDVOC, file_name
    END
    IF adjust_to_stty = 'T' AND LEN(preserve_term) THEN
        EXECUTE preserve_term
    END
    RETURN
*
EDITITEM:
*
    IF NOT(z_option) THEN
        IF last_file_item_list > 1 THEN
            list_info_line = '(Number ' : item_count : ' of ' : last_file_item_list : ' items)'
        END ELSE
            list_info_line = ''
        END
        CRT file_item_id : ' ' : list_info_line
        IF new_item THEN
            CRT BELL_eq : 'NEW ITEM'
        END
    END
    IF NOT(q_option) AND NOT(i_option) THEN
        IF file_item_id = '' THEN file_item_id = '""'
        WRITEV orig_command_line ON F.FRED_EDITOR_FILE, 'last_item_edited_by_' : user_name, 1
    END
    current_attribute = 0
    block_begin_attribute = ''
    oops_commands = ''
    MAT D.OOPSBLK = ''
*
*** Convert windows item
*
    IF COUNT(R.ITEM, CRLF_eq) > 0 AND NOT(i_option) THEN
        LOOP
            CRT
            CRT 'Item contains carriage-return/line-feeds.'
            CRT 'Do you want to convert them to @AM? (<N>/Y) :' :
            INPUT y_or_n      ;* FOR 100 ELSE y_or_n = 'N'
            y_or_n = OCONV(y_or_n, 'MCU')
        UNTIL y_or_n = 'N' OR y_or_n = 'Y' DO
        REPEAT
        IF y_or_n = 'Y' THEN
            R.ITEM = CHANGE(R.ITEM, CRLF_eq, @AM)
            GOSUB ITEMHASCHANGED
        END
    END
    IF COUNT(R.ITEM, CR_eq) > 0 AND NOT(i_option) THEN
        LOOP
            CRT
            CRT 'Item contains carriage-returns (Windows).'
            CRT 'Do you want to remove them? (<N>/Y) :' :
            INPUT y_or_n      ;* FOR 100 ELSE y_or_n = 'N'
            y_or_n = OCONV(y_or_n, 'MCU')
        UNTIL y_or_n = 'N' OR y_or_n = 'Y' DO
        REPEAT
        IF y_or_n = 'Y' THEN
            CONVERT CR_eq TO '' IN R.ITEM
            GOSUB ITEMHASCHANGED
        END
    END
*
*** Convert Linux items
*
    IF COUNT(R.ITEM, LF_eq) > 0 AND NOT(i_option) THEN
        LOOP
            CRT
            CRT 'Item contains line-feeds.'
            CRT 'Do you want to convert them to @AM? (<N>/Y) :' :
            INPUT y_or_n      ;* FOR 100 ELSE y_or_n = 'N'
            y_or_n = OCONV(y_or_n, 'MCU')
        UNTIL y_or_n = 'N' OR y_or_n = 'Y' DO
        REPEAT
        IF y_or_n = 'Y' THEN
            CONVERT LF_eq TO @AM IN R.ITEM
            GOSUB ITEMHASCHANGED
        END
    END
*
    bottom_line = DCOUNT(R.ITEM, @AM)
    IF LEN(bottom_line) > 3 THEN
        line_number_mask = 'R%' : LEN(bottom_line)
    END ELSE
        line_number_mask = 'R%3'
    END
    IF NOT(z_option) THEN
        CRT 'TOP'
    END
*
    exit_loop = 0
    LOOP
    UNTIL exit_loop DO
        GOSUB WIDTHDEPTH
        IF window_length = 0 THEN
            window_length = output_depth - 3
        END
        IF current_attribute > 0 THEN
            current_line = R.ITEM<current_attribute>
        END ELSE
            current_line = ''
        END
        highlight_info = ''
        eof_flag = 0
        display_flag = 0
        BEGIN CASE
            CASE prestore_commands<1> # ''
                GOSUB RUNPRESTORE
                command_entered = data_value
            CASE from_stack
                NULL
            CASE 1
                GOSUB EDITORSTACK
                IF command_entered = '' THEN CRT @(0) :    ELSE CRT
                bad_prestore = ''       ;* Not from a PRESTORE
        END CASE
        error_message = ''
        IF command_entered[1, 1] = '~' THEN
            show_lines = 0
            command_entered = command_entered[2, 999999]
        END ELSE
            show_lines = 1
        END
        IF command_entered[1, 1] = '?' OR command_entered[1, 2] = '~?' THEN
            IF command_entered # '?' THEN GOSUB COMMANDQ
        END
        uc_command_entered = OCONV(command_entered, 'MCU')
        IF uc_command_entered[1, 2] = 'RU' THEN
            all_occurences = 1
            command_entered = 'R' : command_entered[3, 99999]
            uc_command_entered = OCONV(command_entered, 'MCU')
        END ELSE
            all_occurences = 0
        END
        IF uc_command_entered = 'P' THEN uc_command_entered = 'P0'
        IF uc_command_entered MATCHES "P' '0X" THEN
            uc_command_entered = 'P0 ' : uc_command_entered[3, 9999]
            command_entered = 'P0 ' : command_entered[3, 9999]
        END
*
        uc_command_entered1 = uc_command_entered[1, 1]
        uc_command_entered2 = uc_command_entered[1, 2]
        uc_command_entered3 = uc_command_entered[1, 3]
        uc_command_entered4 = uc_command_entered[1, 4]
        uc_command_entered5 = uc_command_entered[1, 5]
        IF i_option THEN
            not_allowed_in_inquiry = INDEX(non_inquiry_commands, '.' : uc_command_entered : '.', 1)
            not_allowed_in_inquiry += INDEX(non_inquiry_commands1, '.' : uc_command_entered1 : '.', 1)
            not_allowed_in_inquiry += INDEX(non_inquiry_commands2, '.' : uc_command_entered2 : '.', 1)
            not_allowed_in_inquiry += INDEX(non_inquiry_commands3, '.' : uc_command_entered3 : '.', 1)
        END ELSE
            not_allowed_in_inquiry = 0
        END
        BEGIN CASE
            CASE not_allowed_in_inquiry
                CRT
                CRT 'Cannot use "' : command_entered : '" in inquiry mode'
                CRT
            CASE uc_command_entered = 'UNIQ'
                IF bottom_line > 1 THEN
                    LOOP
                        CRT
                        CRT 'This command will eliminate duplicate lines in this item.'
                        CRT 'Do you want to UNIQUE the lines? (<N>/Y) :' :
                        INPUT y_or_n    ;* FOR 100 ELSE y_or_n = 'N'
                        y_or_n = OCONV(y_or_n, 'MCU')
                    UNTIL y_or_n = 'N' OR y_or_n = 'Y' DO
                    REPEAT
                    IF y_or_n = 'Y' THEN
                        uniq_block = R.ITEM
                        uniq_change = 0
                        R.UNIQ = @AM : R.ITEM : @AM
                        FOR line_count = bottom_line TO 1 STEP -1
                            this_line = @AM : R.ITEM<line_count> : @AM
                            IF INDEX(R.UNIQ, this_line, 2) THEN
                                DEL R.ITEM<line_count>
                                R.UNIQ = @AM : R.ITEM : @AM
                                uniq_change = 1
                                bottom_line -= 1
                            END
                        NEXT line_count
                        IF uniq_change THEN
                            oops_block = uniq_block
                            oops_command = 'GA2' : @VM : 'DE99999999' : @VM : 'MVOOPSBLK' : @VM : 'DE'
                            GOSUB UPDATEOOPS
                            GOSUB ITEMHASCHANGED
                        END
                        current_attribute = 1
                        current_line = R.ITEM<current_attribute>
                        display_flag = 1
                    END
                END
            CASE uc_command_entered1 = 'U' OR uc_command_entered1 = '-'
                up_lines = uc_command_entered[2, 99]
                IF up_lines = '' THEN up_lines = 0
                IF NUM(up_lines) THEN
                    IF up_lines = INT(up_lines) THEN
                        new_current_attribute = current_attribute - up_lines
                        IF new_current_attribute >= 0 THEN
                            current_attribute = new_current_attribute
                            IF current_attribute > 0 THEN
                                current_line = R.ITEM<current_attribute>
                                display_flag = 1
                            END
                        END ELSE
                            current_attribute = 0
                        END
                    END ELSE
                        error_message = 'Must be ' : uc_command_entered1 : 'nn with nn being a number of lines'
                    END
                END ELSE
                    error_message = 'Must be ' : uc_command_entered1 : 'nn with nn being a number of lines'
                END
            CASE uc_command_entered1 = '+'
                down_lines = uc_command_entered[2, 99]
                IF down_lines = '' THEN down_lines = 0
                IF NUM(down_lines) THEN
                    IF down_lines = INT(down_lines) THEN
                        new_current_attribute = current_attribute + down_lines
                        IF new_current_attribute <= bottom_line THEN
                            current_attribute = new_current_attribute
                        END ELSE
                            current_attribute = bottom_line
                        END
                        display_flag = 1
                        current_line = R.ITEM<current_attribute>
                    END ELSE
                        error_message = 'Must be +nn with nn being a number of lines'
                    END
                END ELSE
                    error_message = 'Must be +nn with nn being a number of lines'
                END
            CASE NUM(uc_command_entered) AND uc_command_entered # ''
                stacked_commands = 'G' : uc_command_entered
            CASE command_entered = '&&'
                IF disable_double_ampersand = 0 THEN
                    disable_double_ampersand = 1
                    CRT
                    CRT '&& disabled, you can now locate the literal ' : double_ampersand
                    CRT
                END ELSE
                    disable_double_ampersand = 0
                    CRT
                    CRT '&& enabled, ' : double_ampersand : ' will now be treated as AND for locate'
                    CRT
                END
            CASE command_entered[1, 1] = '/'
                stacked_commands = 'L' : bottom_line : '/' : command_entered[2, 999]
            CASE uc_command_entered = 'A'
                IF lookup_command # '' THEN
                    stacked_commands = lookup_command
                END ELSE
                    error_message = 'No prior locate'
                END
            CASE uc_command_entered = 'V'
                GOSUB SHOWVERBOSE
            CASE TRIM(uc_command_entered) = 'C'
                column_start = INDEX(uc_command_entered, 'C', 1)
                IF column_start < LEN(bottom_line) THEN column_start = LEN(bottom_line)
                IF column_start < 3 THEN column_start = 3
                IF s_option AND uc_command_entered = 'C' THEN column_start = 0
                CRT @(column_start) : '0' :
                tens_count = 0
                FOR column_count = column_start TO output_width STEP 10
                    tens_count += 1
                    IF column_count + 10 < output_width THEN
                        CRT tens_count 'R#10' :
                    END
                NEXT column_count
                CRT
                CRT SPACE(column_start) :
                FOR column_count = column_start TO output_width STEP 10
                    FOR ONES = 0 TO 9
                        IF column_count + ONES < output_width THEN
                            CRT ONES :
                        END
                    NEXT ONES
                NEXT column_count
                CRT
                stacked_commands = 'U'
            CASE uc_command_entered = 'LD'
                stacked_commands = 'L' : output_depth - 3
            CASE uc_command_entered = 'N'
                IF last_basic_error THEN
                    basic_err_count += 1
                    IF basic_err_count > last_basic_error THEN
                        basic_err_count = 1
                    END
                    stacked_commands = 'G' : basic_errors<1, basic_err_count>
                    highlight_info<2> = basic_errors<2, basic_err_count>
                    CRT basic_errors<3, basic_err_count>
                END ELSE
                    error_message = 'No BASIC errors to display'
                END
            CASE uc_command_entered = 'J'
                GOSUB JUMPCOMMAND
            CASE uc_command_entered3 = 'CM '
                LOCATE command_entered[4, 999] IN hist_comment<1> SETTING nada ELSE
                    hist_comment<1, -1> = command_entered[4, 999]
                END
            CASE uc_command_entered5 = 'HELP '
                helpword = FIELD(command_entered, ' ', 2)
                lword = DOWNCASE(helpword)
                URL = help_url : lword
                EXECUTE os_shell : 'curl ' : URL : ' 2>&1' CAPTURING good
                IF INDEX(good, lword, 1) THEN
                    CRT ESC_eq : STX_eq : '<' : URL : CR_eq :
                END ELSE
                    CRT
                    CRT 'Help not available for ' : lword
                    CRT
                END
            CASE uc_command_entered4 = 'SYS '
                sys_number = FIELD(command_entered, ' ', 2)
                IF sys_number MATCHES "1N0N" AND sys_number >= 1 AND sys_number <= 1000 THEN
                    CRT
                    CRT 'SYSTEM(' : sys_number : ') = "' : SYSTEM(sys_number) : '"'
                    CRT
                END ELSE
                    CRT
                    CRT 'Must be a number from 1 to 1000'
                    CRT
                END
            CASE uc_command_entered4 = 'GIT '
                BEGIN CASE
                    CASE uc_command_entered = 'GIT ADD'
                END CASE
            CASE uc_command_entered = 'TRIM'
                IF R.ITEM<1>[1, 2] = 'PQ' THEN
                    LOOP
                        CRT
                        CRT 'Trimming lines in a proc can have adverse affects.  A<space> is different than A'
                        CRT 'Do you want to trim the lines? (<N>/Y) :' :
                        INPUT y_or_n    ;* FOR 100 ELSE y_or_n = 'N'
                        y_or_n = OCONV(y_or_n, 'MCU')
                    UNTIL y_or_n = 'N' OR y_or_n = 'Y' DO
                    REPEAT
                END ELSE y_or_n = 'Y'
                IF y_or_n = 'Y' THEN
                    eof_flag = 1
                    FOR trim_count = 1 TO bottom_line
                        current_attribute = trim_count
                        current_line = R.ITEM<current_attribute>
                        current_line = TRIM(current_line, ' ', 'T')
                        GOSUB CHANGEITEM
                        GOSUB DISPLAYLINE
                    NEXT trim_count
                END
            CASE uc_command_entered = 'TRIML'
                IF R.ITEM<1>[1, 2] = 'PQ' THEN
                    LOOP
                        CRT
                        CRT 'Trimming blank lines in a proc can have adverse affects.'
                        CRT 'Do you want to trim the lines? (<N>/Y) :' :
                        INPUT y_or_n    ;* FOR 100 ELSE y_or_n = 'N'
                        y_or_n = OCONV(y_or_n, 'MCU')
                    UNTIL y_or_n = 'N' OR y_or_n = 'Y' DO
                    REPEAT
                END ELSE y_or_n = 'Y'
                IF y_or_n = 'Y' THEN
                    eof_flag = 1
                    FOR trim_count = bottom_line TO 1 STEP -1
                        oops_block = R.ITEM<trim_count>
                        IF TRIM(oops_block, ' ', 'A') = '' THEN
                            oops_command = 'GA' : trim_count-1 : @VM : 'MVOOPSBLK'
                            GOSUB UPDATEOOPS
                            R.ITEM = DELETE(R.ITEM, trim_count, 0, 0)
                            GOSUB ITEMHASCHANGED
                            bottom_line -= 1
                        END
                    NEXT trim_count
                    stacked_commands = 'B'
                END
            CASE uc_command_entered = 'SORT'
                IF bottom_line > 1 THEN
                    LOOP
                        CRT
                        CRT 'This command will sort this item alphabetically.'
                        CRT 'Do you want to SORT the lines? (<N>/Y) :' :
                        INPUT y_or_n    ;* FOR 100 ELSE y_or_n = 'N'
                        y_or_n = OCONV(y_or_n, 'MCU')
                    UNTIL y_or_n = 'N' OR y_or_n = 'Y' DO
                    REPEAT
                    IF y_or_n = 'Y' THEN
                        oops_block = R.ITEM
                        oops_command = 'GA2' : @VM : 'DE99999999' : @VM : 'MVOOPSBLK' : @VM : 'DE'
                        GOSUB UPDATEOOPS
                        unsorted_array = R.ITEM
                        GOSUB SORTARRAY
                        R.ITEM = sorted_array
                        GOSUB ITEMHASCHANGED
                        current_attribute = 1
                        current_line = R.ITEM<current_attribute>
                        display_flag = 1
                    END
                END
            CASE uc_command_entered = 'EXPI'
                GOSUB EXPLODEITEM
                ez_editor_command = uc_command_verb : ' FRED_EDITOR_FILE ' : file_item_id : '.X (IQ'
                CALL FRED.EDITOR(ez_editor_command)
                DELETE F.FRED_EDITOR_FILE, file_item_id : '.X'
                current_line = R.ITEM<current_attribute>
                display_flag = 1
            CASE uc_command_entered1 = '!'
                CRT
                IF mv_type = 'UV' OR mv_type = 'SD' THEN
                    ShellCmd = '"' : command_entered[2, 9999] : '"'
                END ELSE
                    ShellCmd = command_entered[2, 9999]
                END
                IF LEN(ShellCmd) THEN
                    EXECUTE os_shell : ShellCmd
                END ELSE
                    EXECUTE os_shell : 'sh'
                END
                CRT
                current_line = R.ITEM<current_attribute>
                display_flag = 1
            CASE uc_command_entered = 'JS'
                jshowCmd = 'jshow -c ' : file_item_id
                CRT jshowCmd : '...'
                EXECUTE jshowCmd
            CASE uc_command_entered = 'DC'
                CRT 'DECATALOG...'
                DECATALOGverb = 'DECATALOG ' : catalog_options : ' ' : dict_or_data : ' ' : file_name : ' ' : file_item_id
                IF LEN(catalog_options) THEN
                    CRT DECATALOGverb
                END
                EXECUTE DECATALOGverb
            CASE uc_command_entered = 'C2C'
                CRT 'Press Enter to see the differences for this item from what'
                CRT 'it was when last CATALOGed'
                INPUT PressEnter
                IF PressEnter = 'C' THEN PRINT @(-1) :
                EXECUTE 'COMP2CAT ' : file_name : ' ' : file_item_id
            CASE uc_command_entered = 'SET'
                GOSUB SETPARAMETERS
            CASE uc_command_entered = 'DIFF' AND version_flag
                IF NOT(LEN(fred_editor_file_path)) THEN
                    error_message = 'Could not determine path of FRED_EDITOR_FILE'
                END ELSE
                    change_version_id = dict_or_data : '_' : file_name : '_' : file_item_id
                    change_version = 0
                    unsorted_array = ''
                    LOOP
                        change_version += 1
                        last_change_version_id = change_version_id : '_' : change_version
                        READV version_date_time FROM F.FRED_EDITOR_FILE_VERSIONS, last_change_version_id, 1 THEN
                            unsorted_array<-1> = version_date_time : ' [' : change_version : ']'
                        END ELSE
                            EXIT
                        END
                    REPEAT
                    GOSUB SORTARRAY
                    display_items_list = sorted_array
                    last_display_id = DCOUNT(sorted_array, @AM)
                    BEGIN CASE
                        CASE last_display_id = 0
                            errmsg = 'No previous versions exist'
                            diff_item_id = ''
                        CASE last_display_id = 1
                            diff_item_id = display_items_list<1>
                        CASE 1
                            display_list_conv = 'G1 99'
                            GOSUB PICKFROMLIST
                            diff_item_id = item_picked
                    END CASE
                    CRT
                    IF LEN(diff_item_id) THEN
                        diff_version = FIELD(diff_item_id, '[', 2)
                        diff_version = FIELD(diff_version, ']', 1)
                        READ R.DIFF FROM F.FRED_EDITOR_FILE_VERSIONS, change_version_id : '_' : diff_version THEN
                            diff_version_id = DATE() : '_' : TIME() : '_' : my_port_number : '_diff'
                            current_version_id = DATE() : '_' : TIME() : '_' : my_port_number : '_current'
                            WRITE R.DIFF ON F.FRED_EDITOR_FILE, diff_version_id
                            WRITE R.ITEM ON F.FRED_EDITOR_FILE, current_version_id
                            diff_command = 'diff ' : fred_editor_file_path : os_slash : diff_version_id
                            diff_command := ' ' : fred_editor_file_path : os_slash : current_version_id
                            EXECUTE os_shell : diff_command
                            DELETE F.FRED_EDITOR_FILE, diff_version_id
                            DELETE F.FRED_EDITOR_FILE, current_version_id
                        END
                    END
                END
            CASE uc_command_entered3 = 'OCT'
                octal_value = OCONV(uc_command_entered, 'G1 999')
                decimal_value = 0
                octal_power = -1
                FOR octal_place = LEN(octal_value) TO 1 STEP -1 UNTIL LEN(error_message)
                    octal_power += 1
                    octal_digit = octal_value[octal_place, 1]
                    IF NOT(NUM(octal_digit)) THEN
                        error_message = 'invalid value'
                    END ELSE
                        decimal_value += octal_digit * (8 ^ octal_power)
                    END
                NEXT octal_place
                IF NOT(LEN(error_message)) THEN
                    CRT 'octal ' : octal_value : ' = decimal ' : decimal_value :
                    IF decimal_value >= 32 AND decimal_value <= 126 THEN
                        CRT ' = character ' : CHAR(decimal_value)
                    END ELSE
                        CRT
                    END
                END
            CASE uc_command_entered3 = 'HEX'
                hexadecimal_value = OCONV(uc_command_entered, 'G1 999')
                decimal_value = 0
                hexadecimal_power = -1
                FOR hexadecimal_place = LEN(hexadecimal_value) TO 1 STEP -1 UNTIL LEN(error_message)
                    hexadecimal_power += 1
                    hexadecimal_digit = hexadecimal_value[hexadecimal_place, 1]
                    IF ALPHA(hexadecimal_digit) THEN
                        hexadecimal_digit = OCONV(hexadecimal_digit, 'MCU')
                        a_to_f = '.........ABCDEF'
                        hexadecimal_digit = INDEX(a_to_f, hexadecimal_digit, 1)
                        IF hexadecimal_digit = 0 THEN
                            error_message = 'invalid value'
                        END
                    END
                    IF NOT(NUM(hexadecimal_digit)) THEN
                        error_message = 'invalid value'
                    END
                    IF NOT(error_message) THEN
                        decimal_value += hexadecimal_digit * (16 ^ hexadecimal_power)
                    END
                NEXT hexadecimal_place
                IF NOT(LEN(error_message)) THEN
                    CRT 'hexadecimal ' : hexadecimal_value : ' = decimal ' : decimal_value :
                    IF decimal_value >= 32 AND decimal_value <= 126 THEN
                        CRT ' = character ' : CHAR(decimal_value)
                    END ELSE
                        CRT
                    END
                END
            CASE uc_command_entered3 = 'FMT'
                GOSUB FORMATITEM
            CASE uc_command_entered = 'NA'
                IF last_basic_error THEN
                    CRT '#   Line Offset  Error'
                    FOR BEC = 1 TO last_basic_error
                        CRT BEC 'R%2' : ' ' : basic_errors<1, BEC> 'R#5' : ' ' : basic_errors<2, BEC> 'R#6' : ' ' : basic_errors<3, BEC>
                    NEXT BEC
                END ELSE
                    error_message = 'No BASIC errors to display'
                END
            CASE uc_command_entered = 'NR'
                IF last_basic_output THEN
                    CRT STR('=', output_width)
                    FOR basic_output_count = 1 TO last_basic_output
                        CRT basic_output<basic_output_count>
                    NEXT basic_output_count
                    CRT STR('-', output_width)
                END ELSE
                    CRT
                    CRT 'No BASIC performed on this item'
                    CRT
                END
            CASE uc_command_entered = 'FRED'
                GOSUB EDITAGAIN
            CASE uc_command_entered2 = 'BL' AND uc_command_entered3 # 'BLK'
                IF uc_command_entered3 = 'BLB' THEN
                    command_entered = 'BL' : command_entered[4, 9999]
                    block_before = 1
                END ELSE
                    block_before = 0
                END
                command_parameter = command_entered[3, 99999]
                command_delimiter = command_parameter[1, 1]
                IF COUNT(command_parameter, command_delimiter) = 1 THEN
                    command_parameter = command_parameter : command_delimiter
                END
                IF COUNT(command_parameter, command_delimiter) = 2 THEN
                    this_expression = FIELD(command_parameter, command_delimiter, 2)
                    BEGIN CASE
                        CASE enhanced_char_display = 4
                            last_hex = LEN(this_expression) / 2
                            IF last_hex # INT(last_hex) THEN
                                error_message = 'Must specify complete HEX string for BL'
                            END
                            all_hex_expression = ''
                            FOR hex_count = 1 TO last_hex
                                hex_sequence = OCONV(this_expression[(hex_count-1) * 2 + 1, 2], 'MCD')
                                all_hex_expression := all_hex_expression : CHAR(hex_sequence)
                            NEXT hex_count
                            this_expression = all_hex_expression
                        CASE enhanced_char_display = 3
                            IF this_expression[1, 1] = '~' AND this_expression[LEN(this_expression), 1] = '~' THEN
                                hex_expression = this_expression[2, LEN(this_expression) - 2]
                                expression_character = XTD(hex_expression)
                                IF expression_character >= 0 AND expression_character <= 254 THEN
                                    IF expression_character = INT(expression_character) THEN
                                        this_expression = CHAR(expression_character)
                                    END
                                END
                            END
                    END CASE
                    IF this_expression = '' THEN
                        error_message = 'Expression not found for BL'
                    END
                    IF NOT(LEN(error_message)) THEN
                        current_line = R.ITEM<current_attribute>
                        breakline_expression_index = INDEX(current_line, this_expression, 1) - (block_before * LEN(this_expression))
                        IF this_expression = '' THEN breakline_expression_index = 1
                        IF breakline_expression_index THEN
                            current_line = current_line[1, breakline_expression_index + LEN(this_expression) - 1] : @AM : current_line[breakline_expression_index + LEN(this_expression), 999999]
                            R.ITEM<current_attribute> = current_line
                            current_attribute = current_attribute + 1
                            bottom_line = bottom_line + 1
                            IF LEN(bottom_line) > 3 THEN
                                line_number_mask = 'R%' : LEN(bottom_line)
                            END ELSE
                                line_number_mask = 'R%3'
                            END
                            oops_block = ''
                            oops_command = 'G' : current_attribute-1 : @VM : 'CATN'
                            GOSUB UPDATEOOPS
                            GOSUB ITEMHASCHANGED
                            current_attribute = current_attribute - 1
                            current_line = R.ITEM<current_attribute>
                            GOSUB DISPLAYLINE
                            current_attribute = current_attribute + 1
                            current_line = R.ITEM<current_attribute>
                            GOSUB DISPLAYLINE
                        END
                        IF current_attribute = bottom_line AND NOT(z_option) THEN
                            CRT 'EOF'
                        END
                    END
                END ELSE
                    error_message = 'Invalid BL (Break-line) command'
                END
            CASE uc_command_entered = 'S'
                IF s_option THEN
                    s_option = 0
                END ELSE
                    s_option = 1
                END
            CASE uc_command_entered = 'H'
                GOSUB USERHELP
            CASE uc_command_entered = 'HA'
                GOSUB HELP.ALTER
            CASE uc_command_entered = 'HL'
                GOSUB HELP.LIST
            CASE uc_command_entered = 'HM'
                GOSUB HELP.MOVEMENT
            CASE uc_command_entered = 'HB'
                GOSUB HELP.BLOCK
            CASE uc_command_entered = 'HP'
                GOSUB HELP.PRESTORE
            CASE uc_command_entered = 'HF'
                GOSUB HELP.FILE
            CASE uc_command_entered = 'HO'
                GOSUB HELP.OTHER
            CASE uc_command_entered = 'PC'
                PRINTER CLOSE
                PCNT = 0
            CASE uc_command_entered2 = 'AL' OR uc_command_entered2 = 'AP'
                command_parameter = command_entered[3, 99999]
                IF command_parameter[1, 1] = '*' THEN
                    command_parameter = bottom_line : command_parameter[2, 99999]
                    command_entered = command_entered[1, 2] : command_parameter
                    uc_command_entered = OCONV(command_entered, 'MCU')
                END
                number_param = ''; last_number = 1
                LOOP
                UNTIL NOT(NUM(command_parameter[last_number, 1])) OR command_parameter[last_number, 1] = '' DO
                    number_param = number_param : command_parameter[last_number, 1]
                    last_number = last_number + 1
                REPEAT
                IF number_param = '' THEN
                    number_param = 1
                END
                temporary_variable = command_parameter[last_number + 1, 99999]
                temporary_variable = temporary_variable<1>  ;* Handle @AM in replacement
                eof_flag = 1
                from_line = current_attribute
                to_line = current_attribute + number_param - 1
                IF to_line > bottom_line THEN to_line = bottom_line
                FOR line_count = from_line TO to_line
                    current_attribute = line_count
                    current_line = R.ITEM<current_attribute>
                    current_line = current_line : temporary_variable
                    GOSUB CHANGEITEM
                    GOSUB DISPLAYLINE
                NEXT line_count
            CASE uc_command_entered3 = 'CVO'
                command_parameter = command_entered[4, 99999]
                IF command_parameter[1, 1] = '*' THEN
                    command_parameter = bottom_line : command_parameter[2, 99999]
                    command_entered = command_entered[1, 3] : command_parameter
                    uc_command_entered = OCONV(command_entered, 'MCU')
                END
                number_param = ''; last_number = 1
                LOOP
                UNTIL NOT(NUM(command_parameter[last_number, 1])) OR command_parameter[last_number, 1] = '' DO
                    number_param = number_param : command_parameter[last_number, 1]
                    last_number = last_number + 1
                REPEAT
                IF number_param = '' THEN
                    number_param = 1
                END
                temporary_variable = command_parameter[last_number + 1, 99999]
                IF temporary_variable = '' THEN
                    CRT 'Conversion : ' :
                    IF prestore_commands<1> # '' THEN
                        GOSUB RUNPRESTORE
                        temporary_variable = data_value
                    END ELSE
                        INPUT temporary_variable
                        bad_prestore = ''
                    END
                END
                IF temporary_variable = '' THEN
                    error_message = 'No conversion entered'
                    current_line = R.ITEM<current_attribute>
                    display_flag = 1
                END ELSE
                    eof_flag = 1
                    from_line = current_attribute
                    to_line = current_attribute + number_param - 1
                    IF to_line > bottom_line THEN to_line = bottom_line
                    FOR line_count = from_line TO to_line
                        current_attribute = line_count
                        current_line = R.ITEM<current_attribute>
                        current_line = OCONV(current_line, temporary_variable)
                        GOSUB CHANGEITEM
                        GOSUB DISPLAYLINE
                    NEXT line_count
                END
            CASE uc_command_entered3 = 'CVI'
                command_parameter = command_entered[4, 99999]
                IF command_parameter[1, 1] = '*' THEN
                    command_parameter = bottom_line : command_parameter[2, 99999]
                    command_entered = command_entered[1, 3] : command_parameter
                    uc_command_entered = OCONV(command_entered, 'MCU')
                END
                number_param = ''; last_number = 1
                LOOP
                UNTIL NOT(NUM(command_parameter[last_number, 1])) OR command_parameter[last_number, 1] = '' DO
                    number_param = number_param : command_parameter[last_number, 1]
                    last_number = last_number + 1
                REPEAT
                IF number_param = '' THEN
                    number_param = 1
                END
                temporary_variable = command_parameter[last_number + 1, 99999]
                IF temporary_variable = '' THEN
                    CRT 'Conversion : ' :
                    IF prestore_commands<1> # '' THEN
                        GOSUB RUNPRESTORE
                        temporary_variable = data_value
                    END ELSE
                        INPUT temporary_variable
                        bad_prestore = ''
                    END
                END
                IF temporary_variable = '' THEN
                    error_message = 'No conversion entered'
                    current_line = R.ITEM<current_attribute>
                    display_flag = 1
                END ELSE
                    eof_flag = 1
                    from_line = current_attribute
                    to_line = current_attribute + number_param - 1
                    IF to_line > bottom_line THEN to_line = bottom_line
                    FOR line_count = from_line TO to_line
                        current_attribute = line_count
                        current_line = R.ITEM<current_attribute>
                        current_line = ICONV(current_line, temporary_variable)
                        GOSUB CHANGEITEM
                        GOSUB DISPLAYLINE
                    NEXT line_count
                END
            CASE uc_command_entered3 = 'CVP'
                IF os_type # 'L' THEN
                    error_message = 'CVP command only available on Linux'
                END ELSE
                    command_parameter = command_entered[4, 99999]
                    IF command_parameter[1, 1] = '*' THEN
                        command_parameter = bottom_line : command_parameter[2, 99999]
                        command_entered = command_entered[1, 3] : command_parameter
                        uc_command_entered = OCONV(command_entered, 'MCU')
                    END
                    number_param = ''; last_number = 1
                    LOOP
                    UNTIL NOT(NUM(command_parameter[last_number, 1])) OR command_parameter[last_number, 1] = '' DO
                        number_param = number_param : command_parameter[last_number, 1]
                        last_number = last_number + 1
                    REPEAT
                    IF number_param = '' THEN
                        number_param = 1
                    END
                    temporary_variable = command_parameter[last_number + 1, 99999]
                    LOOP
                        IF temporary_variable = '' THEN
                            CRT 'Linux command : ' :
                            IF prestore_commands<1> # '' THEN
                                GOSUB RUNPRESTORE
                                temporary_variable = data_value
                            END ELSE
                                INPUT temporary_variable
                                bad_prestore = ''
                            END
                            IF temporary_variable = '' THEN
                                EXIT
                            END
                            IF temporary_variable = '?' THEN
                                CRT
                                CRT "tr -s ' '           --- Trim extra spaces"
                                CRT "tr -d ' '           --- Delete all spaces"
                                CRT "cut -d' ' -f2-999   --- Remove first field of space delimited line"
                                CRT "grep ABC            --- Keep only lines containing ABC"
                                CRT "sed 's/AB./XYZ/g'   --- Replace AB? with XYZ where ? is any character"
                                CRT
                                temporary_variable = ''
                            END
                        END ELSE
                            EXIT
                        END
                    REPEAT
                    IF temporary_variable = '' THEN
                        error_message = 'No command entered'
                        current_line = R.ITEM<current_attribute>
                        display_flag = 1
                    END ELSE
                        eof_flag = 1
                        from_line = current_attribute
                        IF from_line < 1 THEN from_line = 1
                        to_line = current_attribute + number_param - 1
                        IF to_line > bottom_line THEN to_line = bottom_line
                        FOR line_count = from_line TO to_line
                            current_attribute = line_count
                            current_line = R.ITEM<current_attribute>
                            E.LINE = ''
                            LastE = LEN(current_line)
                            FOR ECount = 1 TO LastE
                                E.LINE := '\' : current_line[ECount, 1]
                            NEXT ECount
                            error_code = 0
                            EXECUTE os_shell : 'echo ' : E.LINE : ' | ' : temporary_variable CAPTURING current_line RETURNING error_code
                            IF INDEX(temporary_variable,'grep ',1) AND error_code<1,1> = 1 THEN
                                error_code = 0
                            END
                            error_code = error_code<1, 1>
                            IF error_code # "0" THEN
                                CRT 'Error executing Linux command "' : error_code : '"'
                                CRT 'line ' : line_count : ' NOT changed to this'
                                CRT current_line
                                CRT
                                EXIT
                            END
                            GOSUB CHANGEITEM
                            GOSUB DISPLAYLINE
                        NEXT line_count
                    END
                END
            CASE uc_command_entered = 'PTR'
                IF SYSTEM(1) THEN
                    CRT 'PRINTER OFF'
                    PRINTER OFF
                END ELSE
                    CRT 'PRINTER ON'
                    PRINTER ON
                END
            CASE uc_command_entered = 'CV' OR uc_command_entered3 = 'CV '
                command_parameter = command_entered[4, 9999]
                IF command_parameter = '' THEN
                    CRT 'Conversion : ' :
                    IF prestore_commands<1> # '' THEN
                        GOSUB RUNPRESTORE
                        conversion_code = data_value
                    END ELSE
                        INPUT conversion_code
                        bad_prestore = ''
                    END
                END ELSE
                    conversion_code = command_parameter
                END
                IF conversion_code = '' THEN
                    error_message = 'No conversion entered'
                END ELSE
                    CRT 'OCONV = <' : OCONV(current_line, conversion_code) : '>'
                    CRT 'ICONV = <' : ICONV(current_line, conversion_code) : '>'
                END
            CASE uc_command_entered = 'SUM'
                line_summation = 0
                last_sum_value = DCOUNT(current_line, @VM)
                FOR sum_count = 1 TO last_sum_value
                    IF NUM(current_line<1, sum_count>) THEN
                        line_summation += current_line<1, sum_count>
                    END
                NEXT sum_count
                CRT 'SUM = ' : line_summation
            CASE uc_command_entered = 'EC' OR uc_command_entered = 'EC0' OR uc_command_entered = 'EC1' OR uc_command_entered = 'EC2' OR uc_command_entered = 'EC3' OR uc_command_entered = 'EC4'
                command_parameter = uc_command_entered[3, 1]
                IF command_parameter = '' THEN
                    CRT 'Extended character level : ' :
                    IF prestore_commands<1> # '' THEN
                        GOSUB RUNPRESTORE
                        enhanced_char_level = data_value
                    END ELSE
                        INPUT enhanced_char_level
                        bad_prestore = ''
                    END
                END ELSE
                    enhanced_char_level = command_parameter
                END
                IF enhanced_char_level = 0 OR enhanced_char_level = 1 OR enhanced_char_level = 2 OR enhanced_char_level = 3 OR enhanced_char_level = 4 THEN
                    enhanced_char_display = enhanced_char_level
                END ELSE
                    error_message = 'EC Level is a number from 0 to 4 (See HL)'
                END
            CASE uc_command_entered MATCHES "'EV'0N" OR uc_command_entered = 'EV'
                command_parameter = uc_command_entered[3, 999]
                BEGIN CASE
                    CASE command_parameter > 0 AND command_parameter MATCHES '0N' AND command_parameter <= bottom_line
                        current_attribute = command_parameter
                        current_line = R.ITEM<current_attribute>
                    CASE command_parameter = ''
                        NULL  ;* Use current line
                    CASE 1
                        error_message = 'Must be EV for current line or EVnn for line nn'
                END CASE
                IF error_message = '' THEN
                    CONVERT @VM TO @AM IN current_line
                    CONVERT @SM TO @VM IN current_line
                    ev_temp_id = RND(100) : '.' : DATE() : '.' : TIME() : '.' : RND(100)
                    IF file_item_id[1, 4] # '~EV~' THEN
                        ev_temp_id = '~EV~' : dict_or_data : '~' : file_name : '~' : file_item_id : '~' : current_attribute : '~0~' : ev_temp_id
                    END ELSE
                        ev_temp_id = OCONV(file_item_id, 'G0~6') : '~' : current_attribute
                    END
                    WRITE current_line ON F.FRED_EDITOR_FILE, ev_temp_id
                    passed_command_line = uc_command_verb : ' FRED_EDITOR_FILE ' : ev_temp_id : ' (ZQ'
                    IF i_option THEN
                        passed_command_line = passed_command_line : 'I'
                    END
                    CALL FRED.EDITOR(passed_command_line)
                    IF NOT(i_option) THEN
                        READ current_line FROM F.FRED_EDITOR_FILE, ev_temp_id ELSE current_line = ''
                        CONVERT @VM TO @SM IN current_line
                        CONVERT @AM TO @VM IN current_line
                        GOSUB CHANGEITEM
                    END
                    DELETE F.FRED_EDITOR_FILE, ev_temp_id
                    display_flag = 1
                END
            CASE uc_command_entered4 = 'TCL '
                tcl_command = command_entered[5, 999]
                CRT
                EXECUTE tcl_command
                CRT
                CRT 'Press <Enter> to continue' :
                INPUT wait_here
                CRT
                display_flag = 1
            CASE uc_command_entered = 'TCL'
                EXECUTE 'FRED.TCL.STACK ' : user_name
            CASE uc_command_entered = 'CX'
                current_line = ''
                GOSUB CHANGEITEM
                display_flag = 1
            CASE uc_command_entered = 'UC'
                current_line = OCONV(current_line, 'MCU')
                GOSUB CHANGEITEM
                display_flag = 1
            CASE uc_command_entered = 'CAT' OR uc_command_entered = 'CATN'
                IF current_attribute + 1 > bottom_line THEN
                    error_message = 'Cannot concatenate.  You are on the last line.'
                END ELSE
                    oops_block = R.ITEM<current_attribute> : @AM : R.ITEM<current_attribute + 1>
                    oops_command = 'GA' : current_attribute : @VM : 'MVOOPSBLK' : @VM : 'DE'
                    GOSUB UPDATEOOPS
                    IF uc_command_entered = 'CATN' THEN SPC = '' ELSE SPC = ' '
                    R.ITEM<current_attribute> = R.ITEM<current_attribute> : SPC : TRIM(R.ITEM<current_attribute + 1>, ' ', 'L')
                    R.ITEM = DELETE(R.ITEM, current_attribute + 1, 0, 0)
                    GOSUB ITEMHASCHANGED
                    bottom_line = bottom_line - 1
                    IF LEN(bottom_line) > 3 THEN
                        line_number_mask = 'R%' : LEN(bottom_line)
                    END ELSE
                        line_number_mask = 'R%3'
                    END
                    current_line = R.ITEM<current_attribute>
                    display_flag = 1
                END
            CASE uc_command_entered = 'PEEK'
                CRT 'Filename : ' :
                IF prestore_commands<1> # '' THEN
                    GOSUB RUNPRESTORE
                    peek_file = data_value
                END ELSE
                    INPUT peek_file :
                    IF peek_file = '' THEN
                        CRT file_name
                    END ELSE
                        CRT
                    END
                    bad_prestore = ''
                END
                peek_file = TRIM(peek_file)
                IF peek_file[1, 5] = 'DICT ' THEN
                    peek_dict = 'DICT'
                    peek_file = FIELD(peek_file, ' ', 2)
                END ELSE
                    peek_dict = ''
                END
                IF peek_file = '' THEN
                    peek_file = file_name
                    peek_dict = dict_or_data
                END
                OPEN peek_dict, peek_file TO F.PFILE THEN
                    CRT 'Itemname : ' :
                    IF prestore_commands<1> # '' THEN
                        GOSUB RUNPRESTORE
                        peek_id = data_value
                    END ELSE
                        INPUT peek_id
                        bad_prestore = ''
                    END
                    IF peek_id = '*' OR peek_id = '?' THEN
                        GOSUB WIDTHDEPTH
                        peek_select_list = ''     ;* Unidata needs this
                        SELECT F.PFILE TO peek_select_list
                        display_items_list = ''
                        last_display_id = 0
                        LOOP
                            READNEXT peek_id FROM peek_select_list ELSE EXIT
                            last_display_id += 1
                            IF last_display_id > max_display_items THEN
                                CRT
                                CRT '* will not show all items in file.   Press <Enter> to continue'
                                CRT
                                INPUT wait_here
                                EXIT
                            END ELSE
                                display_items_list<last_display_id> = peek_id
                            END
                        REPEAT
                        last_display_id = DCOUNT(display_items_list, @AM)
                        unsorted_array = display_items_list
                        GOSUB SORTARRAY
                        display_items_list = sorted_array
                        BEGIN CASE
                            CASE last_display_id = 0
                                error_message = '[PEEK] No items in ' : TRIM(peek_dict : ' ' : peek_file)
                            CASE last_display_id = 1
                                peek_id = display_items_list<1>
                            CASE 1
                                display_list_conv = ''
                                GOSUB PICKFROMLIST
                                peek_id = item_picked
                        END CASE
                        CRT
                    END
                    IF peek_id # '' THEN
                        READ peek_exists FROM F.PFILE, peek_id THEN
                            passed_command_line = uc_command_verb : ' ' : TRIM(peek_dict : ' ' : peek_file : ' ' : peek_id) : ' (IQ'
                            CALL FRED.EDITOR(passed_command_line)
                        END ELSE
                            IF peek_id = '?' OR peek_id = '*' THEN
                                NULL    ;* Already gave error
                            END ELSE
                                error_message = '[PEEK] Item ' : TRIM(peek_dict : ' ' : peek_file) : ' "' : peek_id : '" does not exist'
                            END
                        END
                    END
                END ELSE
                    error_message = '[PEEK] Cannot open ' : peek_file
                END
                display_flag = 1
            CASE uc_command_entered = 'TIME'
                CRT TIMEDATE()
                display_flag = 1
            CASE uc_command_entered = 'WHO'
                CRT OCONV('', 'U50BB')
                display_flag = 1
            CASE uc_command_entered = 'GB'
                IF block_begin_attribute THEN
                    stacked_commands = 'G' : block_begin_attribute
                END ELSE
                    error_message = 'No BKB set'
                END
            CASE uc_command_entered1 = 'G'
                IF uc_command_entered2 = 'GA' THEN
                    command_parameter = uc_command_entered[3, 99]
                    last_go_line = highest_atb_allowed
                END ELSE
                    command_parameter = uc_command_entered[2, 99]
                    last_go_line = bottom_line
                END
                IF NUM(command_parameter) THEN
                    IF command_parameter >= 0 AND command_parameter <= last_go_line AND command_parameter = INT(command_parameter) THEN
                        current_attribute = command_parameter
                        IF current_attribute > bottom_line THEN
                            bottom_line = current_attribute
                            IF LEN(bottom_line) > 3 THEN
                                line_number_mask = 'R%' : LEN(bottom_line)
                            END ELSE
                                line_number_mask = 'R%3'
                            END
                        END
                        IF current_attribute # 0 THEN
                            current_line = R.ITEM<current_attribute>
                            display_flag = 1
                        END
                    END ELSE
                        error_message = 'Go command is Gnn with nn being the line number'
                    END
                END
            CASE command_entered = ''
                current_attribute = current_attribute + 1
                IF current_attribute > bottom_line THEN
                    current_attribute = 1
                    IF show_lines THEN PRINT BELL_eq : 'TOP'
                END
                current_line = R.ITEM<current_attribute>
                display_flag = 1
            CASE uc_command_entered = 'T'
                current_attribute = 0
                CRT 'TOP'
            CASE uc_command_entered = 'B'
                current_attribute = bottom_line
                current_line = R.ITEM<current_attribute>
                display_flag = 1
            CASE uc_command_entered = 'EXP'
                trim_current_line = TRIM(R.ITEM<current_attribute>)
                explode_dict = ''
                explode_file = FIELD(trim_current_line, ' ', 2)
                explode_id = FIELD(trim_current_line, ' ', 3)
                IF explode_file = 'DICT' THEN
                    explode_dict = 'DICT'
                    explode_file = explode_id
                    explode_id = FIELD(trim_current_line, ' ', 4)
                END
                IF explode_id = '' THEN
                    explode_id = explode_file
                    explode_dict = dict_or_data
                    explode_file = file_name
                END
                OPEN explode_dict, explode_file TO F.EXP THEN
                    READ R.EXP FROM F.EXP, explode_id THEN
                        CONVERT @AM TO BS_eq IN R.EXP
                        R.EXP = R.EXP : BS_eq : '!!!end include'
                        R.ITEM<current_attribute> = '!' : R.ITEM<current_attribute> : BS_eq : R.EXP
                        CONVERT BS_eq TO @AM IN R.ITEM
                        OLD.BTM = bottom_line
                        bottom_line = DCOUNT(R.ITEM, @AM)
                        ADDED.LINES = bottom_line - OLD.BTM
                        GOSUB ITEMHASCHANGED
                        oops_block = ''
                        oops_command = 'G' : current_attribute : @VM : 'R/!//' : @VM : 'G' : current_attribute + 1 : @VM : 'DE' : ADDED.LINES
                        GOSUB UPDATEOOPS
                        GOSUB ITEMHASCHANGED
                    END ELSE
                        CRT 'Cannot read include from ' : explode_dict : ' ' : explode_file
                        CRT 'Perhaps you want to use EXPI to Inquire on entire item exploded'
                    END
                END ELSE
                    CRT 'Cannot OPEN ' : explode_dict : ' ' : explode_file : ' for include'
                    CRT 'Perhaps you want to use EXPI to Inquire on entire item exploded'
                END
            CASE uc_command_entered = 'EX' OR uc_command_entered = 'EXK'
                IF uc_command_entered = 'EXK' THEN command_line = 'EXK'         ;* ???
                IF item_has_changed THEN
                    y_or_n = ''
                    LOOP
                    UNTIL y_or_n = 'Y' OR y_or_n = 'N' DO
                        CRT 'Changes made.  Sure you want to exit? (Y/N) : ' :
                        IF prestore_commands<1> # '' THEN
                            GOSUB RUNPRESTORE
                            y_or_n = data_value
                            y_or_n = OCONV(y_or_n, 'MCU')
                            IF y_or_n # 'Y' AND y_or_n # 'N' THEN
                                GOSUB KILL.PRESTORE
                            END
                        END ELSE
                            INPUT y_or_n
                            y_or_n = OCONV(y_or_n, 'MCU')
                            bad_prestore = ''
                        END
                    REPEAT
                END ELSE
                    y_or_n = 'Y'
                END
                IF y_or_n = 'Y' THEN
                    DELETE F.FRED_EDITOR_FILE, 'changed__' : my_port_number
                    IF uc_command_entered[3, 1] = 'K' THEN
                        exit_from_list = 1
                    END
                    IF NOT(z_option) THEN
                        CRT dict_or_data : ' ' : file_name : ' ' : file_item_id : ' exited'
                    END
                    exit_loop = 1
                END
            CASE uc_command_entered = 'NC'
                this_case_index = INDEX(current_line, 'CASE', 1)
                IF this_case_index = 0 THEN
                    command_entered = 'L/CASE/B'
                    return_only_numbers = 1
                    GOSUB LOCATETEXT
                    IF locate_line_numbers THEN
                        this_case_index = INDEX(R.ITEM<locate_line_numbers>, 'CASE', 1)
                    END
                END
                stacked_commands = 'L/CASE/' : this_case_index : '-' : this_case_index + 3
            CASE uc_command_entered = 'I' OR uc_command_entered = 'IEX'
                IF uc_command_entered = 'IEX' THEN b_option = 1
                LOOP
                    line_number_mask = 'R%3'
                    IF LEN(current_attribute + 1) > 3 THEN
                        line_number_mask = 'R%' : LEN(current_attribute + 1)
                    END
                    IF LEN(bottom_line) > 3 THEN
                        line_number_mask = 'R%' : LEN(bottom_line)
                    END
                    IF show_lines THEN
                        PRINT (current_attribute + 1) line_number_mask : '+' :
                    END
                    IF prestore_commands<1> # '' THEN
                        GOSUB RUNPRESTORE
                        new_line = data_value
                    END ELSE
                        INPUT new_line
                        bad_prestore = ''
                    END
                    IF NOT(b_option) THEN
* Allow paste of blank lines
                        IF SYSTEM(14) THEN
                            b_option = 2
                        END ELSE
                            SLEEP input_sleep_secs
                            IF SYSTEM(14) THEN
                                b_option = 2
                            END
                        END
                    END
                    IF (new_line = '' AND NOT(b_option)) OR (OCONV(new_line, 'MCU') = 'EX' AND b_option) THEN
                        EXIT
                    END ELSE
                        NEW.ATB = current_attribute + 1
                        R.ITEM = INSERT(R.ITEM, NEW.ATB, 0, 0, new_line)
                        IF treat_grave_as_null = 'Y' AND new_line = '`' THEN R.ITEM<NEW.ATB> = ''
                        IF DCOUNT(new_line, @AM) > 1 THEN
                            bottom_line = bottom_line + DCOUNT(new_line, @AM) - 1
                        END
                        oops_block = ''
                        oops_command = 'GA' : current_attribute + 1 : @VM : 'DE' : DCOUNT(new_line, @AM)
                        GOSUB UPDATEOOPS
                        GOSUB ITEMHASCHANGED
                        current_attribute = current_attribute + COUNT(new_line, @AM) + 1
                        bottom_line = bottom_line + COUNT(new_line, @AM) + 1
                        IF LEN(bottom_line) > 3 THEN
                            line_number_mask = 'R%' : LEN(bottom_line)
                        END ELSE
                            line_number_mask = 'R%3'
                        END
                    END
                    IF b_option = 2 THEN b_option = 0
                REPEAT
                IF uc_command_entered = 'IEX' THEN b_option = 0
            CASE uc_command_entered2 = 'I '
                new_line = command_entered[3, 999999]
                NEW.ATB = current_attribute + 1
                R.ITEM = INSERT(R.ITEM, NEW.ATB, 0, 0, new_line)
                IF treat_grave_as_null = 'Y' AND new_line = '`' THEN R.ITEM<NEW.ATB> = ''
                current_attribute = current_attribute + DCOUNT(new_line, @AM)
                bottom_line = bottom_line + DCOUNT(new_line, @AM)
                IF LEN(bottom_line) > 3 THEN
                    line_number_mask = 'R%' : LEN(bottom_line)
                END ELSE
                    line_number_mask = 'R%3'
                END
                oops_block = ''
                oops_command = 'GA' : current_attribute : @VM : 'DE'
                GOSUB UPDATEOOPS
                GOSUB ITEMHASCHANGED
                current_line = R.ITEM<current_attribute>
                display_flag = 1
            CASE uc_command_entered = 'R'
                IF current_attribute = 0 THEN current_attribute = 1
                PRINT current_attribute line_number_mask : '>' :
                IF prestore_commands<1> # '' THEN
                    GOSUB RUNPRESTORE
                    new_line = data_value
                END ELSE
                    INPUT new_line
                    bad_prestore = ''
                END
                IF new_line # '' THEN
                    oops_block = new_line
                    oops_command = 'GA' : current_attribute : @VM : 'MVOOPSBLK' : @VM : 'DE'
                    GOSUB UPDATEOOPS
                    R.ITEM<current_attribute> = new_line
                    GOSUB ITEMHASCHANGED
                    IF DCOUNT(new_line, @AM) > 1 THEN
                        bottom_line = bottom_line + DCOUNT(new_line, @AM) - 1
                        current_attribute = current_attribute + DCOUNT(new_line, @AM) - 1
                    END
                END
                current_line = R.ITEM<current_attribute>
                display_flag = 1
            CASE uc_command_entered1 = 'R'
                IF uc_command_entered[2, 1] = 'V' THEN
                    var_search = 1
                    vpos = 3
                END ELSE
                    var_search = 0
                    vpos = 2
                END
                command_parameter = command_entered[vpos, 99999]
                IF command_parameter[1, 1] = '*' THEN
                    command_parameter = bottom_line : command_parameter[2, 99999]
                    command_entered = command_entered[1, vpos - 1] : command_parameter
                    uc_command_entered = OCONV(command_entered, 'MCU')
                END
                number_param = ''; last_number = 1
                LOOP
                UNTIL NOT(NUM(command_parameter[last_number, 1])) OR last_number > LEN(command_parameter) DO
                    number_param = number_param : command_parameter[last_number, 1]
                    last_number = last_number + 1
                REPEAT
                IF number_param = '' THEN
                    number_param = 1
                END
                command_parameter = command_parameter[last_number, 99999]
                command_delimiter = command_parameter[1, 1]
                IF COUNT(command_parameter, command_delimiter) = 2 THEN
                    command_parameter = command_parameter : command_delimiter
                END
                IF COUNT(command_parameter, command_delimiter) = 4 AND command_entered[LEN(command_entered) - 1, 2] = command_delimiter : '*' THEN
                    command_entered = OCONV(command_entered, 'G0' : command_delimiter : '4')
                    command_parameter = OCONV(command_parameter, 'G0' : command_delimiter : '4')
                    all_occurences = 1
                    uc_command_entered = OCONV(command_entered, 'MCU')
                END
                IF COUNT(command_parameter, command_delimiter) = 3 THEN
                    this_expression = FIELD(command_parameter, command_delimiter, 2)
                    replacement_expression = FIELD(command_parameter, command_delimiter, 3)
                    TruncTest = replacement_expression
                    replacement_expression = replacement_expression<1>          ;* Handle @AM embedded
                    IF TruncTest # replacement_expression THEN
                        DoTrunc = 1
                    END ELSE
                        DoTrunc = 0
                    END
                    IF enhanced_char_display = 4 THEN
                        this_expression = OCONV(this_expression, 'MCXA')
                        replacement_expression = OCONV(replacement_expression, 'MCXA')
                    END
                    IF enhanced_char_display = 3 THEN
                        IF this_expression[1, 1] = '~' AND this_expression[LEN(this_expression), 1] = '~' THEN
                            hex_expression = this_expression[2, LEN(this_expression) - 2]
                            expression_character = XTD(hex_expression)
                            IF expression_character >= 0 AND expression_character <= 254 THEN
                                IF expression_character = INT(expression_character) THEN
                                    this_expression = CHAR(expression_character)
                                END
                            END
                        END
                        IF replacement_expression[1, 1] = '~' AND replacement_expression[LEN(replacement_expression), 1] = '~' THEN
                            hex_replacement = replacement_expression[2, LEN(replacement_expression) - 2]
                            hex_replacement_character = XTD(hex_replacement)
                            IF hex_replacement_character >= 0 AND hex_replacement_character <= 254 THEN
                                IF hex_replacement_character = INT(hex_replacement_character) THEN
                                    replacement_expression = CHAR(hex_replacement_character)
                                END
                            END
                        END
                    END
                    all_occurences = (FIELD(command_parameter, command_delimiter, 4) = '*') + all_occurences
                    eof_flag = 1
                    from_line = current_attribute
                    IF from_line = 0 THEN from_line = 1
                    to_line = current_attribute + number_param - 1
                    IF to_line > bottom_line THEN to_line = bottom_line
                    FOR line_count = from_line TO to_line
                        current_attribute = line_count
                        current_line = R.ITEM<current_attribute>
                        zone_parameters = FIELD(command_parameter, command_delimiter, 4)
                        search_from_zone = 1
                        IF zone_parameters MATCHES "1N0N'-'1N0N" THEN
                            search_from_zone = FIELD(zone_parameters, '-', 1)
                            search_to_zone = FIELD(zone_parameters, '-', 2) - search_from_zone
                            search_line = current_line[search_from_zone, search_to_zone + 1]
                        END ELSE
                            search_line = current_line
                        END
                        expression_index = INDEX(search_line, this_expression, 1)
                        IF this_expression = '' THEN expression_index = 1
                        IF expression_index AND var_search THEN
* Added to not include strings in quotes or commented lines
                            quote_line = search_line; string_start_position = expression_index; GOSUB INQUOTES
                            IF string_start_position = 0 THEN expression_index = 0
* End mod
                            IF expression_index > 1 THEN
                                before_string = search_line[expression_index-1, 1]
                            END ELSE before_string = ''
                            after_string = search_line[expression_index + LEN(this_expression), 1]
                            valid_before = INDEX(before_var_chars, before_string, 1)
                            valid_after = INDEX(after_var_chars, after_string, 1)
                            expression_index = (valid_before AND valid_after) * expression_index
                        END
                        GO SKIPFORNOW
*
*** Added to warn about replacement variable already in use
*
                        IF expression_index AND var_search THEN
                            real_command_entered = command_entered
                            real_current_attribute = current_attribute
                            real_current_line = current_line
                            command_entered = 'LV*/' : replacement_expression
                            current_attribute = 1
                            do_not_save_for_a_command = 1
                            GOSUB LOCATETEXT
                            IF last_locate_line_number THEN
                                show_locate_line_numbers = locate_line_numbers
                                CONVERT @AM TO ',' IN show_locate_line_numbers
                                LOOP
                                    CRT
                                    CRT 'Variable ' : replacement_expression : ' already used on lines : ' :
                                    CRT show_locate_line_numbers
                                    CRT 'Do you still want to do this replacement? (<N>/Y) :' :
                                    INPUT y_or_n  ;* FOR 100 ELSE y_or_n = 'N'
                                    y_or_n = OCONV(y_or_n, 'MCU')
                                UNTIL y_or_n = 'N' OR y_or_n = 'Y' DO
                                    IF y_or_n = 'N' THEN
                                        EXIT
                                    END
                                REPEAT
                            END
                            command_entered = real_command_entered
                            current_attribute = real_current_attribute
                            current_line = real_current_line
                        END
*
***
*
SKIPFORNOW:
                        IF expression_index THEN
                            IF all_occurences THEN
                                IF this_expression = '' OR DoTrunc THEN
                                    CRT 'ALL occurences not valid when replacing NULL or truncating'
                                    EXIT
                                END ELSE
                                    IF search_from_zone = 1 THEN
                                        current_line = CHANGE(current_line, this_expression, replacement_expression)
                                    END ELSE
                                        search_line = CHANGE(search_line, this_expression, replacement_expression)
                                        StartOfLine = current_line[1, search_from_zone-1]
                                        end_of_line = current_line[search_to_zone + search_from_zone + 1, 99999999]
                                        current_line = StartOfLine : search_line : end_of_line
                                    END
                                END
                            END ELSE
                                IF search_from_zone = 1 THEN
                                    end_of_line = current_line[expression_index + LEN(this_expression), 9999999]
                                    IF DoTrunc THEN end_of_line = ''
                                    current_line = current_line[1, expression_index-1] : replacement_expression : end_of_line
                                END ELSE
                                    StartOfLine = current_line[1, search_from_zone-1]
                                    end_of_line = search_line[expression_index + LEN(this_expression), 9999999]
                                    end_of_line := current_line[search_to_zone + search_from_zone + 1, 99999999]
                                    current_line = StartOfLine : search_line[1, expression_index-1] : replacement_expression : end_of_line
                                END
                            END
                            GOSUB CHANGEITEM
                            GOSUB DISPLAYLINE
                        END
                    NEXT line_count
                    IF to_line = bottom_line AND eof_flag THEN
                        CRT 'EOF'
                    END
                END ELSE
                    error_message = 'Invalid replace command'
                END
            CASE uc_command_entered = 'ME'
                IF prestore_commands<1> # '' THEN
                    GOSUB RUNPRESTORE
                    merge_file = data_value
                END ELSE
                    CRT 'Filename : ' :
                    INPUT merge_file :
                    IF merge_file = '' THEN
                        CRT file_name
                    END ELSE
                        CRT
                    END
                    bad_prestore = ''
                END
                merge_file = TRIM(merge_file)
                IF merge_file[1, 5] = 'DICT ' THEN
                    merge_dict = 'DICT'
                    merge_file = FIELD(merge_file, ' ', 2)
                END ELSE
                    merge_dict = ''
                END
                IF merge_file = '' THEN
                    merge_file = file_name
                    merge_dict = dict_or_data
                END
                OPEN merge_dict, merge_file TO F.MFILE THEN
                    LOOP
                        IF prestore_commands<1> # '' THEN
                            GOSUB RUNPRESTORE
                            merge_id = data_value
                        END ELSE
                            CRT 'Itemname : ' :
                            INPUT merge_id
                            bad_prestore = ''
                        END
                    UNTIL merge_id # '*' DO
                    REPEAT
                    READ R.MITEM FROM F.MFILE, merge_id THEN
                        merge_last_line = DCOUNT(R.MITEM, @AM)
                        IF prestore_commands<1> # '' THEN
                            GOSUB RUNPRESTORE
                            merge_from_line = data_value
                        END ELSE
                            CRT ' (' : merge_last_line : ' LINES)'
                            CRT 'From line : ' :
                            INPUT merge_from_line
                        END
                        IF merge_from_line > merge_last_line OR merge_from_line < 1 OR merge_from_line # INT(OCONV(merge_from_line, 'MCN')) THEN
                            error_message = 'From line "' : merge_from_line : '" must be a valid number from 1 to ' : merge_last_line
                        END ELSE
                            IF prestore_commands<1> # '' THEN
                                GOSUB RUNPRESTORE
                                merge_to_line = data_value
                            END ELSE
                                CRT 'To line : ' :
                                INPUT merge_to_line
                                bad_prestore = ''
                            END
                            IF merge_to_line > merge_last_line THEN merge_to_line = merge_last_line
                            IF merge_to_line < merge_from_line OR merge_to_line # INT(OCONV(merge_to_line, 'MCN')) THEN
                                error_message = 'To line "' : merge_to_line : '" must be a valid number from ' : merge_from_line : ' TO ' : merge_last_line
                            END ELSE
                                IF merge_from_line = 1 THEN
                                    merge_index_1 = 0
                                END ELSE
                                    merge_index_1 = INDEX(R.MITEM, @AM, merge_from_line - 1)
                                END
                                merge_index_2 = INDEX(R.MITEM, @AM, merge_to_line)
                                IF merge_index_2 = 0 THEN
                                    merge_index_2 = LEN(R.MITEM) + 1
                                END
                                R.MLINES = R.MITEM[merge_index_1 + 1, merge_index_2-merge_index_1 - 1]
                                oops_block = ''
                                oops_command = 'GA' : current_attribute + 1 : @VM : 'DE' : DCOUNT(R.MLINES, @AM)
                                GOSUB UPDATEOOPS
                                NEW.ATB = current_attribute + 1
                                R.ITEM = INSERT(R.ITEM, NEW.ATB, 0, 0, R.MLINES)
                                GOSUB ITEMHASCHANGED
                                current_attribute = current_attribute + DCOUNT(R.MLINES, @AM)
                                bottom_line = DCOUNT(R.ITEM, @AM)
                                IF LEN(bottom_line) > 3 THEN
                                    line_number_mask = 'R%' : LEN(bottom_line)
                                END ELSE
                                    line_number_mask = 'R%3'
                                END
                            END
                        END
                    END ELSE
                        CRT
                        error_message = 'Cannot read "' : merge_id : '" from ' : merge_file
                    END
                END ELSE
                    IF merge_file # '' THEN
                        error_message = 'Cannot open ' : merge_file
                    END
                END
                current_line = R.ITEM<current_attribute>
                display_flag = 1
            CASE uc_command_entered3 = 'BKB'
                block_begin_attribute = current_attribute
                IF block_begin_attribute = 0 THEN block_begin_attribute = 1
            CASE uc_command_entered3 = 'BKE' OR uc_command_entered3 = 'BKS' OR uc_command_entered3 = 'BKD'
                IF block_begin_attribute # '' THEN
                    block_name = uc_command_entered[4, 99]
                    IF block_name = '' THEN
                        block_name = 1
                    END
                    IF uc_command_entered3 = 'BKD' OR uc_command_entered3 = 'BKS' OR (block_name >= 1 AND block_name <= 999 AND block_name = INT(OCONV(block_name, 'MCN'))) THEN
                        IF current_attribute < block_begin_attribute THEN
                            V.BKE = block_begin_attribute
                            block_begin_attribute = current_attribute
                        END ELSE
                            V.BKE = current_attribute
                        END
                        IF block_begin_attribute = 1 THEN
                            V.BIDX1 = 0
                        END ELSE
                            V.BIDX1 = INDEX(R.ITEM, @AM, block_begin_attribute - 1)
                        END
                        V.BIDX2 = INDEX(R.ITEM, @AM, V.BKE)
                        IF V.BIDX2 = 0 THEN
                            V.BIDX2 = LEN(R.ITEM) + 1
                            V.BIDX3 = V.BIDX1 - 1
                        END ELSE
                            V.BIDX3 = V.BIDX1
                        END
                        R.BLOCK = R.ITEM[V.BIDX1 + 1, V.BIDX2 - V.BIDX1 - 1]
                        IF uc_command_entered3 = 'BKS' OR (uc_command_entered3 = 'BKD' AND NOT(block_name MATCHES '1N0N')) THEN
                            WRITE R.BLOCK ON F.FRED_EDITOR_FILE, 'BLKS*' : block_name
                        END ELSE
                            D.INTBLK(block_name) = R.BLOCK
                        END
                        IF uc_command_entered[1, 3] = 'BKD' THEN
                            R.ITEM = R.ITEM[1, V.BIDX3] : R.ITEM[V.BIDX2 + 1, 9999999]
                            oops_block = R.BLOCK
                            oops_command = 'GA' : block_begin_attribute-1 : @VM : 'MVOOPSBLK'
                            GOSUB UPDATEOOPS
                            GOSUB ITEMHASCHANGED
                            bottom_line = DCOUNT(R.ITEM, @AM)
                            IF LEN(bottom_line) > 3 THEN
                                line_number_mask = 'R%' : LEN(bottom_line)
                            END ELSE
                                line_number_mask = 'R%3'
                            END
                            IF bottom_line > 0 THEN
                                current_attribute = block_begin_attribute
                                IF current_attribute > bottom_line THEN current_attribute = current_attribute - 1       ;* Delete last line
                                current_line = R.ITEM<current_attribute>
                                display_flag = 1
                            END ELSE
                                current_attribute = 0
                            END
                        END
                        block_begin_attribute = ''; V.BKE = ''
                    END ELSE
                        error_message = 'Invalid block number'
                    END
                END ELSE
                    error_message = 'No BKB set'
                END
            CASE uc_command_entered = 'BLKS?'
                GOSUB WIDTHDEPTH
                blks_select_list = ''   ;* Unidata needs this
                SELECT F.FRED_EDITOR_FILE TO blks_select_list
                display_items_list = ''
                last_display_id = 0
                LOOP
                    READNEXT blks_id FROM blks_select_list ELSE EXIT
                    IF blks_id[1, 5] = 'BLKS*' THEN
                        last_display_id += 1
                        display_items_list<last_display_id> = FIELD(blks_id, '*', 2)
                    END
                REPEAT
                last_display_id = DCOUNT(display_items_list, @AM)
                unsorted_array = display_items_list
                GOSUB SORTARRAY
                display_items_list = sorted_array
                BEGIN CASE
                    CASE last_display_id = 0
                        picked_blks_id = ''
                        error_message = 'There are no saved blocks'
                    CASE last_display_id = 1
                        picked_blks_id = display_items_list<1>
                    CASE 1
                        display_list_conv = ''
                        GOSUB PICKFROMLIST
                        picked_blks_id = item_picked
                END CASE
                IF LEN(picked_blks_id) THEN
                    stacked_commands = 'BLKS' : picked_blks_id
                END
            CASE uc_command_entered4 = 'BLKS'
                block_name = uc_command_entered[5, 99]
                IF block_name = '' THEN block_name = 1
                READ R.BLOCK FROM F.FRED_EDITOR_FILE, 'BLKS*' : block_name ELSE
                    R.BLOCK = ''
                END
                IF R.BLOCK = '' THEN
                    error_message = 'No saved block ' : block_name
                END ELSE
                    V.LASTB = DCOUNT(R.BLOCK, @AM)
                    FOR line_count = 1 TO V.LASTB
                        temporary_variable = LEN(V.LASTB)
                        IF temporary_variable < 3 THEN temporary_variable = 3
                        V.BAMASK = 'R%' : temporary_variable
                        CRT line_count V.BAMASK : ' ' : R.BLOCK<line_count>
                    NEXT line_count
                END
            CASE uc_command_entered3 = 'BLK'
                IF uc_command_entered = 'BLKOOPS' THEN
                    oops_command_count = DCOUNT(oops_commands, @AM)
                    IF oops_command_count THEN
                        R.BLOCK = D.OOPSBLK (oops_command_count)
                    END ELSE
                        R.BLOCK = ''
                        block_name = 'FOR OOPS'
                    END
                END ELSE
                    block_name = uc_command_entered[4, 99]
                    IF block_name = '' THEN
                        block_name = 1
                    END
                    IF (block_name >= 1 AND block_name <= 999 AND block_name = INT(OCONV(block_name, 'MCN'))) THEN
                        R.BLOCK = D.INTBLK (block_name)
                    END ELSE
                        R.BLOCK = ''
                    END
                END
                IF R.BLOCK = '' THEN
                    error_message = 'No block ' : block_name
                END ELSE
                    V.LASTB = DCOUNT(R.BLOCK, @AM)
                    FOR line_count = 1 TO V.LASTB
                        temporary_variable = LEN(V.LASTB)
                        IF temporary_variable < 3 THEN temporary_variable = 3
                        V.BAMASK = 'R%' : temporary_variable
                        CRT line_count V.BAMASK : ' ' : R.BLOCK<line_count>
                    NEXT line_count
                END
            CASE uc_command_entered = 'MVS?'
                GOSUB WIDTHDEPTH
                blks_select_list = ''   ;* Unidata needs this
                SELECT F.FRED_EDITOR_FILE TO blks_select_list
                display_items_list = ''
                last_display_id = 0
                LOOP
                    READNEXT blks_id FROM blks_select_list ELSE EXIT
                    IF blks_id[1, 5] = 'BLKS*' THEN
                        last_display_id += 1
                        display_items_list<last_display_id> = FIELD(blks_id, '*', 2)
                    END
                REPEAT
                last_display_id = DCOUNT(display_items_list, @AM)
                unsorted_array = display_items_list
                GOSUB SORTARRAY
                display_items_list = sorted_array
                BEGIN CASE
                    CASE last_display_id = 0
                        picked_blks_id = ''
                        error_message = 'There are no saved blocks'
                    CASE last_display_id = 1
                        picked_blks_id = display_items_list<1>
                    CASE 1
                        display_list_conv = ''
                        GOSUB PICKFROMLIST
                        picked_blks_id = item_picked
                END CASE
                IF LEN(picked_blks_id) THEN
                    stacked_commands = 'MVS' : picked_blks_id
                END
            CASE uc_command_entered3 = 'MVS'
                block_name = uc_command_entered[4, 99]
                IF block_name = '' THEN block_name = 1
                READ R.BLOCK FROM F.FRED_EDITOR_FILE, 'BLKS*' : block_name ELSE
                    R.BLOCK = ''
                END
                IF R.BLOCK = '' THEN
                    error_message = 'No saved block ' : block_name
                END ELSE
                    NEW.ATB = current_attribute + 1
                    R.ITEM = INSERT(R.ITEM, NEW.ATB, 0, 0, R.BLOCK)
                    oops_block = ''
                    oops_command = 'GA' : current_attribute + 1 : @VM : 'DE' : DCOUNT(R.BLOCK, @AM)
                    GOSUB UPDATEOOPS
                    GOSUB ITEMHASCHANGED
                    bottom_line = bottom_line + DCOUNT(R.BLOCK, @AM)
                    IF LEN(bottom_line) > 3 THEN
                        line_number_mask = 'R%' : LEN(bottom_line)
                    END ELSE
                        line_number_mask = 'R%3'
                    END
                END
            CASE uc_command_entered2 = 'MV'
                block_name = uc_command_entered[3, 4]
                IF block_name = '' THEN
                    block_name = 1
                END
                IF (block_name >= 1 AND block_name <= 1000 AND block_name = INT(OCONV(block_name, 'MCN'))) THEN
                    R.BLOCK = D.INTBLK (block_name)
                END ELSE
                    R.BLOCK = ''
                END
                IF block_name = 1000 AND bad_prestore<1> # '11' THEN
                    R.BLOCK = ''        ;* Reserved for OOPS
                END
                IF R.BLOCK = '' THEN
                    error_message = 'No block ' : block_name
                END ELSE
                    NEW.ATB = current_attribute + 1
                    R.ITEM = INSERT(R.ITEM, NEW.ATB, 0, 0, R.BLOCK)
                    oops_block = ''
                    oops_command = 'GA' : current_attribute + 1 : @VM : 'DE' : DCOUNT(R.BLOCK, @AM)
                    GOSUB UPDATEOOPS
                    GOSUB ITEMHASCHANGED
                    bottom_line = bottom_line + DCOUNT(R.BLOCK, @AM)
                    IF LEN(bottom_line) > 3 THEN
                        line_number_mask = 'R%' : LEN(bottom_line)
                    END ELSE
                        line_number_mask = 'R%3'
                    END
                END
            CASE uc_command_entered = 'F'
                current_attribute = 0
                CRT 'TOP'
            CASE uc_command_entered2 = 'FI'
                FIOPTS = FIELD(uc_command_entered, ' ', 1)[3, 99]
                V.CTMP = FIOPTS; CONVERT valid_save_options TO '' IN V.CTMP
                IF V.CTMP = '' THEN
                    V.SID = FIELD(uc_command_entered, ' ', 2)
                    IF V.SID = '' THEN V.SID = file_item_id
                    FIB.FLG = INDEX(FIOPTS, 'B', 1)
                    FIC.FLG = INDEX(FIOPTS, 'C', 1)
                    IF fibcc_override_catalog THEN
                        FIC2.FLG = INDEX(FIOPTS, 'C', 2)
                    END
                    IF FIC.FLG AND fibcc_override_catalog THEN
                        IF FIC2.FLG THEN
                            FIC.FLG = 1
                        END ELSE
                            CRT '"C" CATALOG ignored.  Must use CC to override CATALOG'
                            FIC.FLG = 0
                        END
                    END
                    FIF.FLG = INDEX(FIOPTS, 'F', 1)
                    FIK.FLG = INDEX(FIOPTS, 'K', 1)
                    FIO.FLG = INDEX(FIOPTS, 'O', 1)
                    FIQ.FLG = INDEX(FIOPTS, 'Q', 1)
                    FIR.FLG = INDEX(FIOPTS, 'R', 1)
                    FIU.FLG = INDEX(FIOPTS, 'U', 1)
                    IF FIU.FLG THEN V.SID = OCONV(file_item_id, 'MCU')
                    V.OVERLAY = 'Y'
                    IF NOT(FIO.FLG) AND V.SID # file_item_id THEN
                        READV EXISTS FROM F.FILE, V.SID, 1 THEN
                            V.OVERLAY = ''
                            LOOP
                            UNTIL V.OVERLAY = 'Y' OR V.OVERLAY = 'N' DO
                                CRT 'Item exists... Overwrite? (Y/N) : ' :
                                IF prestore_commands<1> # '' THEN
                                    GOSUB RUNPRESTORE
                                    V.OVERLAY = data_value
                                END ELSE
                                    INPUT V.OVERLAY
                                    bad_prestore = ''
                                END
                                V.OVERLAY = OCONV(V.OVERLAY, 'MCU')
                            REPEAT
                        END
                    END
                    IF V.OVERLAY = 'Y' THEN
                        IF FIK.FLG THEN
                            exit_from_list = 1
                        END
                        IF FIU.FLG AND V.SID # file_item_id THEN
                            DELETE F.FILE, file_item_id
                            file_item_id = V.SID
                        END
                        GOSUB WRITE.ITEM
                        RELEASE F.FILE, V.SID
                        IF NOT(z_option) THEN
                            CRT dict_or_data : ' ' : file_name : ' ' : V.SID : ' FILED'
                        END
                        IF FIB.FLG THEN
                            CRT 'BASIC...'
                            GOSUB BASIC.PROGRAMS
                            IF NOT(FIQ.FLG) AND last_basic_error THEN
                                CRT last_basic_error : " BASIC errors... use 'N' or 'NA' to display"
                                CONTINUE
                            END
                        END
                        IF NOT(last_basic_error) AND FIC.FLG THEN
                            CRT 'CATALOG...'
                            IF d3_file_pathing THEN
                                CRT
                                CRT 'Cannot catalog with account pathing'
                                CRT
                            END ELSE
                                CATALOGverb = 'CATALOG ' : catalog_options : ' ' : dict_or_data : ' ' : file_name : ' ' : V.SID
                                IF FIF.FLG THEN CATALOGverb := ' (O'
                                IF LEN(catalog_options) THEN
                                    CRT CATALOGverb
                                END
                                EXECUTE CATALOGverb
                            END
                        END
                        IF NOT(last_basic_error) AND FIR.FLG THEN
                            CRT 'RUN...'
                            EXECUTE 'RUN ' : dict_or_data : ' ' : file_name : ' ' : V.SID
                        END
                        exit_loop = 1
                    END ELSE
                        error_message = 'Item not written'
                    END
                END ELSE
                    error_message = 'Must be FI{BCKOQRU}'
                END
            CASE uc_command_entered2 = 'FS'
                FSOPTS = FIELD(uc_command_entered, ' ', 1)[3, 99]
                V.CTMP = FSOPTS; CONVERT valid_save_options TO '' IN V.CTMP
                IF V.CTMP = '' THEN
                    V.SID = FIELD(command_entered, ' ', 2)
                    IF V.SID = '' THEN V.SID = file_item_id
                    FIB.FLG = INDEX(FSOPTS, 'B', 1)
                    FIC.FLG = INDEX(FSOPTS, 'C', 1)
                    FIF.FLG = INDEX(FSOPTS, 'F', 1)
                    FIO.FLG = INDEX(FSOPTS, 'O', 1)
                    FIR.FLG = INDEX(FSOPTS, 'R', 1)
                    FIU.FLG = INDEX(FSOPTS, 'U', 1)
                    IF FIU.FLG THEN V.SID = OCONV(file_item_id, 'MCU')
                    V.OVERLAY = 'Y'
                    IF NOT(FIO.FLG) AND V.SID # file_item_id THEN
                        READV EXISTS FROM F.FILE, V.SID, 1 THEN
                            V.OVERLAY = ''
                            LOOP
                            UNTIL V.OVERLAY = 'Y' OR V.OVERLAY = 'N' DO
                                CRT 'Item exists... Overwrite? (Y/N) : ' :
                                IF prestore_commands<1> # '' THEN
                                    GOSUB RUNPRESTORE
                                    V.OVERLAY = data_value
                                END ELSE
                                    INPUT V.OVERLAY
                                    bad_prestore = ''
                                END
                                V.OVERLAY = OCONV(V.OVERLAY, 'MCU')
                            REPEAT
                        END
                    END
                    IF V.OVERLAY = 'Y' THEN
                        IF FIU.FLG AND V.SID # file_item_id THEN
                            DELETE F.FILE, file_item_id
                            file_item_id = V.SID
                        END
                        GOSUB WRITE.ITEM
                        IF NOT(z_option) THEN
                            CRT dict_or_data : ' ' : file_name : ' ' : V.SID : ' SAVED'
                        END
                        IF FIB.FLG THEN
                            CRT 'BASIC...'
                            GOSUB BASIC.PROGRAMS
                        END
                        IF FIC.FLG THEN
                            CATALOGverb = 'CATALOG ' : catalog_options : ' ' : dict_or_data : ' ' : file_name : ' ' : V.SID
                            IF FIF.FLG THEN CATALOGverb := ' (O'
                            IF LEN(catalog_options) THEN
                                CRT CATALOGverb
                            END
                            EXECUTE CATALOGverb
                        END
                        IF FIR.FLG THEN
                            EXECUTE 'RUN ' : dict_or_data : ' ' : file_name : ' ' : V.SID
                        END
                    END ELSE
                        error_message = 'Item not written'
                    END
                END ELSE
                    error_message = 'Must be FS{BCORU}{ itemname}'
                END
            CASE (uc_command_entered = 'FD' OR uc_command_entered = 'FDK')
                are_you_sure = ''
                LOOP
                UNTIL are_you_sure = 'Y' OR are_you_sure = 'N' DO
                    CRT 'Are you sure? (Y/N) : ' :
                    IF prestore_commands<1> # '' THEN
                        GOSUB RUNPRESTORE
                        are_you_sure = data_value
                    END ELSE
                        INPUT are_you_sure
                        bad_prestore = ''
                    END
                    are_you_sure = OCONV(are_you_sure, 'MCU')
                REPEAT
                IF are_you_sure = 'Y' THEN
                    DELETE F.FILE, file_item_id
                    IF NOT(z_option) THEN
                        CRT dict_or_data : ' ' : file_name : ' ' : file_item_id : ' DELETED'
                    END
                    exit_loop = 1
                    IF uc_command_entered = 'FDK' THEN
                        exit_from_list = 1
                    END
                END ELSE
                    error_message = 'Item not deleted'
                END
            CASE uc_command_entered MATCHES "'W'1N0N"
                window_length = OCONV(uc_command_entered, 'MCN') - 1
                to_line = current_attribute
                IF to_line = 0 THEN to_line = 1
                from_line = to_line - window_length
                IF from_line <= 0 THEN from_line = 1
                FOR line_count = from_line TO to_line
                    current_attribute = line_count
                    current_line = R.ITEM<current_attribute>
                    GOSUB DISPLAYLINE
                NEXT line_count
            CASE uc_command_entered = 'WW'
                stacked_commands = 'U' : window_length
                stacked_commands<-1> = 'W' : (window_length + 1)
            CASE uc_command_entered = 'W'
                window_length = output_depth - 3
                IF session_prestore_commands<1> MATCHES "'L'0N" THEN
                    window_length = OCONV(session_prestore_commands<1>, 'MCN')
                END
                to_line = current_attribute
                IF to_line = 0 THEN to_line = 1
                from_line = to_line - window_length
                IF from_line <= 0 THEN from_line = 1
                FOR line_count = from_line TO to_line
                    current_attribute = line_count
                    current_line = R.ITEM<current_attribute>
                    GOSUB DISPLAYLINE
                NEXT line_count
            CASE uc_command_entered MATCHES "'L'0N" OR uc_command_entered = 'L' OR uc_command_entered = 'L*'
                IF uc_command_entered = 'L*' THEN uc_command_entered = 'L' : bottom_line
                eof_flag = 1
                command_parameter = uc_command_entered[2, 9999]
                IF command_parameter = '' THEN command_parameter = 1
                from_line = current_attribute + 1
                to_line = current_attribute + command_parameter
                IF to_line > bottom_line THEN to_line = bottom_line
                FOR line_count = from_line TO to_line
                    current_attribute = line_count
                    current_line = R.ITEM<current_attribute>
                    GOSUB DISPLAYLINE
                NEXT line_count
            CASE uc_command_entered = 'Q'
                error_message = 'Must enter a string to locate'
            CASE uc_command_entered1 = 'L' OR uc_command_entered1 = 'Q' OR uc_command_entered2 = 'LC' OR uc_command_entered2 = 'QC'
                GOSUB LOCATETEXT
            CASE uc_command_entered MATCHES "'DE'0N" OR uc_command_entered = 'DE'
                IF current_attribute = 0 THEN current_attribute = 1
                command_parameter = uc_command_entered[3, 9]
                IF command_parameter = '' THEN command_parameter = 1
                IF current_attribute = 1 THEN
                    V.DIDX1 = 0
                END ELSE
                    V.DIDX1 = INDEX(R.ITEM, @AM, current_attribute-1) - 1
                END
                V.DTHRU = current_attribute + command_parameter - 1
                IF V.DTHRU >= bottom_line THEN V.DTHRU = bottom_line
                V.DIDX2 = INDEX(R.ITEM : @AM, @AM, V.DTHRU)
                IF current_attribute = 1 THEN V.DIDX2 += 1
                oops_block = R.ITEM[V.DIDX1 + 2, V.DIDX2 - V.DIDX1 - 2]
                oops_command = 'GA' : current_attribute-1 : @VM : 'MVOOPSBLK'
                GOSUB UPDATEOOPS
                R.ITEM = R.ITEM[1, V.DIDX1] : R.ITEM[V.DIDX2, 9999999]
                GOSUB ITEMHASCHANGED
                bottom_line = DCOUNT(R.ITEM, @AM)
                IF LEN(bottom_line) > 3 THEN
                    line_number_mask = 'R%' : LEN(bottom_line)
                END ELSE
                    line_number_mask = 'R%3'
                END
                IF current_attribute > bottom_line THEN current_attribute = current_attribute - 1   ;* Delete last line
                IF bottom_line > 0 THEN
                    current_line = R.ITEM<current_attribute>
                    display_flag = 1
                END
            CASE uc_command_entered2 = 'DE'
                command_parameter = command_entered[3, 99999]
                IF command_parameter[1, 1] = '*' THEN
                    command_parameter = bottom_line : command_parameter[2, 99999]
                    command_entered = command_entered[1, 2] : command_parameter
                    uc_command_entered = OCONV(command_entered, 'MCU')
                END
                number_param = ''; last_number = 1
                LOOP
                UNTIL NOT(NUM(command_parameter[last_number, 1])) DO
                    number_param = number_param : command_parameter[last_number, 1]
                    last_number = last_number + 1
                REPEAT
                IF number_param = '' THEN
                    number_param = 1
                END
                command_parameter = command_parameter[last_number, 99999]
                command_delimiter = command_parameter[1, 1]
                IF COUNT(command_parameter, command_delimiter) = 1 THEN
                    command_parameter = command_parameter : command_delimiter
                END
                IF COUNT(command_parameter, command_delimiter) = 2 THEN
                    this_expression = FIELD(command_parameter, command_delimiter, 2)
                    BEGIN CASE
                        CASE enhanced_char_display = 4
                            last_hex = LEN(this_expression) / 2
                            IF last_hex # INT(last_hex) THEN
                                error_message = 'Must specify complete HEX string for BL'
                            END
                            all_hex_expression = ''
                            FOR hex_count = 1 TO last_hex
                                hex_sequence = OCONV(this_expression[(hex_count-1) * 2 + 1, 2], 'MCD')
                                all_hex_expression := all_hex_expression : CHAR(hex_sequence)
                            NEXT hex_count
                            this_expression = all_hex_expression
                        CASE enhanced_char_display = 3
                            IF this_expression[1, 1] = '~' AND this_expression[LEN(this_expression), 1] = '~' THEN
                                hex_expression = this_expression[2, LEN(this_expression) - 2]
                                expression_character = XTD(hex_expression)
                                IF expression_character >= 0 AND expression_character <= 254 THEN
                                    IF expression_character = INT(expression_character) THEN
                                        this_expression = CHAR(expression_character)
                                    END
                                END
                            END
                    END CASE
                    eof_flag = 1
                    from_line = current_attribute
                    to_line = current_attribute + number_param - 1
                    IF to_line > bottom_line THEN to_line = bottom_line
                    V.DEL.ATBS = ''; V.LAST.DEL = 0
                    zone_parameters = FIELD(command_parameter, command_delimiter, 3)
                    FOR line_count = from_line TO to_line
                        current_attribute = line_count
                        current_line = R.ITEM<current_attribute>
                        IF zone_parameters MATCHES "1N0N'-'1N0N" THEN
                            search_from_zone = FIELD(zone_parameters, '-', 1)
                            search_to_zone = FIELD(zone_parameters, '-', 2) - search_from_zone
                            search_line = current_line[search_from_zone, search_to_zone + 1]
                        END ELSE
                            search_line = current_line
                        END
                        delete_expression_index = INDEX(search_line, this_expression, 1)
                        IF delete_expression_index THEN
                            V.LAST.DEL = V.LAST.DEL + 1
                            V.DEL.ATBS<-1> = line_count
                            GOSUB DISPLAYLINE
                        END
                    NEXT line_count
                    FOR line_count = V.LAST.DEL TO 1 STEP -1
                        oops_block = R.ITEM<V.DEL.ATBS<line_count>>
                        oops_command = 'GA' : line_count-1 : @VM : 'MVOOPSBLK'
                        GOSUB UPDATEOOPS
                        R.ITEM = DELETE(R.ITEM, V.DEL.ATBS<line_count>, 0, 0)
                        GOSUB ITEMHASCHANGED
                        bottom_line = bottom_line - 1
                    NEXT line_count
                    IF to_line = bottom_line AND current_attribute = bottom_line AND eof_flag THEN
                        CRT 'EOF'
                    END
                END ELSE
                    error_message = 'Invalid DE command'
                END
            CASE uc_command_entered2 = 'DM'
                command_parameter = command_entered[3, 99999]
                IF command_parameter[1, 1] = '*' THEN
                    command_parameter = bottom_line : command_parameter[2, 99999]
                    command_entered = command_entered[1, 2] : command_parameter
                    uc_command_entered = OCONV(command_entered, 'MCU')
                END
                number_param = ''; last_number = 1
                LOOP
                UNTIL NOT(NUM(command_parameter[last_number, 1])) DO
                    number_param = number_param : command_parameter[last_number, 1]
                    last_number = last_number + 1
                REPEAT
                IF number_param = '' THEN
                    number_param = 1
                END
                command_parameter = command_parameter[last_number, 99999]
                command_delimiter = command_parameter[1, 1]
                IF COUNT(command_parameter, command_delimiter) = 1 THEN
                    command_parameter = command_parameter : command_delimiter
                END
                IF COUNT(command_parameter, command_delimiter) = 2 THEN
                    V.MATCH = FIELD(command_parameter, command_delimiter, 2)
                    eof_flag = 1
                    from_line = current_attribute
                    to_line = current_attribute + number_param - 1
                    IF to_line > bottom_line THEN to_line = bottom_line
                    V.DEL.ATBS = ''; V.LAST.DEL = 0
                    zone_parameters = FIELD(command_parameter, command_delimiter, 3)
                    FOR line_count = from_line TO to_line
                        current_attribute = line_count
                        current_line = R.ITEM<current_attribute>
                        IF zone_parameters MATCHES "1N0N'-'1N0N" THEN
                            search_from_zone = FIELD(zone_parameters, '-', 1)
                            search_to_zone = FIELD(zone_parameters, '-', 2) - search_from_zone
                            search_line = current_line[search_from_zone, search_to_zone + 1]
                        END ELSE
                            search_line = current_line
                        END
                        V.MATCH.IDX = search_line MATCHES V.MATCH
                        IF V.MATCH.IDX THEN
                            V.LAST.DEL = V.LAST.DEL + 1
                            V.DEL.ATBS<-1> = line_count
                            GOSUB DISPLAYLINE
                        END
                    NEXT line_count
                    FOR line_count = V.LAST.DEL TO 1 STEP -1
                        oops_block = R.ITEM<V.DEL.ATBS<line_count>>
                        oops_command = 'GA' : line_count-1 : @VM : 'MVOOPSBLK'
                        GOSUB UPDATEOOPS
                        R.ITEM = DELETE(R.ITEM, V.DEL.ATBS<line_count>, 0, 0)
                        GOSUB ITEMHASCHANGED
                        bottom_line = bottom_line - 1
                    NEXT line_count
                    IF to_line = bottom_line AND current_attribute = bottom_line AND eof_flag THEN
                        CRT 'EOF'
                    END
                END ELSE
                    error_message = 'Invalid DM command'
                END
            CASE command_entered = '?' OR uc_command_entered = 'S?'
                IF file_item_id[1, 4] # '~EV~' THEN
                    CRT dict_or_data : ' ' : file_name : ' "' : file_item_id : '" Item size = ' : LEN(R.ITEM) : ', Attribute ' : current_attribute : '.   Use H for help'
                END ELSE
                    Edict_or_data = FIELD(file_item_id, '~', 3)
                    Efile_name = FIELD(file_item_id, '~', 4)
                    Efile_item_id = FIELD(file_item_id, '~', 5)
                    Ecurrent_attribute = FIELD(file_item_id, '~', 6)
                    EV.VAL = FIELD(file_item_id, '~', 7)
                    IF EV.VAL + 0 # 0 THEN
                        EV.VAL = ', Value ' : EV.VAL
                        LINEWORD = 'Subvalue'
                    END ELSE
                        EV.VAL = ''
                        LINEWORD = 'Value'
                    END
                    CRT Edict_or_data : ' ' : Efile_name : ' "' : Efile_item_id : '" Item size = ' : LEN(R.ITEM) : ', Attribute ' : Ecurrent_attribute : EV.VAL : ', ' : LINEWORD : ' ' : current_attribute : '.'
                END
            CASE uc_command_entered = 'P?' OR uc_command_entered = 'PD'
                FOR PCNT = 0 TO 9
                    temporary_variable = session_prestore_commands<PCNT + 1>
                    CONVERT @VM TO ']' IN temporary_variable
                    CRT ('P' : PCNT) 'L#5' : temporary_variable 'L#74'
                NEXT PCNT
                CRT ('A') 'L#5' : lookup_command 'L#74'
                CRT ('BKB') 'L#5' : block_begin_attribute 'L#74'
                oops_command_count = DCOUNT(oops_commands, @AM)
                temporary_variable = oops_commands<oops_command_count>
                CONVERT @VM TO ']' IN temporary_variable
                IF oops_command_count > 0 THEN
                    temporary_variable_2 = '[' : oops_command_count : ',1] '
                END ELSE
                    temporary_variable_2 = ''
                END
                CRT ('OOPS') 'L#5' : temporary_variable_2 : temporary_variable 'L#69'
                CRT ('EC') 'L#5' : enhanced_char_display : ' ' : enhanced_char_display_desc<enhanced_char_display + 1>
                CRT 'Use H for help.   ' : history_oops_version_status
            CASE uc_command_entered MATCHES "'P'1N' '0X"
                V.PSN = uc_command_entered[2, 1]
                temporary_variable = command_entered[4, 9999]
                CONVERT TM_eq : ESC_eq TO @VM : @VM IN temporary_variable
                session_prestore_commands<V.PSN + 1> = temporary_variable
            CASE uc_command_entered2 MATCHES "'P'1N"
                command_parameter = command_entered[2, 1]
                IF session_prestore_commands<command_parameter + 1> # '' THEN
                    prestore_commands = INSERT(prestore_commands, 1, 0, 0, command_parameter + 1)
                    prestore_count = INSERT(prestore_count, 1, 0, 0, 0)
                END ELSE
                    error_message = 'No prestore command'
                END
            CASE uc_command_entered4 = 'OOPS'
                oops_command_count = DCOUNT(oops_commands, @AM)
                IF NOT(oops_command_count) THEN
                    error_message = 'No OOPS command present'
                END ELSE
                    temporary_variable = oops_commands<oops_command_count>
                    temporary_variable = CHANGE(temporary_variable, 'MVOOPSBLK', 'MV1000')
                    D.INTBLK(1000) = D.OOPSBLK (oops_command_count)
                    session_prestore_commands<11> = temporary_variable
                    oops_commands = DELETE(oops_commands, oops_command_count, 0, 0)
                    D.OOPSBLK(oops_command_count) = ''
                    prestore_commands = INSERT(prestore_commands, 1, 0, 0, 11)
                    prestore_count = INSERT(prestore_count, 1, 0, 0, 0)
                END
            CASE uc_command_entered2 = 'ME'
                V.MECCNT = 2
                V.MENOL = 0
                LOOP
                    V.MECCNT += 1
                    V.MECHAR = uc_command_entered[V.MECCNT, 1]
                WHILE NUM(V.MECHAR) AND V.MECHAR # '' DO
                    V.MENOL := V.MECHAR
                REPEAT
                IF V.MENOL = 0 THEN V.MENOL = 1
                V.MEDELIM = V.MECHAR
                V.MEFILE = FIELD(uc_command_entered, V.MEDELIM, 2)
                BEGIN CASE
                    CASE V.MEDELIM # '('
                        V.MEMID = V.MEFILE
                        V.MEFILE = ''
                        V.MEFROM = FIELD(uc_command_entered, V.MEDELIM, 3)
                    CASE V.MEFILE[1, 5] = 'DICT '
                        V.MEDELIM = ')'
                        V.MEFROM = FIELD(V.MEFILE, V.MEDELIM, 2)
                        V.MEFILE = FIELD(V.MEFILE, V.MEDELIM, 1)
                        V.MEMID = FIELD(V.MEFILE, ' ', 3)
                        V.MEFILE = OCONV(V.MEFILE, 'G0 2')
                    CASE 1
                        V.MEDELIM = ')'
                        V.MEFROM = FIELD(V.MEFILE, V.MEDELIM, 2)
                        V.MEFILE = FIELD(V.MEFILE, V.MEDELIM, 2)
                        V.MEID = OCONV(V.MEFILE, 'G1 99')
                        V.MEFILE = FIELD(V.MEFILE, ' ', 1)
                END CASE
                IF V.MEFROM = '' THEN V.MEFROM = 1
                IF V.MEMID = '' THEN V.MEMID = file_item_id
                session_prestore_commands<12> = 'ME'
                session_prestore_commands<12, 2> = V.MEFILE
                session_prestore_commands<12, 3> = V.MEMID
                session_prestore_commands<12, 4> = V.MEFROM
                session_prestore_commands<12, 5> = V.MEFROM + V.MENOL - 1
                prestore_commands = INSERT(prestore_commands, 1, 0, 0, 12)
                prestore_count = INSERT(prestore_count, 1, 0, 0, 0)
            CASE 1
                error_message = 'Invalid command "' : command_entered : '"'
        END CASE
        IF LEN(stacked_commands) THEN
            command_entered = stacked_commands<1>
            uc_command_entered = OCONV(command_entered, 'MCU')
            DEL stacked_commands<1>
            from_stack = 1
        END ELSE
            from_stack = 0
        END
        IF error_message # '' THEN
            CRT BELL_eq : error_message
            IF bad_prestore # '' THEN
                GOSUB KILL.PRESTORE
            END
        END
        IF display_flag = 1 AND current_attribute # 0 THEN
            GOSUB DISPLAYLINE
        END
    REPEAT
    RELEASE F.FILE, file_item_id
*
*** Ask if prestores change, do they want to save them
*
    DEL session_prestore_commands<12>   ;* MERGE
    DEL session_prestore_commands<11>; DEL original_prestore_commands<11>       ;* OOPS
    IF original_prestore_commands # session_prestore_commands THEN
        LOOP
            CRT 'Prestore commands changed.  Do you want to save them? (yes/no) : ' :
            INPUT CHG.PRE, 3 _
            CHG.PRE = OCONV(CHG.PRE, 'MCU')
        UNTIL CHG.PRE = 'YES' OR CHG.PRE = 'NO' DO
        REPEAT
        IF CHG.PRE = 'YES' THEN
            READ R.EDIT.PARAMS FROM F.FRED_EDITOR_FILE, 'FRED*USER*' : user_name ELSE R.EDIT.PARAMS = ''
            FOR PSCNT = 1 TO 10
                R.EDIT.PARAMS<PSCNT> = session_prestore_commands<PSCNT>
            NEXT PSCNT
            IF prestore_one_null AND session_prestore_commands<1> = 'LD' THEN R.EDIT.PARAMS<1> = ''
            WRITE R.EDIT.PARAMS ON F.FRED_EDITOR_FILE, 'FRED*USER*' : user_name
        END
    END
    original_prestore_commands = session_prestore_commands
*
*** Ask for comment / Write History
*
    IF history_flag THEN
        HDCNT = 0
        LOOP
            HDCNT += 1
            hist_id = DATE() : '.' : HDCNT
            READU R.HIST FROM F.FRED_EDITOR_FILE_HIST, hist_id LOCKED
                NULL          ;* ASSUME LOCK MEANS IT IS TAKEN
            END THEN
                RELEASE F.FRED_EDITOR_FILE_HIST, hist_id
            END ELSE
                R.HIST = (oops_commands # '')
                R.HIST<2> = TIME()
                R.HIST<3> = account_name
                R.HIST<4> = user_name
                R.HIST<5> = dict_or_data
                R.HIST<6> = file_name
                R.HIST<7> = file_item_id
                IF LEN(hist_comment) THEN
                    R.HIST<8> = hist_comment
                END ELSE
                    IF prestore_commands = '' AND oops_commands # '' THEN
                        LOOP
                            CRT
                            CRT 'Comment : ' :
                            INPUT V.COMMENT
                        UNTIL LEN(V.COMMENT) > 3 DO
                            CRT
                            CRT 'Must enter at least 3 character comment'
                            CRT
                        REPEAT
                        R.HIST<8> = V.COMMENT
                    END
                END
                WRITE R.HIST ON F.FRED_EDITOR_FILE_HIST, hist_id
                IF oops_commands # '' AND oops_flag THEN
                    OOPSID = 'OOPS.' : hist_id
                    WRITE oops_commands ON F.FRED_EDITOR_FILE_OOPS, OOPSID
                    R.OOPSBLK = ''
                    FOR OOPSAM = 1 TO 100
                        oops_block = D.OOPSBLK (OOPSAM)
                        IF oops_block # '' THEN
                            CONVERT @AM TO TAB_eq IN oops_block
                            R.OOPSBLK<OOPSAM> = oops_block
                        END
                    NEXT OOPSAM
                    IF R.OOPSBLK # '' THEN
                        OOPSBLKID = 'OOPSBLK.' : hist_id
                        WRITE R.OOPSBLK ON F.FRED_EDITOR_FILE_OOPS, OOPSBLKID
                    END
                END
                EXIT
            END
        REPEAT
    END
    RETURN
*
DISPLAYLINE:
*
    last_locate_line_number += 1
    locate_line_numbers<last_locate_line_number> = current_attribute
    IF NOT(return_only_numbers) THEN
        V.DISP = current_line
        IF enhanced_char_display > 0 THEN
            V.DISPLEN = LEN(V.DISP)
            BLFLG = 0
            BLNK = 0
            FOR CCNT = V.DISPLEN TO 1 STEP -1
                V.CHAR = V.DISP[CCNT, 1]
                V.SEQ = SEQ(V.CHAR)
                IF enhanced_char_display = 4 THEN
                    CTL.DOT = DTX(V.SEQ) 'R%2'
                    V.DISP = V.DISP[1, CCNT-1] : CTL.DOT : V.DISP[CCNT + 1, 9999999]
                END ELSE
                    IF V.SEQ < 28 OR V.SEQ > 126 THEN
                        BEGIN CASE
                            CASE V.SEQ = 253
                                CTL.DOT = ']'
                            CASE V.SEQ = 252
                                CTL.DOT = '\'
                            CASE 1
                                CTL.DOT = "."
                                IF enhanced_char_display = 3 THEN
                                    CTL.DOT = '~' : DTX(V.SEQ) : '~'
                                END
                        END CASE
                        V.DISP = V.DISP[1, CCNT-1] : CTL.DOT : V.DISP[CCNT + 1, 9999999]
                    END
                END
            NEXT CCNT
        END
        IF highlight_info # '' THEN
            IF highlight_info<2> # '' THEN
                V.DISP = V.DISP[1, highlight_info<2> - 1] : HL.ON : V.DISP[highlight_info<2>, 1] : HL.OFF : V.DISP[highlight_info<2> + 1, 99999]
            END ELSE
                IF highlight_info<3> MATCHES "0N'-'0N" THEN
                    V.ZSTART = FIELD(highlight_info<3>, '-', 1)
                    V.ZEND = FIELD(highlight_info<3>, '-', 2)
                    V.ZHIGH = V.DISP[V.ZSTART, (V.ZEND - V.ZSTART) + 1]
                    V.DISP = V.DISP[1, V.ZSTART-1] : CHANGE(V.ZHIGH, highlight_info<1>, HL.ON : highlight_info<1> : HL.OFF) : V.DISP[V.ZEND + 1, 999999]
                END ELSE
                    V.DISP = CHANGE(V.DISP, highlight_info<1>, HL.ON : highlight_info<1> : HL.OFF)
                    V.DISP = CHANGE(V.DISP, highlight_info<1>, HL.ON : highlight_info<1> : HL.OFF)
                END
            END
        END
        IF show_lines THEN
            IF s_option THEN
                PRINT V.DISP :
            END ELSE
                IF current_attribute = block_begin_attribute THEN
                    mark_block = '>'
                END ELSE
                    mark_block = ' '
                END
                PRINT current_attribute line_number_mask : mark_block : V.DISP :
            END
            IF enhanced_char_display >= 2 THEN
                IF V.DISP[LEN(V.DISP), 1] = ' ' THEN
                    V.ENDSPACE = LEN(V.DISP) - LEN(TRIM(V.DISP, ' ', 'T'))
                    PRINT HL.ON : '{' : V.ENDSPACE : '}' : HL.OFF
                END ELSE
                    PRINT
                END
            END ELSE
                PRINT
            END
        END
        IF current_attribute = bottom_line AND eof_flag THEN
            IF show_lines THEN PRINT 'EOF'
            eof_flag = 0
        END
        highlight_info = ''
    END
    RETURN
*
CHANGEITEM:
*
    IF R.ITEM<current_attribute> # current_line THEN
        oops_block = R.ITEM<current_attribute>
        oops_command = 'GA' : current_attribute : @VM : 'MVOOPSBLK' : @VM : 'DE'
        GOSUB UPDATEOOPS
        R.ITEM<current_attribute> = current_line
        GOSUB ITEMHASCHANGED
    END
    RETURN
*
UPDATEOOPS:
*
    IF bad_prestore<1> = 11 THEN RETURN ;* Do not log running OOPS
    oops_command_count = DCOUNT(oops_commands, @AM) + 1
    IF oops_command_count = 101 THEN
        FOR MCNT = 100 TO 51 STEP -1
            oops_commands<MCNT-50> = oops_commands<MCNT>
            D.OOPSBLK(MCNT-50) = D.OOPSBLK (MCNT)
*
            oops_commands<MCNT> = ''
            D.OOPSBLK(MCNT) = ''
        NEXT MCNT
        oops_command_count = 51
    END
    D.OOPSBLK(oops_command_count) = oops_block
    oops_commands<oops_command_count> = oops_command
    RETURN
*
RUNPRESTORE:
*
    prestore_count<1> = prestore_count<1> + 1
    data_value = session_prestore_commands<prestore_commands<1>, prestore_count<1>>
    bad_prestore = prestore_commands<1>
    bad_prestore<2> = prestore_count
    bad_prestore<3> = data_value
    IF prestore_count = DCOUNT(session_prestore_commands<prestore_commands<1>>, @VM) THEN
        prestore_commands = DELETE(prestore_commands, 1, 0, 0)
        prestore_count = DELETE(prestore_count, 1, 0, 0)
    END
    RETURN
*
KILL.PRESTORE:
*
    CRT 'Bad prestore command (P' : bad_prestore<1> - 1 : ') - Command # ' : bad_prestore<2> : '...'
    temporary_variable = bad_prestore<3>
    CONVERT @VM TO ']' IN temporary_variable
    CRT temporary_variable
    prestore_commands = ''; prestore_count = ''
    RETURN
*
WRITE.ITEM:
*
    item_has_changed = 0
    WRITEU R.ITEM ON F.FILE, V.SID
    DELETE F.FRED_EDITOR_FILE, 'changed__' : my_port_number
    IF version_flag AND NOT(q_option) THEN
        item_change = 0; LAST.ITEM = ''
        Lastitem_changeID = dict_or_data : '_' : file_name : '_' : V.SID
        LOOP
            item_change += 1
            item_changeID = Lastitem_changeID : '_' : item_change
            READ item_changeExists FROM F.FRED_EDITOR_FILE_VERSIONS, item_changeID THEN
                LAST.ITEM = DELETE(item_changeExists, 1, 0, 0)
            END ELSE
                IF R.ITEM # LAST.ITEM THEN
                    DateTime = DATE() 'R%5' : TIME() 'R%5' : ' ' : OCONV(DATE(), 'D2/') : ' - ' : OCONV(TIME(), 'MTH')
                    change_item = DateTime : @AM : R.ITEM
                    WRITE change_item ON F.FRED_EDITOR_FILE_VERSIONS, item_changeID
                    WRITE change_item ON F.FRED_EDITOR_FILE_VERSIONS, Lastitem_changeID
                    IF NOT(INDEX(command_line, '~EV~', 1)) THEN
                        CRT 'item_changes written to ' : item_changeID
                    END
                END
                EXIT
            END
        REPEAT
    END
    RETURN
*
USERHELP:
*
    R.HELP = history_oops_version_status
    R.HELP<-1> = 'Invoke the ' : editor_name : ' editor.' : ' ' : editor_name : ' --help for this help'
    R.HELP<-1> = '   ' : editor_name : ' {-Llistname} {DICT} {filename} {ID, prefix... OR *} {({I}{B}{Q}{S}{W}{Z}}'
    R.HELP<-1> = '      ' : editor_name : ' alone will call up last item edited using ' : editor_name : ''
    R.HELP<-1> = '      ' : editor_name : ' ID will edit MD proc or item cataloged as ID'
    R.HELP<-1> = '       {-Llistname} - Allows for GET-LIST listname in command line'
    R.HELP<-1> = '       {DICT}     - specifies dictionary level of file.   Default is DATA level'
    R.HELP<-1> = '       {filename} - specifies file for edit item.'
    R.HELP<-1> = "       {ID}       - Specific ID to edit.  Default is active list's next item"
    R.HELP<-1> = '       {prefix...}- Enter a prefix with 3 dots and it will bring up a list of'
    R.HELP<-1> = '                    items starting with that prefix'
    R.HELP<-1> = '       {*}        - specifies all items in the file'
    R.HELP<-1> = '   {I} - Inquiry only mode.  Item cannot be altered'
    R.HELP<-1> = '   {B} - Allow entry of blank lines.  "EX" to exit the .I command'
    R.HELP<-1> = '   {Q} - Quiet option (Do not keep as last item edited'
    R.HELP<-1> = '   {S} - Suppress Line Numbers'
    R.HELP<-1> = '   {W} - Wait on LOCK'
    R.HELP<-1> = '   {Z} - Suppress TOP, EOF and other status messages'
    PRINT STR('=', 79)
    FOR HCNT = 1 TO DCOUNT(R.HELP, @AM)
        PRINT R.HELP<HCNT>
    NEXT HCNT
    CRT 'More....' : ; INPUT More, 1
    R.HELP = ''
    R.HELP<-1> = '.HA - ALTER      : .I - Insert   .R - Replace   .DE/DM - Delete  .AP - Append'
    R.HELP<-1> = '                   .CAT{N} - Concatenate   .EV - Edit values   .ME - Merge'
    R.HELP<-1> = '                   .EXP - Expand the INCLUDE into item   .BL - Break line after'
    R.HELP<-1> = '                   .BLB - Break line before'
    R.HELP<-1> = '                   .CV{I}{O}{P} - OCONV or ICONV Line based on conversion.'
    R.HELP<-1> = '                                  P will pipe the line through the command'
    R.HELP<-1> = '                   .TRIM - Trim end of line spaces  .TRIML - Trim blank lines'
    R.HELP<-1> = '.HL - LIST/LOCATE: .L - List  .W - Window  .A - Look again  .Q - List (NOcase)'
    R.HELP<-1> = '                   .EC - Extended characters  .CV - Convert  .SUM - Summation'
    R.HELP<-1> = '.HM - MOVEMENT   : .G{nn} - Go to line   .GB - Go to BKB line  .T - Top   .B - Bottom'
    R.HELP<-1> = '                   .U{nn} or .-{nn} up   .+{nn} down'
    R.HELP<-1> = '                   .J - Jump to logical match FOR...NEXT, IF...THEN, GOSUB...label'
    R.HELP<-1> = '                   .NC - Jump to next CASE statement in BEGIN CASE...END CASE'
    R.HELP<-1> = '.HB - BLOCKS     : .BKB - Begin block   .BKD - Delete block   .BKE - End block'
    R.HELP<-1> = '                   .BKS - Save block    .MV - Move block      .MVS - Move saved'
    R.HELP<-1> = '.HP - PRESTORE   : .P - Execute / program prestore   .PD - Display prestores'
    R.HELP<-1> = '.HF - FILE       : .EX - Exit   .FI - File   .FS - Save  .FD - Delete'
    R.HELP<-1> = '.HO - OTHER      : .PTR - Printer toggle   .PC - Printer close   .OOPS - Undo'
    R.HELP<-1> = '                   .TCL - Shell to TCL   .PEEK - Peek an item  .TIME - Time'
    R.HELP<-1> = '                   .WHO - WHO   .? - Item info   .C - Show columns'
    R.HELP<-1> = '                   .N - Next BASIC error   .NA - List all BASIC errors   .NR BASIC messages raw'
    IF mv_type = 'JBASE' THEN
        R.HELP<-1> = '                   .FMT{Left,Ind} - Run BFORMAT on item (Cannot undo with OOPS)'
    END ELSE
        R.HELP<-1> = '                   .FMT - Run BFORMAT on item (Cannot undo with OOPS)'
    END
    R.HELP<-1> = '                   .S Toggle supress line number     .CM comment'
    R.HELP<-1> = '                   .!{command} - run "command" or just execute shell'
    IF mv_type = 'JBASE' THEN
        R.HELP<-1> = '                   .C2C - compare to CATALOGed code (JELF=1,source)'
        R.HELP<-1> = '                   .SYS nn - See current value of SYSTEM(nn)'
        R.HELP<-1> = '                   .SET - Set FRED editor parameters for MASTER or User'
        R.HELP<-1> = '                   .OCT mmm - Convert octal to decimal   .HEX mmm - Convert hex to decimal'
    END
    R.HELP<-1> = ''
    R.HELP<-1> = '   Prepend any command with a tilde (~) to supress output'
    R.HELP<-1> = '   Prepend any command with a question mark (?) to prompt at ?.  i.e. ?R/A/?'
    R.HELP<-1> = ''
    PRINT STR('=', 79)
    FOR HCNT = 1 TO DCOUNT(R.HELP, @AM)
        PRINT R.HELP<HCNT>
    NEXT HCNT
    RETURN
*
HELP.ALTER:
*
    R.HELP = 'ALTER COMMANDS:'
    R.HELP<-1> = '     .I{EX}{ newline} - Insert a new line'
    R.HELP<-1> = '          {EX} Allow blank lines until EX is entered'
    R.HELP<-1> = '          {newline} data to be inserted can be included in the command'
    R.HELP<-1> = '     .R  - Replace the current line'
    R.HELP<-1> = '     .DE{nn}{/EXP}{/From-To}  - Delete lines'
    R.HELP<-1> = '     .DM{nn}{/MATCH}{/From-To}  - Delete lines'
    R.HELP<-1> = '          {nn} will delete the next nn lines.  Default of 1, * = All lines'
    R.HELP<-1> = '          {/EXP} will delete only those lines containing EXP'
    R.HELP<-1> = '          {/MATCH} will only delete lines matching pattern line 1N0N'
    R.HELP<-1> = '          {/From-To} will only check for EXP in that zone'
    R.HELP<-1> = '     .R{U}{V}{nn}{EXP/REXP{/From-To}{/*}  - Replace EXP with REXP in nn lines'
    R.HELP<-1> = '          {U} or {/*} signifies all occurences on the line(s)'
    R.HELP<-1> = '          {V} - Limit search to variables matching EXP'
    R.HELP<-1> = '          {nn} will change the next nn lines.  Default of 1, * = All lines.'
    R.HELP<-1> = '          <ctrl>^ in REXP will truncate line at that point'
    R.HELP<-1> = '          {/From-To} will only check for EXP in that zone'
    R.HELP<-1> = '     .AP{nn}/EXP  - Append EXP to end of line'
    R.HELP<-1> = '          {nn} will change the next nn lines.  Default of 1, * = All lines.'
    R.HELP<-1> = '     .CAT     - Concatenate current line with next line with a space between'
    R.HELP<-1> = '     .CATN    - Concatenate the current line with the next line (no space)'
    R.HELP<-1> = '     .CX      - Clear the current line'
    R.HELP<-1> = '     .EV{nn}  - Edit the line multi-values as seperate lines'
    R.HELP<-1> = '              {nn} edit line nn.  Default of current line'
    R.HELP<-1> = '     .EXP     - Expand an include into the current program'
    R.HELP<-1> = '     .BL/EXP  - Break the line after EXP, then start new line'
    R.HELP<-1> = '     .BLB/EXP - Break the line before EXP, then start new line'
    R.HELP<-1> = '     .ME      - Merge lines from another item'
    R.HELP<-1> = '              Will prompt for file, ID, from and to lines'
    R.HELP<-1> = '     .ME{nnn}"item"{mmm} or ME{nnn}(filename item){mmm} - traditional MErge'
    R.HELP<-1> = '              nnn = number of lines, mmm = start line'
    R.HELP<-1> = '              item if quote, filename item if in parens'
    R.HELP<-1> = '              filename can be file or DICT file'
    R.HELP<-1> = '     .CV{I}{O}{P}{nn}/CONV  - (I)conv, (O)conv or (P)ipe line into linux cmd'
    R.HELP<-1> = '                              and replace with the converted/piped data'
    R.HELP<-1> = '          {nn} will change the next nn lines.  Default of 1, * = All lines.'
    R.HELP<-1> = '          {CONV} is conversion or command.  CV{I}{O}{P} alone will prompt'
    R.HELP<-1> = '     .TRIM    - Trims all trailing spaces on all lines'
    R.HELP<-1> = '     .TRIML   - Removes all lines left blank or all spaces'
    PRINT STR('=', 79)
    FOR HCNT = 1 TO DCOUNT(R.HELP, @AM)
        PRINT R.HELP<HCNT>
    NEXT HCNT
    RETURN
*
HELP.LIST:
*
    R.HELP = 'LIST/LOCATE COMMANDS:'
    R.HELP<-1> = '     .L{nn}  - List lines'
    R.HELP<-1> = '             {nn} will list the next nn lines.  Default of 1'
    R.HELP<-1> = '             "D" for {nn} lists DEPTH of terminal'
    R.HELP<-1> = '     .W{nn}  - List window of lines with current line being last line listed'
    R.HELP<-1> = '             {nn} will window the prior nn lines.  Default is terminal depth'
    R.HELP<-1> = '     .WW     - list window above current window.   Like LD in reverse.'
    R.HELP<-1> = '     .L{C}{V}{nn}/EXP{/B}{/From-To}  - List lines containing EXP.'
    R.HELP<-1> = '          {C} - Limit search to non-comment lines'
    R.HELP<-1> = '          {V} - Limit search to variables matching EXP'
    R.HELP<-1> = '          {nn} Will limit search to nn lines, * = All lines.  Default will locate next EXP'
    R.HELP<-1> = '          {/B} = Performs locate backwards'
    R.HELP<-1> = '          {/From-To} will only check for EXP in that zone'
    R.HELP<-1> = '          EXP containing && will search for anded clause like L/A&&B'
    R.HELP<-1> = '     .Q{C}{V}{nn}/EXP{/B}{/From-To}  - List lines containing EXP (ignore case)'
    R.HELP<-1> = '          {C} - Limit search to non-comment lines'
    R.HELP<-1> = '          {V} - Limit search to variables matching EXP'
    R.HELP<-1> = '          {nn} Will limit search to nn lines, * = All lines.  Default will locate next EXP'
    R.HELP<-1> = '          {/B} = Performs locate backwards'
    R.HELP<-1> = '          {/From-To} will only check for EXP in that zone'
    R.HELP<-1> = '          EXP containing && will search for anded clause like Q/A&&B'
    R.HELP<-1> = '     .A  - Execute the last "L"ocate command.  "PD" will show last locate'
    R.HELP<-1> = '     .EC{0}{1}{2}{3}{4}  - Extended character display level'
    R.HELP<-1> = '          {0} - display raw data including delimiters @VM and @SM'
    R.HELP<-1> = '          {1} - display raw data except for @VM as ] and @SM as \'
    R.HELP<-1> = '           Level 2 and higher will show trailing space as highlighted {nn}'
    R.HELP<-1> = '          {2} - same as 1, but display non-printables as "."'
    R.HELP<-1> = '          {3} - same as 1, but display non-printables as "~HEX~"'
    R.HELP<-1> = '          {4} - show all data as HEX string'
    R.HELP<-1> = '          default level is 1.  EC command alone will prompt for level'
    R.HELP<-1> = '     .CV {CONV}  - Show current line data with CONV applied'
    R.HELP<-1> = '          {CONV} is conversion.  CV command alone will prompt for conversion'
    R.HELP<-1> = '     .SUM  - Show the sum of the data on the current line'
    PRINT STR('=', 79)
    FOR HCNT = 1 TO DCOUNT(R.HELP, @AM)
        PRINT R.HELP<HCNT>
    NEXT HCNT
    RETURN
*
HELP.MOVEMENT:
*
    R.HELP = 'MOVEMENT COMMANDS:'
    R.HELP<-1> = '     .G{A}nn  - Go to line nn'
    R.HELP<-1> = '              {A} - Add lines to current item if needed'
