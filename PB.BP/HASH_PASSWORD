      SUBROUTINE HASH_PASSWORD(in_password,hash_return)
* Returns a hash for a plain text password
*
*** Import argon2 and builtins modules
*
      argon2Module = PyImport("argon2")
      IF @PYEXCEPTIONTYPE # '' THEN
         error_number = 1
         GOSUB HANDLEPYERR
      END
      builtinsModule = PyImport("builtins")
      IF @PYEXCEPTIONTYPE # '' THEN
         error_number = 2
         GOSUB HANDLEPYERR
      END
*
*** Define PasswordHasher class
*
      passwordHasherClass = PyGetAttr(argon2Module, "PasswordHasher")
      IF @PYEXCEPTIONTYPE # '' THEN
         error_number = 3
         GOSUB HANDLEPYERR
      END
*
*** Instantiate an instance of that class
*
      passwordHasher = PyCall(passwordHasherClass)
      IF @PYEXCEPTIONTYPE # '' THEN
         error_number = 4
         GOSUB HANDLEPYERR
      END
*
*** Return the result
*
      hashResult = PyCallMethod(passwordHasher, "hash", in_password)
      IF @PYEXCEPTIONTYPE # '' THEN
         error_number = 5
         GOSUB HANDLEPYERR
      END
      hash_from_python = hashResult
*
*** Convert python returned to a standard string
*
      hash_return = PyCallMethod(builtinsModule,"str",hash_from_python)
      IF @PYEXCEPTIONTYPE # '' THEN
         error_number = 6
         GOSUB HANDLEPYERR
      END
*
*** Return from subroutine
*
      RETURN
*
HANDLEPYERR:
*
      CRT STR('=',79)
      CRT 'SUBROUTINE HASH_PASSWORD'
      CRT 'Error number ':error_number
      CRT STR('-',79)
      CRT 'PYEXCEPTION TYPE "':@PYEXCEPTIONTYPE:'"'
      CRT 'PYEXCEPTION MESSAGE...'
      CRT @PYEXCEPTIONMSG
      CRT 'PEXCEPTION TRACE BACK...'
      CRT @PYEXCEPTIONTRACEBACK
      STOP
